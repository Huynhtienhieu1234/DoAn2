@using System.Web.Mvc
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ Thống Lao Động Sinh Viên</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <!-- Custom Layout CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Siderbarmain.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentHeaderNav.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentPages.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Toast.css?v=" + DateTime.Now.Ticks)">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.png?v=3")" />
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/favicon.ico?v=3")" />

    <!-- jQuery & Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/Viewsider/Viewsider.js?v=" + DateTime.Now.Ticks)"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/StudentHeaderNav.js?v=" + DateTime.Now.Ticks)"></script>
</head>

<body>
    <a class="student-skip-link" href="#studentMainContent">Bỏ qua điều hướng</a>

    <!-- TOAST THÔNG BÁO -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        @if (TempData["Message"] != null)
        {
            var type = (TempData["MessageType"]?.ToString() ?? "info").ToLower();
            var bgClass = type == "success" ? "bg-success" :
                         (type.Contains("error") || type.Contains("danger") ? "bg-danger" : "bg-primary");

            <div class="toast custom-toast text-white @bgClass border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex flex-column w-100">
                    <div class="toast-body fw-bold d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center">
                            @if (type == "success")
                            {
                                <i class="fas fa-check-circle me-2 fs-5"></i>
                            }
                            else if (type.Contains("error") || type.Contains("danger"))
                            {
                                <i class="fas fa-exclamation-triangle me-2 fs-5"></i>
                            }
                            else
                            {
                                <i class="fas fa-info-circle me-2 fs-5"></i>
                            }
                            @TempData["Message"]
                        </div>
                        <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="progress toast-progress" style="height: 4px;">
                        <div class="progress-bar bg-light" role="progressbar"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bong bóng chat hỗ trợ -->
    <button type="button" id="chatBubble" class="chat-bubble" aria-label="Mở trợ lý lao động" aria-controls="chatBox" aria-expanded="false" title="Trợ lý ảo hỗ trợ sinh viên">
        <i class="fas fa-robot" aria-hidden="true"></i>
        <span class="chat-badge-pulse" aria-hidden="true"></span>
    </button>

    <!-- Khung chat -->
    <div id="chatBox" class="chat-box" role="dialog" aria-label="Trợ lý lao động">
        <div class="chat-header">
            <div class="chat-header-main">
                <div class="chat-bot-avatar" aria-hidden="true">
                    <i class="fas fa-robot"></i>
                    <span class="chat-status-online"></span>
                </div>
                <div class="chat-header-text">
                    <strong>Trợ lý lao động</strong>
                    <span>Trực tuyến · Hỗ trợ 24/7</span>
                </div>
            </div>
            <div class="chat-header-actions">
                <button type="button" class="chat-icon-btn" id="resetChat" aria-label="Làm mới cuộc trò chuyện" title="Làm mới cuộc trò chuyện">
                    <i class="fas fa-redo-alt" aria-hidden="true"></i>
                </button>
                <button type="button" class="chat-icon-btn" id="closeChat" aria-label="Đóng khung chat" title="Đóng khung chat">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <!-- Khung tin nhắn -->
        <div class="chat-messages" id="chatMessages" aria-live="polite">
            <!-- Tin nhắn sẽ được render tự động qua JS -->
        </div>

        <!-- Thanh gợi ý câu hỏi nhanh -->
        <div class="chat-suggestions" id="chatSuggestionsBar">
            <div class="chat-suggestions-track">
                <button type="button" class="chat-chip" data-query="Tiến độ lao động của tôi">Tiến độ</button>
                <button type="button" class="chat-chip" data-query="Lịch lao động tôi đã đăng ký">Lịch trực</button>
                <button type="button" class="chat-chip" data-query="Quy định giờ giấc ca lao động">Giờ giấc</button>
                <button type="button" class="chat-chip" data-query="Hướng dẫn cách điểm danh">Điểm danh</button>
                <button type="button" class="chat-chip" data-query="Điều kiện nhận giấy xác nhận hoàn thành">Giấy xác nhận</button>
            </div>
        </div>

        <!-- Ô nhập câu hỏi -->
        <div class="chat-composer">
            <input type="text" id="chatInput" placeholder="Hỏi về tiến độ, lịch trực, quy định..." autocomplete="off">
            <button type="button" class="chat-send-btn" id="sendChat" aria-label="Gửi câu hỏi" title="Gửi câu hỏi">
                <i class="fas fa-paper-plane" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <!-- Top Navigation Header -->
    @Html.Partial("_StudentHeader")

    <!-- Main Content Area -->
    <main class="content-wrapper" id="studentMainContent">
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </main>
</body>
</html>