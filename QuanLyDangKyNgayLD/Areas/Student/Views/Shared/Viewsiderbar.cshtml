@using System.Web.Mvc
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ Thống Lao Động Sinh Viên</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <!-- Custom Layout CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Siderbarmain.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Toast.css?v=" + DateTime.Now.Ticks)">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/logoxoanen.png" />

    <!-- jQuery & Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/Viewsider/LayoutUser.js?v=" + DateTime.Now.Ticks)"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/Viewsider/Viewsider.js?v=" + DateTime.Now.Ticks)"></script>
</head>

<body>
    <!-- TOAST THÔNG BÁO -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
        @if (TempData["Message"] != null)
        {
            var type = (TempData["MessageType"]?.ToString() ?? "info").ToLower();
            var bgClass = type == "success" ? "bg-success" :
                         (type.Contains("error") || type.Contains("danger") ? "bg-danger" : "bg-primary");

            <div class="toast custom-toast text-white @bgClass border-0 shadow-lg rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex flex-column w-100">
                    <div class="toast-body fw-bold d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center">
                            @if (type == "success")
                            {
                                <i class="fas fa-check-circle me-2 fs-5"></i>
                            }
                            else if (type.Contains("error") || type.Contains("danger"))
                            {
                                <i class="fas fa-exclamation-triangle me-2 fs-5"></i>
                            }
                            else
                            {
                                <i class="fas fa-info-circle me-2 fs-5"></i>
                            }
                            @TempData["Message"]
                        </div>
                        <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="toast"></button>
                    </div>
                    <div class="progress toast-progress" style="height: 4px;">
                        <div class="progress-bar bg-light" role="progressbar"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Bong bóng chat hỗ trợ -->
    <div id="chatBubble" class="chat-bubble shadow-lg" title="Trợ lý ảo hỗ trợ sinh viên">
        <i class="fas fa-robot"></i>
        <span class="chat-badge-pulse"></span>
    </div>

    <!-- Khung chat -->
    <div id="chatBox" class="chat-box card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="chat-header text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="chat-bot-avatar">
                    <i class="fas fa-robot"></i>
                    <span class="chat-status-online"></span>
                </div>
                <div>
                    <div class="fw-bold fs-6 lh-1">Trợ Lý Lao Động AI</div>
                    <small class="text-white-50 fs-7">Sẵn sàng hỗ trợ 24/7</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-icon-header" id="resetChat" title="Làm mới cuộc trò chuyện">
                    <i class="fas fa-redo-alt"></i>
                </button>
                <button type="button" class="btn btn-sm btn-icon-header" id="closeChat" title="Đóng khung chat">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Khung tin nhắn -->
        <div class="card-body p-3" id="chatMessages" style="height: 330px; overflow-y: auto; background-color: #f8fafc;">
            <!-- Tin nhắn sẽ được render tự động qua JS -->
        </div>

        <!-- Thanh gợi ý câu hỏi nhanh -->
        <div class="chat-suggestions-bar px-2 py-1 bg-light border-top" id="chatSuggestionsBar">
            <div class="d-flex gap-1 overflow-x-auto py-1 custom-scrollbar">
                <button type="button" class="btn btn-sm chat-chip" data-query="Tiến độ lao động của tôi">
                    <i class="fas fa-chart-pie text-primary me-1"></i>Tiến độ
                </button>
                <button type="button" class="btn btn-sm chat-chip" data-query="Lịch lao động tôi đã đăng ký">
                    <i class="fas fa-calendar-alt text-success me-1"></i>Lịch trực
                </button>
                <button type="button" class="btn btn-sm chat-chip" data-query="Quy định ca trực và giờ giấc">
                    <i class="fas fa-clock text-warning me-1"></i>Giờ giấc
                </button>
                <button type="button" class="btn btn-sm chat-chip" data-query="Hướng dẫn cách điểm danh">
                    <i class="fas fa-qrcode text-info me-1"></i>Điểm danh
                </button>
                <button type="button" class="btn btn-sm chat-chip" data-query="Điều kiện nhận giấy xác nhận hoàn thành">
                    <i class="fas fa-certificate text-danger me-1"></i>Giấy xác nhận
                </button>
            </div>
        </div>

        <!-- Ô nhập câu hỏi -->
        <div class="card-footer bg-white border-top p-2">
            <div class="input-group">
                <input type="text" id="chatInput" class="form-control rounded-pill-start border-end-0 shadow-none ps-3" placeholder="Nhập câu hỏi (tiến độ, lịch, quy định...)" autocomplete="off">
                <button class="btn btn-primary rounded-pill-end px-3" id="sendChat" title="Gửi câu hỏi">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Top Navigation Header -->
    <nav class="student-navbar">
        <div class="nav-content">
            <div class="d-flex align-items-center gap-2">
                <!-- Mobile sidebar toggle button -->
                <button type="button" id="mobileSidebarToggle" class="btn btn-sm btn-light d-md-none rounded-circle border shadow-2xs me-1" title="Menu" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fas fa-bars text-dark"></i>
                </button>
                <!-- Brand Logo -->
                <a href="@Url.Action("Index", "MainSinhVien", new { area = "Student" })" class="d-flex align-items-center text-decoration-none">
                    <img src="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/sinhvien/LogoTruong.png" alt="Logo DThU" class="logo-brand">
                </a>
            </div>

            <!-- User Menu Dropdown -->
            <div class="user-menu-pill" id="userMenu">
                <div class="user-avatar-wrapper">
                    <img id="layoutAvatar"
                         src="https://ui-avatars.com/api/?name=SV&background=2563eb&color=fff&size=100&bold=true"
                         alt="Avatar"
                         class="user-avatar" />
                    <span class="user-status-dot"></span>
                </div>

                <span id="layoutUserName" class="user-name-text">
                    @(ViewBag.HoTen ?? "Sinh viên")
                </span>

                <i class="fas fa-chevron-down user-dropdown-arrow ms-1"></i>

                <ul class="user-dropdown-menu" id="dropdownMenu">
                    <li>
                        <a href="@Url.Action("Detail", "MainSinhVien", new { area = "Student" })">
                            <i class="fas fa-user-circle text-primary"></i>
                            <span>Thông tin cá nhân</span>
                        </a>
                    </li>
                    <li class="user-dropdown-divider"></li>
                    <li>
                        <a href="@Url.Action("Logout", "Login", new { area = "" })" class="text-danger">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Đăng xuất</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar Backdrop for Mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Sidebar Navigation -->
    <aside class="sidebar collapsed" id="sidebar">
        <!-- Sidebar Toggle Header -->
        <div class="sidebar-header-toggle">
            <span class="sidebar-title-badge">Menu Quản Lý</span>
            <button type="button" id="toggleSidebar" class="btn-sidebar-toggle" title="Thu gọn / Mở rộng">
                <i class="fas fa-bars" id="toggleIcon"></i>
            </button>
        </div>

        <!-- Sidebar Menu Items -->
        <ul class="sidebar-menu-list">
            <!-- 1. Trang chủ -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Index", "MainSinhVien", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "MainSinhVien" && currentAction == "Index" ? "active" : "")" 
                   data-tooltip="Trang chủ">
                    <i class="fas fa-home nav-icon"></i>
                    <span class="menu-text">Trang chủ</span>
                </a>
            </li>

            <!-- 2. Đăng ký lao động -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Index", "StudentRegisterWord", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "StudentRegisterWord" ? "active" : "")" 
                   data-tooltip="Đăng Ký Lao Động">
                    <i class="fas fa-clipboard-list nav-icon"></i>
                    <span class="menu-text">Đăng Ký Lao Động</span>
                </a>
            </li>

            <!-- 3. Thống kê -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Index", "StudentTK", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "StudentTK" ? "active" : "")" 
                   data-tooltip="Thống Kê Ngày Công">
                    <i class="fas fa-chart-line nav-icon"></i>
                    <span class="menu-text">Thống Kê Ngày Công</span>
                </a>
            </li>

            <!-- 4. Lịch lao động -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Index", "StudentListDay", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "StudentListDay" ? "active" : "")" 
                   data-tooltip="Lịch Lao Động">
                    <i class="fas fa-calendar-alt nav-icon"></i>
                    <span class="menu-text">Lịch Lao Động</span>
                </a>
            </li>

            <!-- 5. Điểm danh lao động -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Index", "StudentCheckDay", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "StudentCheckDay" ? "active" : "")" 
                   data-tooltip="Điểm Danh Lao Động">
                    <i class="fas fa-clipboard-check nav-icon"></i>
                    <span class="menu-text">Điểm Danh Lao Động</span>
                </a>
            </li>

            <!-- 6. Hồ sơ cá nhân -->
            <li class="sidebar-menu-item">
                <a href="@Url.Action("Detail", "MainSinhVien", new { area = "Student" })" 
                   class="sidebar-nav-link @(currentController == "MainSinhVien" && currentAction == "Detail" ? "active" : "")" 
                   data-tooltip="Hồ Sơ Cá Nhân">
                    <i class="fas fa-id-card nav-icon"></i>
                    <span class="menu-text">Hồ Sơ Cá Nhân</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- Main Content Area -->
    <main class="content-wrapper">
        <div class="container-fluid p-0">
            @RenderBody()
        </div>
    </main>

    <script>
        // Toggle Sidebar Action
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.getElementById("sidebar");
            const toggleBtn = document.getElementById("toggleSidebar");
            const mobileToggleBtn = document.getElementById("mobileSidebarToggle");
            const sidebarBackdrop = document.getElementById("sidebarBackdrop");

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle("collapsed");
                });
            }

            if (mobileToggleBtn && sidebar) {
                mobileToggleBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    sidebar.classList.toggle("mobile-open");
                    if (sidebarBackdrop) {
                        sidebarBackdrop.classList.toggle("show", sidebar.classList.contains("mobile-open"));
                    }
                });
            }

            if (sidebarBackdrop && sidebar) {
                sidebarBackdrop.addEventListener("click", function () {
                    sidebar.classList.remove("mobile-open");
                    sidebarBackdrop.classList.remove("show");
                });
            }
        });
    </script>
</body>
</html>