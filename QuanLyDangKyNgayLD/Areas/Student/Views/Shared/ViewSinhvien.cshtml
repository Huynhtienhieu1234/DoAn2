<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Cổng Sinh Viên</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- CSS riêng -->
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Dashboard.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentHeaderNav.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentPages.css?v=" + DateTime.Now.Ticks)">
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.png?v=3")" />
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/favicon.ico?v=3")" />
</head>

<body>
    <a class="student-skip-link" href="#studentMainContent">Bỏ qua điều hướng</a>

    @Html.Partial("_StudentHeader")

    <!-- Main Content Area -->
    <main class="student-main-content py-4" id="studentMainContent">
        @RenderBody()
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/StudentHeaderNav.js?v=" + DateTime.Now.Ticks)"></script>
</body>
</html>
