<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Cổng Sinh Viên</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        body, button, input, optgroup, select, textarea {
            font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }
        :root {
            --bs-body-font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif !important;
            --bs-font-sans-serif: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif !important;
        }
        .fa, .fas, .far, .fal, .fab, .fad, .fak, [class*="fa-"], [class^="fa-"] {
            font-family: "Font Awesome 6 Free" !important;
        }
        .fab, .fa-brands {
            font-family: "Font Awesome 6 Brands" !important;
        }
        /* Chống giật trang khi mở modal */
        html {
            scrollbar-gutter: stable;
        }
        body.modal-open,
        body.swal2-shown {
            padding-right: 0 !important;
        }
        .modal {
            padding-right: 0 !important;
        }
    </style>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- CSS riêng -->
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Dashboard.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentHeaderNav.css?v=" + DateTime.Now.Ticks)">
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/StudentPages.css?v=" + DateTime.Now.Ticks)">
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.png?v=3")" />
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/favicon.ico?v=3")" />
</head>

<body>
    <a class="student-skip-link" href="#studentMainContent">Bỏ qua điều hướng</a>

    @Html.Partial("_StudentHeader")

    <!-- Main Content Area -->
    <main class="student-main-content py-4" id="studentMainContent">
        @RenderBody()
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="@Url.Content("~/Areas/Student/Content/Js/StudentHeaderNav.js?v=" + DateTime.Now.Ticks)"></script>
</body>
</html>
