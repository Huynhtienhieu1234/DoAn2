<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Cổng Sinh Viên</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <!-- CSS riêng -->
    <link rel="stylesheet" href="@Url.Content("~/Areas/Student/Content/Css/Dashboard.css?v=" + DateTime.Now.Ticks)">
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/logoxoanen.png" />
</head>

<body>
    <!-- Modern Header -->
    <header class="student-header sticky-top">
        <div class="container-xl d-flex align-items-center justify-content-between py-2">
            <!-- Brand / Logo -->
            <a href="@Url.Action("Index", "MainSinhVien", new { area = "Student" })" class="d-flex align-items-center text-decoration-none brand-link">
                <img src="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/sinhvien/LogoTruong.png" alt="Logo DThU" class="header-logo me-2">
            </a>

            <!-- Right Actions -->
            <div class="d-flex align-items-center gap-3">
                <!-- User greeting pill -->
                <div class="user-greeting-pill d-none d-sm-flex align-items-center gap-2 py-1 px-3 rounded-pill bg-white shadow-sm border">
                    <span class="status-indicator online"></span>
                    <span class="fw-semibold text-dark small" id="navStudentName">Sinh viên</span>
                </div>

                <!-- Nút Đăng xuất -->
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 d-flex align-items-center gap-2 shadow-sm header-logout-btn" id="logoutIcon">
                    <i class="fas fa-sign-out-alt"></i>
                    <span class="d-none d-md-inline fw-medium">Đăng xuất</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="student-main-content py-4">
        @RenderBody()
    </main>

    <!-- Toast container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer" style="z-index: 1090;"></div>

    <!-- Modal xác nhận thoát -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white border-0 py-3">
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2" id="logoutModalLabel">
                        <i class="fas fa-sign-out-alt"></i> Xác nhận đăng xuất
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4">
                    <div class="text-danger mb-3">
                        <i class="fas fa-power-off fa-3x"></i>
                    </div>
                    <p class="mb-0 fw-medium text-secondary">Bạn có chắc chắn muốn rời khỏi phiên làm việc hiện tại không?</p>
                </div>
                <div class="modal-footer border-0 justify-content-center bg-light py-2">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <a href="@Url.Action("Logout", "Login", new { area = "" })" class="btn btn-danger rounded-pill px-4 shadow-sm">Đồng ý</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Mở modal khi click icon thoát
        document.getElementById("logoutIcon")?.addEventListener("click", function () {
            var modal = new bootstrap.Modal(document.getElementById("logoutModal"));
            modal.show();
        });

        // Hàm show toast
        function showToast(message, type = "info") {
            const toastContainer = document.getElementById("toastContainer");
            if (!toastContainer) return;
            const toastEl = document.createElement("div");
            toastEl.className = `toast align-items-center text-bg-${type} border-0 rounded-3 shadow`;
            toastEl.role = "alert";
            toastEl.ariaLive = "assertive";
            toastEl.ariaAtomic = "true";
            toastEl.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body fw-medium">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            toastContainer.appendChild(toastEl);
            const bsToast = new bootstrap.Toast(toastEl, { delay: 3500 });
            bsToast.show();
            toastEl.addEventListener('hidden.bs.toast', () => toastEl.remove());
        }
    </script>
</body>
</html>
