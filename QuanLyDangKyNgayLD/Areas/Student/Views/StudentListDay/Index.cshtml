@{
    ViewBag.Title = "Lịch Lao Động";
    Layout = "~/Areas/Student/Views/Shared/Viewsiderbar.cshtml";
}

<div class="student-page">
    <div class="student-page-head">
        <div class="student-page-head-icon">
            <i class="fas fa-calendar-alt"></i>
        </div>
        <div class="student-page-head-main">
            <nav class="student-breadcrumb" aria-label="Điều hướng">
                <a href="@Url.Action("Index", "MainSinhVien", new { area = "Student" })">Trang chủ</a>
                <i class="fas fa-chevron-right"></i>
                <span aria-current="page">Lịch lao động</span>
            </nav>
            <h1 class="student-page-title">Lịch lao động</h1>
            <p class="student-page-subtitle">Xem các đợt lao động bạn đã đăng ký theo từng tuần.</p>
        </div>
    </div>

    <div class="student-card">
        <div class="student-card-header">
            <h2 class="student-card-title">
                <span class="student-card-icon blue"><i class="fas fa-calendar-week"></i></span>
                Lịch lao động trong tuần
            </h2>
            <div class="student-week-nav">
                <button type="button" class="btn btn-outline-primary" onclick="changeWeek(-1)" aria-label="Xem tuần trước">
                    <i class="fas fa-chevron-left"></i> Tuần trước
                </button>
                <span id="weekRangeText" class="student-week-range">Tuần hiện tại</span>
                <button type="button" class="btn btn-outline-primary" onclick="changeWeek(1)" aria-label="Xem tuần sau">
                    Tuần sau <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
        <div class="student-card-body p-0">
            <div class="table-responsive">
                <table class="student-schedule-table text-center">
                    <thead>
                        <tr>
                            <th>Buổi / Ngày</th>
                            <th>Thứ 2<span id="ngay2"></span></th>
                            <th>Thứ 3<span id="ngay3"></span></th>
                            <th>Thứ 4<span id="ngay4"></span></th>
                            <th>Thứ 5<span id="ngay5"></span></th>
                            <th>Thứ 6<span id="ngay6"></span></th>
                            <th>Thứ 7<span id="ngay7"></span></th>
                            <th>Chủ nhật<span id="ngayCN"></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>Sáng</th>
                            <td id="sang2" class="student-schedule-cell"></td>
                            <td id="sang3" class="student-schedule-cell"></td>
                            <td id="sang4" class="student-schedule-cell"></td>
                            <td id="sang5" class="student-schedule-cell"></td>
                            <td id="sang6" class="student-schedule-cell"></td>
                            <td id="sang7" class="student-schedule-cell"></td>
                            <td id="sangCN" class="student-schedule-cell"></td>
                        </tr>
                        <tr>
                            <th>Chiều</th>
                            <td id="chieu2" class="student-schedule-cell"></td>
                            <td id="chieu3" class="student-schedule-cell"></td>
                            <td id="chieu4" class="student-schedule-cell"></td>
                            <td id="chieu5" class="student-schedule-cell"></td>
                            <td id="chieu6" class="student-schedule-cell"></td>
                            <td id="chieu7" class="student-schedule-cell"></td>
                            <td id="chieuCN" class="student-schedule-cell"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal chi tiết -->
<div class="modal fade student-modal" id="modalChiTiet" tabindex="-1" aria-labelledby="modalChiTietLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalChiTietLabel">
                    <i class="fas fa-circle-info"></i> Chi tiết đợt lao động
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4 align-items-start">
                    <div class="col-md-6">
                        <div class="student-detail-list">
                            <div class="student-detail-item">
                                <span class="student-detail-label">Ngày</span>
                                <span id="ctNgay" class="student-detail-value"></span>
                            </div>
                            <div class="student-detail-item">
                                <span class="student-detail-label">Buổi</span>
                                <span id="ctBuoi" class="student-detail-value"></span>
                            </div>
                            <div class="student-detail-item">
                                <span class="student-detail-label">Loại lao động</span>
                                <span id="ctLoai" class="student-detail-value"></span>
                            </div>
                            <div class="student-detail-item">
                                <span class="student-detail-label">Địa điểm</span>
                                <span id="ctDiaDiem" class="student-detail-value"></span>
                            </div>
                            <div class="student-detail-item">
                                <span class="student-detail-label">Trạng thái</span>
                                <span id="ctTrangThai" class="student-detail-value"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <img id="ctHinh" src="" alt="Hình địa điểm" class="student-detail-image" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="student-btn student-btn-outline" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Areas/Student/Content/Js/StudentListDay/StudentListDay.js?v=" + DateTime.Now.Ticks)"></script>
