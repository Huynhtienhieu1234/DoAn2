@model QuanLyDangKyNgayLD.Models.SinhVien
@{
    ViewBag.Title = "Cổng Sinh Viên - Trang chủ";
    Layout = "~/Areas/Student/Views/Shared/ViewSinhvien.cshtml";
}

<div class="student-page student-dashboard">
    <header class="student-dashboard-head">
        <div>
            <span class="student-dashboard-eyebrow">Cổng sinh viên</span>
            <h1 class="student-dashboard-title">
                Xin chào, <span id="heroStudentName">@(ViewBag.HoTen ?? "bạn")</span>
            </h1>
            <p class="student-dashboard-subtitle">Theo dõi tiến độ lao động và truy cập nhanh các chức năng cần thiết.</p>
        </div>
        <div class="student-dashboard-date">
            <i class="far fa-calendar"></i>
            <span id="currentDateText">Hôm nay</span>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-lg-4 col-md-5">
            <div class="student-profile-card h-100">
                <div class="profile-card-header text-center">
                    <div class="avatar-wrapper mx-auto position-relative">
                        <img id="avatarImg"
                             src="@(ViewBag.AvatarUrl ?? "https://ui-avatars.com/api/?name=" + Url.Encode(ViewBag.HoTen ?? "SV") + "&background=2563eb&color=fff&size=150&bold=true")"
                             onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Url.Encode(ViewBag.HoTen ?? "SV")&background=2563eb&color=fff&size=150&bold=true';"
                             class="profile-avatar"
                             alt="Avatar sinh viên" />
                        <span class="avatar-status-badge" title="Đang hoạt động"></span>
                    </div>

                    <h5 id="hoten">@(ViewBag.HoTen ?? "Đang tải...")</h5>

                    <div class="student-profile-badges">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill" id="lopBadge">
                            <i class="fas fa-users"></i> <span id="lopText">Lớp: ...</span>
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill" id="vaitroBadge">
                            <i class="fas fa-user-tag"></i> <span id="vaitro">Sinh viên</span>
                        </span>
                    </div>
                </div>

                <div class="card-body px-4 py-3">
                    <div class="labor-progress-box">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <h4 id="soNgayCompleted">0 <span>/ 18 ngày</span></h4>
                            <span class="fw-bold text-success small" id="phanTramProgress">0%</span>
                        </div>
                        <div class="progress progress-modern mb-2">
                            <div class="progress-bar bg-gradient-primary"
                                 id="laborProgressBar"
                                 role="progressbar"
                                 style="width: 0%;"
                                 aria-valuenow="0"
                                 aria-valuemin="0"
                                 aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted d-block">
                            <i class="fas fa-info-circle me-1 text-primary"></i> Cần tích lũy đủ 18 buổi công để được xét hoàn thành.
                        </small>
                    </div>

                    <h6 class="text-uppercase fw-bold text-muted mb-2 student-stat-label">Thông tin chi tiết</h6>
                    <ul class="list-unstyled info-list">
                        <li>
                            <span class="text-muted small"><i class="fas fa-id-badge text-primary me-2 width-icon"></i>MSSV:</span>
                            <span class="fw-bold text-dark font-monospace d-flex align-items-center gap-1">
                                <span id="mssv">...</span>
                                <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1" onclick="copyMSSV()" title="Sao chép MSSV">
                                    <i class="far fa-copy"></i>
                                </button>
                            </span>
                        </li>
                        <li>
                            <span class="text-muted small"><i class="fas fa-university text-primary me-2 width-icon"></i>Khoa:</span>
                            <span class="fw-semibold text-dark text-end small" id="khoaText">...</span>
                        </li>
                        <li>
                            <span class="text-muted small"><i class="fas fa-envelope text-primary me-2 width-icon"></i>Email:</span>
                            <span class="fw-medium text-dark text-end small text-truncate" style="max-width: 170px;" id="email" title="...">...</span>
                        </li>
                        <li>
                            <span class="text-muted small"><i class="fas fa-phone-alt text-primary me-2 width-icon"></i>Số ĐT:</span>
                            <span class="fw-medium text-dark" id="soDienThoai">...</span>
                        </li>
                        <li>
                            <span class="text-muted small"><i class="fas fa-venus-mars text-primary me-2 width-icon"></i>Giới tính:</span>
                            <span class="fw-medium text-dark" id="gioiTinh">...</span>
                        </li>
                    </ul>

                    <a href="@Url.Action("Detail", "MainSinhVien", new { area = "Student" })"
                       class="btn student-btn student-btn-outline edit-profile-btn w-100">
                        <i class="fas fa-user-edit"></i> Xem &amp; cập nhật hồ sơ
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-7">
            <div class="student-feature-section-title">
                <div>
                    <h2>Chức năng chính</h2>
                    <p>Các thao tác thường dùng trong học kỳ.</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentRegisterWord", new { area = "Student" })" class="feature-bento-card card-blue d-block text-decoration-none">
                        <div class="card-icon-bubble bg-blue-grad">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="card-title">Đăng ký lao động</h5>
                            <p class="card-desc">Khám phá và đăng ký tham gia các đợt lao động mới được mở.</p>
                            <span class="card-action-link">
                                Đăng ký ngay <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentTK", new { area = "Student" })" class="feature-bento-card card-green d-block text-decoration-none">
                        <div class="card-icon-bubble bg-green-grad">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="card-title">Thống kê ngày công</h5>
                            <p class="card-desc">Tra cứu số ngày lao động đã tích lũy và tiến độ hoàn thành.</p>
                            <span class="card-action-link">
                                Xem báo cáo <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentListDay", new { area = "Student" })" class="feature-bento-card card-amber d-block text-decoration-none">
                        <div class="card-icon-bubble bg-amber-grad">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="card-title">Lịch lao động</h5>
                            <p class="card-desc">Xem lịch phân công lao động chi tiết theo từng đợt và buổi.</p>
                            <span class="card-action-link">
                                Tra cứu lịch <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentCheckDay", new { area = "Student" })" class="feature-bento-card card-purple d-block text-decoration-none">
                        <div class="card-icon-bubble bg-purple-grad">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="card-title">Điểm danh lao động</h5>
                            <p class="card-desc">Xem kết quả điểm danh và kiểm tra xác nhận có mặt các buổi công.</p>
                            <span class="card-action-link">
                                Kiểm tra điểm danh <i class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                </div>

                @if (ViewBag.IsClassLeader == true)
                {
                    <div class="col-12">
                        <div class="class-leader-panel">
                            <div class="d-flex align-items-start gap-3">
                                <div class="class-leader-icon">
                                    <i class="fas fa-user-shield"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <span class="class-leader-tag"><i class="fas fa-star me-1"></i>Quyền lớp trưởng</span>
                                    <h5 class="mt-2">Đăng ký lao động theo lớp</h5>
                                    <p>Chọn đợt lao động phù hợp và đăng ký cho toàn bộ sinh viên trong lớp của bạn.</p>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a href="@Url.Action("Index", "StudentRegisterWord", new { area = "Student", tab = "lop" })"
                                           class="btn btn-light fw-bold text-primary">
                                            <i class="fas fa-users me-2"></i>Đăng ký theo lớp
                                        </a>
                                        <a href="@Url.Action("Index", "StudentRegisterWord", new { area = "Student" })"
                                           class="btn btn-outline-light">
                                            <i class="fas fa-user me-2"></i>Đăng ký cá nhân
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Areas/Student/Content/Js/StudentMain/StudentMain.js?v=" + DateTime.Now.Ticks)"></script>
