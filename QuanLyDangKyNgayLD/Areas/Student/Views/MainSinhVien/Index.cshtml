@model QuanLyDangKyNgayLD.Models.SinhVien
@{
    ViewBag.Title = "Cổng Sinh Viên - Trang chủ";
    Layout = "~/Areas/Student/Views/Shared/ViewSinhvien.cshtml";
}

<div class="container-xl student-dashboard pt-2">
    <div class="row g-4">
        <!-- Cột trái: Thông tin sinh viên & Tiến độ -->
        <div class="col-lg-4 col-md-5">
            <div class="card student-profile-card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
                <div class="profile-card-header text-center pt-4 pb-2 px-3">
                    <div class="avatar-wrapper mx-auto mb-3 position-relative">
                        <img id="avatarImg" 
                             src="@(ViewBag.AvatarUrl ?? "https://ui-avatars.com/api/?name=" + Url.Encode(ViewBag.HoTen ?? "SV") + "&background=2563eb&color=fff&size=150&bold=true")"
                             onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Url.Encode(ViewBag.HoTen ?? "SV")&background=2563eb&color=fff&size=150&bold=true';"
                             class="rounded-circle profile-avatar shadow"
                             alt="Avatar Sinh Viên" />
                        <span class="avatar-status-badge" title="Đang hoạt động"></span>
                    </div>

                    <h5 class="fw-bold text-dark mb-1" id="hoten">@(ViewBag.HoTen ?? "Đang tải...")</h5>
                    
                    <div class="d-flex flex-wrap justify-content-center gap-1 mb-3">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1" id="lopBadge">
                            <i class="fas fa-users me-1"></i> <span id="lopText">Lớp: ...</span>
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1" id="vaitroBadge">
                            <i class="fas fa-user-tag me-1"></i> <span id="vaitro">Sinh viên</span>
                        </span>
                    </div>
                </div>

                <div class="card-body px-4 py-3">
                    <!-- Khung Tiến Độ Lao Động -->
                    <div class="labor-progress-box p-3 rounded-4 mb-4 border shadow-2xs">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <h4 class="fw-bold text-primary mb-0" id="soNgayCompleted">0 <span class="fs-6 text-muted fw-normal">/ 18 ngày</span></h4>
                            <span class="fw-bold text-success small" id="phanTramProgress">0%</span>
                        </div>
                        <div class="progress progress-modern mb-2" style="height: 10px; border-radius: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-gradient-primary" 
                                 id="laborProgressBar" 
                                 role="progressbar" 
                                 style="width: 0%;" 
                                 aria-valuenow="0" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted d-block" style="font-size: 0.78rem;">
                            <i class="fas fa-info-circle me-1 text-primary"></i> Cần tích lũy đủ 18 buổi công để được xét hoàn thành.
                        </small>
                    </div>

                    <!-- Danh sách thông tin cá nhân -->
                    <h6 class="text-uppercase fw-bold text-muted mb-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        Thông tin chi tiết
                    </h6>
                    <ul class="list-unstyled info-list mb-4">
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                            <span class="text-muted small"><i class="fas fa-id-badge text-primary me-2 width-icon"></i>MSSV:</span>
                            <span class="fw-bold text-dark font-monospace d-flex align-items-center gap-1">
                                <span id="mssv">...</span>
                                <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-1" onclick="copyMSSV()" title="Sao chép MSSV">
                                    <i class="far fa-copy"></i>
                                </button>
                            </span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                            <span class="text-muted small"><i class="fas fa-university text-primary me-2 width-icon"></i>Khoa:</span>
                            <span class="fw-semibold text-dark text-end small" id="khoaText">...</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                            <span class="text-muted small"><i class="fas fa-envelope text-primary me-2 width-icon"></i>Email:</span>
                            <span class="fw-medium text-dark text-end small text-truncate" style="max-width: 170px;" id="email" title="...">...</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                            <span class="text-muted small"><i class="fas fa-phone-alt text-primary me-2 width-icon"></i>Số ĐT:</span>
                            <span class="fw-medium text-dark" id="soDienThoai">...</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted small"><i class="fas fa-venus-mars text-primary me-2 width-icon"></i>Giới tính:</span>
                            <span class="fw-medium text-dark" id="gioiTinh">...</span>
                        </li>
                    </ul>

                    <a href="@Url.Action("Detail", "MainSinhVien", new { area = "Student" })" 
                       class="btn btn-outline-primary w-100 rounded-pill py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm edit-profile-btn">
                        <i class="fas fa-user-edit"></i> Xem & Cập nhật hồ sơ
                    </a>
                </div>
            </div>
        </div>

        <!-- Cột phải: Các thẻ chức năng (Bento Grid) -->
        <div class="col-lg-8 col-md-7">
            <div class="row g-3">
                <!-- 1. Đăng Ký Lao Động -->
                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentRegisterWord", new { area = "Student" })" class="feature-bento-card card-blue d-block text-decoration-none">
                        <div class="card-icon-bubble bg-blue-grad">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Đăng Ký Lao Động</h5>
                            <p class="card-desc">Khám phá và đăng ký tham gia các đợt lao động mới được mở.</p>
                            <span class="card-action-link">
                                Đăng ký ngay <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <!-- 2. Thống Kê Tiến Độ -->
                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentTK", new { area = "Student" })" class="feature-bento-card card-green d-block text-decoration-none">
                        <div class="card-icon-bubble bg-green-grad">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Thống Kê Ngày Công</h5>
                            <p class="card-desc">Tra cứu số ngày lao động đã tích lũy và tiến độ hoàn thành.</p>
                            <span class="card-action-link">
                                Xem báo cáo <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <!-- 3. Lịch Lao Động -->
                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentListDay", new { area = "Student" })" class="feature-bento-card card-amber d-block text-decoration-none">
                        <div class="card-icon-bubble bg-amber-grad">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Lịch Lao Động</h5>
                            <p class="card-desc">Xem lịch phân công lao động chi tiết theo từng đợt và buổi.</p>
                            <span class="card-action-link">
                                Tra cứu lịch <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <!-- 4. Điểm Danh Lao Động -->
                <div class="col-sm-6">
                    <a href="@Url.Action("Index", "StudentCheckDay", new { area = "Student" })" class="feature-bento-card card-purple d-block text-decoration-none">
                        <div class="card-icon-bubble bg-purple-grad">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Điểm Danh Lao Động</h5>
                            <p class="card-desc">Xem kết quả điểm danh, kiểm tra xác nhận có mặt các buổi công.</p>
                            <span class="card-action-link">
                                Kiểm tra điểm danh <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <!-- 5. Thông Báo Hệ Thống -->
                <div class="col-sm-6">
                    <a href="javascript:void(0);" 
                       class="feature-bento-card card-rose d-block text-decoration-none"
                       data-bs-toggle="modal" 
                       data-bs-target="#modalThongBao">
                        <div class="card-icon-bubble bg-rose-grad">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Thông Báo Lao Động</h5>
                            <p class="card-desc">Cập nhật các thông báo quan trọng từ Ban Quản lý lao động.</p>
                            <span class="card-action-link">
                                Xem thông báo <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>

                <!-- 6. Hồ Sơ Sinh Viên -->
                <div class="col-sm-6">
                    <a href="@Url.Action("Detail", "MainSinhVien", new { area = "Student" })" class="feature-bento-card card-cyan d-block text-decoration-none">
                        <div class="card-icon-bubble bg-cyan-grad">
                            <i class="fas fa-id-card"></i>
                        </div>
                        <div class="card-content">
                            <h5 class="fw-bold card-title">Hồ Sơ Cá Nhân</h5>
                            <p class="card-desc">Xem và chỉnh sửa ảnh đại diện, số điện thoại, email liên lạc.</p>
                            <span class="card-action-link">
                                Chỉnh sửa hồ sơ <i class="fas fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thông Báo Hiện Đại -->
<div class="modal fade" id="modalThongBao" tabindex="-1" aria-labelledby="modalThongBaoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-primary text-white py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-white text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fas fa-bell"></i>
                    </div>
                    <h5 class="modal-title fw-bold mb-0" id="modalThongBaoLabel">Thông Báo Lao Động</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th>Tiêu đề</th>
                                    <th>Nội dung</th>
                                    <th class="text-center" style="width: 140px;">Thời gian</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fas fa-inbox fa-3x opacity-25 mb-2 d-block"></i>
                                        <span class="fw-medium">Hiện tại chưa có thông báo mới</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white border-top py-2 px-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* =========================================================
       DASHBOARD STYLES - GUARANTEED INLINE STYLING
       ========================================================= */
    :root {
        --primary: #2563eb;
        --primary-hover: #1d4ed8;
        --primary-light: #eff6ff;
        --secondary: #64748b;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --info: #06b6d4;
        --dark: #0f172a;
        --light-bg: #f8fafc;
        --card-bg: #ffffff;
        --border-color: #e2e8f0;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 20px;
        --radius-full: 9999px;
        --shadow-subtle: 0 1px 3px 0 rgba(0, 0, 0, 0.05), 0 1px 2px -1px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04);
        --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: #f1f5f9 !important;
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    /* Welcome Hero Banner */
    .welcome-hero-banner {
        background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #60a5fa 100%) !important;
        border-radius: 20px !important;
        padding: 28px 32px !important;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.3) !important;
    }

    .welcome-hero-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    /* Profile Card */
    .student-profile-card {
        background: #ffffff !important;
        border-radius: 20px !important;
        transition: var(--transition);
        border: 1px solid #e2e8f0 !important;
    }

    .profile-card-header {
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%) !important;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .avatar-wrapper {
        width: 110px;
        height: 110px;
        position: relative;
        margin: 0 auto;
    }

    .profile-avatar {
        width: 110px !important;
        height: 110px !important;
        object-fit: cover;
        border: 4px solid #ffffff !important;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12) !important;
        display: block;
    }

    .avatar-status-badge {
        position: absolute;
        bottom: 4px;
        right: 6px;
        width: 16px;
        height: 16px;
        background-color: #10b981;
        border: 2px solid #ffffff;
        border-radius: 50%;
    }

    .labor-progress-box {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%) !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 16px !important;
    }

    .progress-modern {
        background-color: #e2e8f0 !important;
        overflow: hidden;
    }

    .bg-gradient-primary {
        background: linear-gradient(90deg, #3b82f6 0%, #10b981 100%) !important;
    }

    .width-icon {
        width: 18px;
        text-align: center;
    }

    .edit-profile-btn {
        font-size: 0.88rem;
        transition: var(--transition);
    }

    .edit-profile-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

    /* Bento Grid Feature Cards */
    .feature-bento-card {
        background: #ffffff !important;
        border-radius: 20px !important;
        padding: 24px 22px !important;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04) !important;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
        position: relative;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .feature-bento-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .feature-bento-card:hover {
        transform: translateY(-6px) !important;
        box-shadow: 0 16px 30px -6px rgba(0, 0, 0, 0.1) !important;
        border-color: rgba(37, 99, 235, 0.3) !important;
    }

    .feature-bento-card:hover::after {
        opacity: 1;
    }

    /* Card Icon Bubbles */
    .card-icon-bubble {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #ffffff;
        margin-bottom: 16px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .feature-bento-card:hover .card-icon-bubble {
        transform: scale(1.12) rotate(5deg);
    }

    /* Gradients */
    .bg-blue-grad   { background: linear-gradient(135deg, #2563eb, #60a5fa) !important; }
    .bg-green-grad  { background: linear-gradient(135deg, #059669, #34d399) !important; }
    .bg-amber-grad  { background: linear-gradient(135deg, #d97706, #fbbf24) !important; }
    .bg-purple-grad { background: linear-gradient(135deg, #7c3aed, #a78bfa) !important; }
    .bg-rose-grad   { background: linear-gradient(135deg, #e11d48, #fb7185) !important; }
    .bg-cyan-grad   { background: linear-gradient(135deg, #0284c7, #38bdf8) !important; }

    .card-blue::after   { background: linear-gradient(90deg, #2563eb, #60a5fa); }
    .card-green::after  { background: linear-gradient(90deg, #059669, #34d399); }
    .card-amber::after  { background: linear-gradient(90deg, #d97706, #fbbf24); }
    .card-purple::after { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
    .card-rose::after   { background: linear-gradient(90deg, #e11d48, #fb7185); }
    .card-cyan::after   { background: linear-gradient(90deg, #0284c7, #38bdf8); }

    .card-title {
        color: #0f172a !important;
        font-size: 1.1rem;
        margin-bottom: 6px;
        transition: color 0.2s ease;
    }

    .feature-bento-card:hover .card-title {
        color: #2563eb !important;
    }

    .card-desc {
        color: #64748b !important;
        font-size: 0.84rem;
        line-height: 1.45;
        margin-bottom: 14px;
    }

    .card-action-link {
        font-size: 0.82rem;
        font-weight: 600;
        color: #2563eb !important;
        display: inline-flex;
        align-items: center;
        transition: transform 0.2s ease;
    }

    .feature-bento-card:hover .card-action-link {
        transform: translateX(4px);
    }
</style>

<script src="@Url.Content("~/Areas/Student/Content/Js/StudentMain/StudentMain.js?v=" + DateTime.Now.Ticks)"></script>