@model IEnumerable<QuanLyDangKyNgayLD.Models.TaoDotNgayLaoDong>
@{
    ViewBag.Title = "Đăng ký đợt lao động";
    Layout = "~/Areas/Student/Views/Shared/Viewsiderbar.cshtml";
}

<link href="@Url.Content("~/Areas/Student/Content/Css/Table.css?v=" + DateTime.Now.Ticks)" rel="stylesheet" type="text/css" />
<script src="@Url.Content("~/Areas/Student/Content/Js/StudentRegister/StudentRegister.js?v=" + DateTime.Now.Ticks)"></script>
<script src="@Url.Content("~/Areas/Student/Content/Js/StudentRegister/StudentListClass.js?v=" + DateTime.Now.Ticks)"></script>

<div id="student-toast" class="student-toast" role="status" aria-live="polite"></div>

<div class="student-page">
    <div class="student-page-head">
        <div class="student-page-head-icon">
            <i class="fas fa-clipboard-list"></i>
        </div>
        <div class="student-page-head-main">
            <nav class="student-breadcrumb" aria-label="Điều hướng">
                <a href="@Url.Action("Index", "MainSinhVien", new { area = "Student" })">Trang chủ</a>
                <i class="fas fa-chevron-right"></i>
                <span aria-current="page">Đăng ký lao động</span>
            </nav>
            <h1 class="student-page-title">Đăng ký lao động</h1>
            <p class="student-page-subtitle">Chọn đợt lao động phù hợp và theo dõi trạng thái đăng ký của bạn.</p>
        </div>
    </div>

    @if (ViewBag.IsClassLeader == true)
    {
        <div class="leader-register-banner mb-3">
            <div class="leader-banner-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="leader-banner-content">
                <h5>Chế độ lớp trưởng</h5>
                <p>Bạn có thể đăng ký lao động cho bản thân hoặc đăng ký cho cả lớp theo từng đợt.</p>
            </div>
        </div>

        <div class="leader-tabs mb-3" role="tablist" aria-label="Hình thức đăng ký">
            <button type="button" id="tabCaNhan" class="leader-tab active" data-target="sectionCaNhan" role="tab" aria-selected="true">
                <i class="fas fa-user"></i>
                <span>Đăng ký cá nhân</span>
            </button>
            <button type="button" id="tabLop" class="leader-tab" data-target="sectionLop" role="tab" aria-selected="false">
                <i class="fas fa-users"></i>
                <span>Đăng ký theo lớp</span>
            </button>
        </div>

        <div id="sectionCaNhan" class="mb-4">
            <div class="student-card">
                <div class="student-card-header">
                    <h2 class="student-card-title">
                        <span class="student-card-icon blue"><i class="fas fa-user"></i></span>
                        Danh sách đợt lao động cá nhân
                    </h2>
                </div>
                <div class="student-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-custom mb-0">
                            <thead class="table-header-gradient">
                                <tr>
                                    <th class="text-center">STT</th>
                                    <th>Ngày lao động</th>
                                    <th>Buổi</th>
                                    <th>Loại lao động</th>
                                    <th>Giá trị</th>
                                    <th>Khu vực</th>
                                    <th>Số lượng SV</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="tableBodyCaNhan"></tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="pagination-wrap">
                <div id="paginationCaNhan" class="pagination-container">
                    <button type="button" id="prevCaNhan" aria-label="Trang trước"><i class="fas fa-chevron-left"></i></button>
                    <span id="pageNumbersCaNhan"></span>
                    <button type="button" id="nextCaNhan" aria-label="Trang sau"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>

        <div id="sectionLop" style="display: none;">
            <div class="student-card">
                <div class="student-card-header">
                    <h2 class="student-card-title">
                        <span class="student-card-icon indigo"><i class="fas fa-users"></i></span>
                        Danh sách đợt lao động theo lớp
                    </h2>
                </div>
                <div class="student-card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-custom mb-0">
                            <thead class="table-header-gradient">
                                <tr>
                                    <th class="text-center">STT</th>
                                    <th>Ngày lao động</th>
                                    <th>Buổi</th>
                                    <th>Loại lao động</th>
                                    <th>Giá trị</th>
                                    <th>Khu vực</th>
                                    <th>Số lượng lớp</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="tableBodyLop"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="pagination-wrap">
                <div id="paginationLop" class="pagination-container">
                    <button type="button" id="prevLop" aria-label="Trang trước"><i class="fas fa-chevron-left"></i></button>
                    <span id="pageNumbersLop"></span>
                    <button type="button" id="nextLop" aria-label="Trang sau"><i class="fas fa-chevron-right"></i></button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="student-card mb-4">
            <div class="student-card-header">
                <h2 class="student-card-title">
                    <span class="student-card-icon blue"><i class="fas fa-clipboard-list"></i></span>
                    Danh sách đợt lao động
                </h2>
            </div>
            <div class="student-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-custom mb-0">
                        <thead class="table-header-gradient">
                            <tr>
                                <th class="text-center">STT</th>
                                <th>Ngày lao động</th>
                                <th>Buổi</th>
                                <th>Loại lao động</th>
                                <th>Giá trị</th>
                                <th>Khu vực</th>
                                <th>Số lượng SV</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="pagination-wrap">
            <div id="pagination" class="pagination-container">
                <button type="button" id="prev" aria-label="Trang trước"><i class="fas fa-chevron-left"></i></button>
                <span id="pageNumbers"></span>
                <button type="button" id="next" aria-label="Trang sau"><i class="fas fa-chevron-right"></i></button>
            </div>
        </div>
    }
</div>

<!-- Modal đăng ký theo lớp -->
<div class="modal fade student-modal" id="modalDangKyLop" tabindex="-1" aria-labelledby="modalDangKyLopLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDangKyLopLabel">
                    <i class="fas fa-users"></i> Danh sách lớp để đăng ký
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div id="modalContentLop"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="student-btn student-btn-outline" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="student-btn student-btn-primary" id="btnXacNhanDangKyLop">Xác nhận đăng ký</button>
            </div>
        </div>
    </div>
</div>

<script>
    let toastTimeout = null;
    window.showMainToast = function (message, type = "success") {
        const toast = document.getElementById("student-toast");
        if (!toast) return;

        if (toastTimeout) {
            clearTimeout(toastTimeout);
        }

        const toastType = type === "success" || type === "error" || type === "warning" ? type : "info";
        toast.classList.remove("is-visible");
        toast.className = "student-toast is-" + toastType;
        toast.textContent = message;
        void toast.offsetWidth;
        toast.classList.add("is-visible");

        toastTimeout = setTimeout(() => {
            toast.classList.remove("is-visible");
        }, 5000);
    };

    document.addEventListener("DOMContentLoaded", function () {
        const tabs = document.querySelectorAll(".leader-tab");
        if (!tabs.length) return;

        function activateTab(targetId) {
            tabs.forEach(tab => {
                const isActive = tab.dataset.target === targetId;
                tab.classList.toggle("active", isActive);
                tab.setAttribute("aria-selected", isActive ? "true" : "false");
            });

            document.querySelectorAll("#sectionCaNhan, #sectionLop").forEach(section => {
                section.style.display = section.id === targetId ? "block" : "none";
            });
        }

        tabs.forEach(tab => {
            tab.addEventListener("click", function () {
                activateTab(this.dataset.target);
            });
        });

        const params = new URLSearchParams(window.location.search);
        if ((params.get("tab") || "").toLowerCase() === "lop") {
            activateTab("sectionLop");
        }
    });
</script>
