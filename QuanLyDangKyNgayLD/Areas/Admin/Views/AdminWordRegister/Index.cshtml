@model IEnumerable<QuanLyDangKyNgayLD.Models.TaoDotNgayLaoDong>
@{
    ViewBag.Title = "Quản Lý Đợt Lao Động";
    Layout = "~/Areas/Admin/Views/Shared/ViewShare.cshtml";


}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

<link href="~/Areas/Content/css/admonWwordRegister.css?v=@DateTime.Now.Ticks" rel="stylesheet" type="text/css" />
<link href="~/Areas/Content/adminpage.css?v=@DateTime.Now.Ticks" rel="stylesheet" type="text/css" />


@{
    var vaiTroId = Session["VaiTroId"] as int?;
}

<!-- THANH CÔNG CỤ -->
<nav class="navbar navbar-expand-lg toolbar shadow-sm mb-3">
    <div class="container-fluid p-0">
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <!-- Bên trái -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <button class="btn btn-outline-primary btn-sm me-2" id="btnAdd">
                        <i class="fa fa-plus me-1"></i> Tạo đợt mới
                    </button>
                </li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item">
                        <button class="btn btn-outline-danger btn-sm me-2 btn-delete-selected" id="btnDeleteSelectedDot" style="display:none;" title="Xóa các đợt đã chọn">
                            <i class="fas fa-trash-alt me-1"></i> Xóa đã chọn (<span class="selected-count">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-secondary btn-sm me-2" id="btnViewDeleted">
                            <i class="fas fa-trash-restore me-1"></i> Đợt đã xóa
                        </button>
                    </li>
                }
            </ul>

            <!-- Bên phải -->
            <form class="toolbar-flex align-items-center" role="search">
                <div class="input-group input-group-sm me-2" style="max-width: 180px;">
                    <label class="input-group-text bg-white border-end-0" for="sortMonthSelect">
                        <i class="fas fa-sort me-1"></i> Sắp xếp
                    </label>
                    <select id="sortMonthSelect" class="form-select border-start-0">
                        <option value="">-- Chọn --</option>
                        <option value="asc">Tăng dần</option>
                        <option value="desc">Giảm dần</option>
                    </select>
                </div>


                <select id="statusFilter" class="form-select form-select-sm me-2 shadow-sm" style="min-width: 150px;">
                    <option value="">-- Trạng thái duyệt --</option>
                    <option value="all">Tất cả</option>
                    <option value="1">Đã duyệt</option>
                    <option value="0">Chưa duyệt</option>
                </select>

                <select id="sessionFilter" class="form-select form-select-sm me-2 shadow-sm" style="min-width: 120px;">
                    <option value="">-- Buổi --</option>
                    <option value="Sáng">Sáng (7h-8h30h)</option>
                    <option value="Chiều">Chiều (13h-14h)</option>
                </select>

                <div class="input-group input-group-sm shadow-sm me-2" style="min-width: 220px;">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchBox" class="form-control border-start-0" placeholder="Tìm tên đợt, khu vực...">
                </div>




                <div class="dropdown d-inline-block">
                    <button class="btn btn-excel-manager dropdown-toggle" type="button" id="excelDropdownDot" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-file-excel me-1"></i> Quản lý Excel
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="excelDropdownDot">
                        <li>
                            <a class="dropdown-item py-2" href="@Url.Action("DownloadTemplate", "AdminWordRegister", new { area = "Admin" })">
                                <i class="fas fa-file-download text-primary me-2"></i> Xuất mẫu Import
                            </a>
                        </li>
                        <li>
                            <button class="dropdown-item py-2" type="button" data-bs-toggle="modal" data-bs-target="#modalImportDotExcel">
                                <i class="fas fa-file-upload text-success me-2"></i> Nhập Excel
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item py-2" type="button" id="btnExportDotData">
                                <i class="fas fa-file-export text-info me-2"></i> Xuất dữ liệu
                            </button>
                        </li>
                    </ul>
                </div>

            </form>
        </div>
    </div>
</nav>

<div class="table-wrapper shadow-sm rounded-3 bg-white p-2">
    <table class="table table-bordered table-hover align-middle text-center mb-0" style="width:100%; table-layout: fixed;">
        <thead class="table-light">
            <tr>
                <th style="width: 38px;" class="text-center"><input type="checkbox" id="checkAllDot" class="form-check-input" title="Chọn tất cả"></th>
                <th style="width: 45px;">STT</th>
                <th style="width: 14%;">Tên Đợt</th>
                <th style="width: 12%;">Buổi</th>
                <th style="width: 9%;">Loại LĐ</th>
                <th style="width: 7%;">Giá Trị</th>
                <th style="width: 10%;">Ngày LĐ</th>
                <th style="width: 9%;">Khu Vực</th>
                <th style="width: 13%;">Đăng ký/Quy định</th>
                <th style="width: 10%;">Trạng Thái</th>
                <th style="width: 16%; min-width: 155px;" class="action-header">Tác vụ</th>
            </tr>
        </thead>
        <tbody id="dotLaoDongTableBody">
            @if (Model != null && Model.Any())
            {
                var stt = 1;
                foreach (var item in Model)
                {
                    <tr data-id="@item.TaoDotLaoDong_id" data-mota="@Html.Raw(HttpUtility.JavaScriptStringEncode(item.MoTa ?? ""))" data-deleted="@(item.Ngayxoa != null)">
                        <td class="text-center"><input type="checkbox" class="form-check-input check-item-dot" value="@item.TaoDotLaoDong_id"></td>
                        <td class="stt-cell">@stt</td>
                        <td class="Dotloaodong">@item.DotLaoDong</td>
                        <td>@item.Buoi</td>
                        <td>@item.LoaiLaoDong</td>
                        <td class="text-success fw-bold">@String.Format("{0:N0}", item.GiaTri)</td>
                        <td class="px-1 text-center">
                            <span class="text-truncate d-inline-block w-100" style="max-width:80px;" title="@(item.NgayLaoDong?.ToString("dd/MM/yyyy"))">
                                @(item.NgayLaoDong?.ToString("dd/MM/yyyy"))
                            </span>
                        </td>
                        <td>@item.KhuVuc</td>
                        <td class="text-center">
                            @{
                                var dict = ViewBag.SoLuongDangKyDict as Dictionary<int, int>;
                                var key = item.TaoDotLaoDong_id;
                                var soDangKy = (dict != null && dict.ContainsKey(key)) ? dict[key] : 0;
                                var quyDinh = item.SoLuongSinhVien ?? 0;
                                var mau = soDangKy < quyDinh ? "text-danger fw-bold" : "text-success fw-bold";
                            }
                            <span class="@mau">@soDangKy/@quyDinh</span>
                        </td>


                        <td>
                            @if (item.TrangThaiDot == "Tạm ngưng")
                            {
                                <span class="badge bg-danger">Tạm ngưng</span>
                            }
                            else if (item.TrangThaiDuyet == true)
                            {
                                <span class="badge bg-success">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa duyệt</span>
                            }
                        </td>
                        <td class="action-cell">
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap w-100">
                                <button class="btn btn-sm btn-warning btn-edit" title="Sửa"
                                        data-id="@item.TaoDotLaoDong_id">
                                    <i class="fas fa-edit"></i>
                                </button>
                                @if (vaiTroId == 1 || vaiTroId == null)
                                {
                                    <button class="btn btn-sm btn-danger btn-delete" title="Xóa"
                                            data-id="@item.TaoDotLaoDong_id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                }
                                <button class="btn btn-sm btn-info btn-detail text-white" title="Chi tiết"
                                        data-id="@item.TaoDotLaoDong_id">
                                    <i class="fas fa-info-circle"></i>
                                </button>
                                <button class="btn btn-sm @(item.TrangThaiDot == "Tạm ngưng" ? "btn-secondary" : "btn-warning text-dark") btn-toggle-tamngung" 
                                        title="@(item.TrangThaiDot == "Tạm ngưng" ? "Mở lại đợt lao động" : "Tạm ngưng đợt lao động")"
                                        data-id="@item.TaoDotLaoDong_id"
                                        data-status="@item.TrangThaiDot">
                                    <i class="fas @(item.TrangThaiDot == "Tạm ngưng" ? "fa-play" : "fa-pause")"></i>
                                </button>
                                @if (item.TrangThaiDuyet == false)
                                {
                                    <button class="btn btn-sm btn-success btn-approve" title="Duyệt ngay"
                                            data-id="@item.TaoDotLaoDong_id">
                                        <i class="fas fa-check"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    stt++;
                }
            }
            else
            {
                <tr class="no-data-row">
                    <td colspan="11" class="text-muted py-4">Không có dữ liệu đợt lao động</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PHÂN TRANG -->
<div class="d-flex justify-content-center align-items-center flex-wrap gap-3 mt-3 mb-4">
    <div id="pagination" class="pagination-container my-0">
        <!-- Nút trang trước -->
        <button class="btn btn-secondary btn-sm me-1" id="prev">&lt;</button>

        <!-- Vùng chứa số trang -->
        <span id="pageNumbers"></span>

        <!-- Nút trang sau -->
        <button class="btn btn-secondary btn-sm ms-1" id="next">&gt;</button>
    </div>

    <div class="page-size-wrapper">
        <span class="page-size-label"><i class="fas fa-list-ul me-1"></i> Hiển thị:</span>
        <select id="pageSizeDot" class="form-select form-select-sm page-size-select" title="Số dòng mỗi trang">
            <option value="5">5 dòng / trang</option>
            <option value="10" selected>10 dòng / trang</option>
            <option value="20">20 dòng / trang</option>
            <option value="50">50 dòng / trang</option>
            <option value="100">100 dòng / trang</option>
            <option value="1000000">Tất cả</option>
        </select>
    </div>
</div>


<!-- ==================== TẤT CẢ MODAL ==================== -->
<!-- Modal Tạo Mới -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
            <form id="createForm" action="/Admin/AdminWordRegister/CreateAjax" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold"><i class="fa fa-plus-circle me-2"></i> Tạo Đợt Lao Động Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-4 align-items-stretch">
                        <!-- Khung ảnh bên trái -->
                        <div class="col-lg-5 col-md-5 d-flex flex-column">
                            <div class="khuvuc-frame h-100 mb-0 d-flex flex-column align-items-center justify-content-center p-2 rounded-4 border bg-light position-relative" style="min-height: 420px; box-shadow: inset 0 2px 6px rgba(0,0,0,0.04);">
                                <img id="createKhuVucImage" alt="Ảnh khu vực" class="img-fluid rounded-3" style="max-height: 450px; width: 100%; object-fit: contain;" />
                            </div>
                        </div>

                        <!-- Form bên phải -->
                        <div class="col-lg-7 col-md-7">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Đợt lao động (Tháng) <span class="text-danger">*</span></label>
                                    <select name="DotLaoDong" id="dotLaoDongMonth" class="form-select shadow-sm" required>
                                        <option value="">-- Chọn tháng --</option>
                                        <option value="Tháng 1">Tháng 1</option>
                                        <option value="Tháng 2">Tháng 2</option>
                                        <option value="Tháng 3">Tháng 3</option>
                                        <option value="Tháng 4">Tháng 4</option>
                                        <option value="Tháng 5">Tháng 5</option>
                                        <option value="Tháng 6">Tháng 6</option>
                                        <option value="Tháng 7">Tháng 7</option>
                                        <option value="Tháng 8">Tháng 8</option>
                                        <option value="Tháng 9">Tháng 9</option>
                                        <option value="Tháng 10">Tháng 10</option>
                                        <option value="Tháng 11">Tháng 11</option>
                                        <option value="Tháng 12">Tháng 12</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Buổi <span class="text-danger">*</span></label>
                                    <select name="Buoi" class="form-select shadow-sm" required>
                                        <option value="">-- Chọn buổi --</option>
                                        <option value="Sáng">Sáng (7h-8h30)</option>
                                        <option value="Chiều">Chiều (13h-14h)</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Loại lao động</label>
                                    <select name="LoaiLaoDong" class="form-select shadow-sm" required>
                                        <option value="">-- Chọn loại lao động --</option>
                                        <option value="Cá Nhân">Cá Nhân</option>
                                        <option value="Lớp">Lớp</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Giá trị (điểm)</label>
                                    <input name="GiaTri" type="number" step="0.1" class="form-control shadow-sm" value="1" min="0" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Ngày lao động <span class="text-danger">*</span></label>
                                    <select name="NgayLaoDong" id="dotLaoDongDay" class="form-select shadow-sm" required>
                                        <option value="">-- Chọn ngày --</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Khu vực <span class="text-danger">*</span></label>
                                    <select id="createKhuVuc" name="KhuVuc" class="form-select shadow-sm" required>
                                        <option value="">-- Chọn khu vực --</option>
                                        <option value="A1">Tòa A1</option>
                                        <option value="A2">Tòa A2</option>
                                        <option value="B1">Tòa B1</option>
                                        <option value="B2">Tòa B2</option>
                                        <option value="B3">Tòa B3</option>
                                        <option value="B4">Tòa B4</option>
                                        <option value="C1">Tòa C1</option>
                                        <option value="C2">Tòa C2</option>
                                        <option value="H1">Tòa H1</option>
                                        <option value="H2">Tòa H2</option>
                                        <option value="T2">Tòa T2</option>
                                        <option value="Trước cổng trường">Trước cổng trường</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Số lượng sinh viên</label>
                                    <input name="SoLuongSinhVien" type="number" class="form-control shadow-sm" min="1" value="20" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold">Mô tả công việc</label>
                                    <textarea name="MoTa" class="form-control shadow-sm" rows="3" placeholder="Nhập mô tả chi tiết công việc nếu có..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success px-4 fw-bold"><i class="fa fa-check me-1"></i> Tạo đợt</button>
                </div>
            </form>
        </div>
    </div>
</div>

