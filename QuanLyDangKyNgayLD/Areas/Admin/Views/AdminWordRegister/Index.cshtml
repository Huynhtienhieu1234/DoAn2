@model IEnumerable<QuanLyDangKyNgayLD.Models.TaoDotNgayLaoDong>
@{
    ViewBag.Title = "Đợt lao động";
    Layout = "~/Areas/Admin/Views/Shared/ViewShare.cshtml";


}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <link href="~/Areas/Content/adminpage.css?v=20261124_1" rel="stylesheet" type="text/css" />
    <link href="~/Areas/Content/css/admonWwordRegister.css?v=20261124_1" rel="stylesheet" type="text/css" />
}
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>


@{
    var vaiTroId = Session["VaiTroId"] as int?;
}

<div class="admin-page-head">
    <div class="admin-page-heading">
        <nav class="admin-breadcrumb" aria-label="breadcrumb">
            <a href="@Url.Action("Index", "Admin", new { area = "Admin" })">Quản trị</a>
            <i class="fas fa-chevron-right"></i>
            <span>Đợt lao động</span>
        </nav>
        <h1>Đợt lao động</h1>
        <p>Tạo, theo dõi và điều phối các đợt lao động theo tháng, buổi và khu vực.</p>
    </div>
    <div class="admin-page-actions">
        <span class="admin-date-chip">
            <i class="fas fa-calendar-check"></i> Kế hoạch lao động
        </span>
    </div>
</div>

<!-- THANH CÔNG CỤ -->
<nav class="navbar navbar-expand-lg toolbar shadow-sm mb-3">
    <div class="container-fluid p-0">
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <!-- Bên trái -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <button class="btn btn-outline-primary btn-sm me-2" id="btnAdd">
                        <i class="fa fa-plus me-1"></i> Tạo đợt mới
                    </button>
                </li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item">
                        <button class="btn btn-outline-danger btn-sm me-2 btn-delete-selected" id="btnDeleteSelectedDot" style="display:none;" title="Xóa các đợt đã chọn">
                            <i class="fas fa-trash-alt me-1"></i> Xóa đã chọn (<span class="selected-count">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-secondary btn-sm me-2" id="btnViewDeleted">
                            <i class="fas fa-trash-restore me-1"></i> Đợt đã xóa
                        </button>
                    </li>
                }
            </ul>

            <!-- Bên phải -->
            <form class="toolbar-flex align-items-center" role="search">
                <div class="input-group me-2" style="max-width: 175px;">
                    <label class="input-group-text" for="sortMonthSelect">
                        <i class="fas fa-sort text-muted me-1"></i> Sắp xếp
                    </label>
                    <select id="sortMonthSelect" class="form-select">
                        <option value="desc" selected>Mới nhất tới cũ</option>
                        <option value="asc">Cũ nhất tới mới</option>
                    </select>
                </div>

                <select id="statusFilter" class="form-select me-2" style="min-width: 155px;">
                    <option value="">-- Trạng thái duyệt --</option>
                    <option value="all">Tất cả</option>
                    <option value="1">Đã duyệt</option>
                    <option value="0">Chưa duyệt</option>
                </select>

                <select id="sessionFilter" class="form-select me-2" style="min-width: 130px;">
                    <option value="">-- Buổi --</option>
                    <option value="Sáng">Sáng (7h-8h30)</option>
                    <option value="Chiều">Chiều (13h-14h)</option>
                </select>

                <div class="input-group me-2" style="min-width: 230px;">
                    <span class="input-group-text">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchBox" class="form-control" placeholder="Tìm tên đợt, khu vực...">
                </div>
                <div class="dropdown d-inline-block">
                    <button class="btn btn-excel-manager dropdown-toggle" type="button" id="excelDropdownDot" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-file-excel me-1"></i> Quản lý Excel
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="excelDropdownDot">
                        <li>
                            <a class="dropdown-item py-2" href="@Url.Action("DownloadTemplate", "AdminWordRegister", new { area = "Admin" })">
                                <i class="fas fa-file-download text-primary me-2"></i> Xuất mẫu Import
                            </a>
                        </li>
                        <li>
                            <button class="dropdown-item py-2" type="button" data-bs-toggle="modal" data-bs-target="#modalImportDotExcel">
                                <i class="fas fa-file-upload text-success me-2"></i> Nhập Excel
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item py-2" type="button" id="btnExportDotData">
                                <i class="fas fa-file-export text-info me-2"></i> Xuất dữ liệu
                            </button>
                        </li>
                    </ul>
                </div>

            </form>
        </div>
    </div>
</nav>

<!-- BỘ CHUYỂN ĐỔI CHẾ ĐỘ XEM & THÔNG TIN CATALOG -->
<div class="alert alert-light border shadow-2xs d-flex align-items-center justify-content-between p-2 mb-3 rounded-3 small flex-wrap gap-2">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="text-secondary fw-bold"><i class="fas fa-lightbulb text-warning me-1"></i>Thao tác theo dõi & giám sát:</span>
        <span class="text-dark"><i class="fas fa-users text-primary me-1"></i><strong>Xem DS đăng ký:</strong> Bấm nút <span class="badge bg-primary-subtle text-primary border"><i class="fas fa-users"></i></span> hoặc click vào cột <strong>Sĩ số</strong></span>
        <span class="text-dark"><i class="fas fa-key text-primary me-1"></i><strong>Cấp mã điểm danh:</strong> Bấm nút <span class="badge bg-primary text-white"><i class="fas fa-key"></i></span> để lấy mã 6 ký tự</span>
        <span class="text-dark"><i class="fas fa-list-check text-success me-1"></i><strong>Giám sát điểm danh:</strong> Bấm nút <span class="badge bg-success text-white"><i class="fas fa-list-check"></i></span> để xem SV đã điểm danh</span>
    </div>
</div>

<div class="view-header-bar d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 px-1">
    <div class="d-flex align-items-center gap-2">
        <div class="form-check d-flex align-items-center mb-0 ps-0">
            <input type="checkbox" id="checkAllDotGlobal" class="form-check-input check-all-dot me-2" title="Chọn tất cả đợt hiển thị">
            <label for="checkAllDotGlobal" class="form-check-label fw-semibold text-secondary small user-select-none cursor-pointer">
                Chọn tất cả (<span id="totalVisibleDotCount">0</span> đợt)
            </label>
        </div>
        <span class="badge bg-light text-secondary border px-2 py-1 ms-2" style="font-weight: 500;">
            <i class="fas fa-layer-group text-primary me-1"></i> Trang: <strong id="dotDisplayCount" class="text-dark">0</strong> đợt
        </span>
    </div>

    <!-- Nút chuyển đổi chế độ xem -->
    <div class="view-mode-tabs d-inline-flex p-1 bg-white rounded-3 border shadow-2xs">
        <button type="button" class="btn btn-sm btn-mode-tab active" id="btnModeCatalog" data-mode="catalog" title="Giao diện Catalog Thẻ Thời Khóa Biểu">
            <i class="fas fa-th-large me-1"></i> Catalog Thẻ
        </button>
        <button type="button" class="btn btn-sm btn-mode-tab" id="btnModeTimetable" data-mode="timetable" title="Giao diện Lịch Thời Khóa Biểu Tuần">
            <i class="fas fa-calendar-week me-1"></i> Lịch Tuần
        </button>
        <button type="button" class="btn btn-sm btn-mode-tab" id="btnModeTable" data-mode="table" title="Giao diện Bảng Truyền Thống">
            <i class="fas fa-list-ul me-1"></i> Dạng Bảng
        </button>
    </div>
</div>

<!-- 1. GIAO DIỆN CATALOG THỜI KHÓA BIỂU (MẶC ĐỊNH) -->
<div id="dotCatalogContainer" class="row g-3 dot-catalog-grid mb-3">
    @for (int s = 0; s < 6; s++)
    {
        <div class="col-12 col-md-6 col-lg-4 skeleton-catalog-item">
            <div class="card h-100 border rounded-4 p-3 shadow-sm bg-white skeleton-catalog-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="skeleton-box skeleton-checkbox"></span>
                        <span class="skeleton-box skeleton-text" style="width: 80px; height: 16px;"></span>
                    </div>
                    <span class="skeleton-box skeleton-pill" style="width: 80px; height: 22px;"></span>
                </div>
                <div class="mb-3">
                    <span class="skeleton-box skeleton-text mb-2 d-block" style="width: 85%; height: 18px;"></span>
                    <span class="skeleton-box skeleton-text d-block" style="width: 60%; height: 13px;"></span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="skeleton-box skeleton-pill" style="width: 75px; height: 24px;"></span>
                    <span class="skeleton-box skeleton-pill" style="width: 65px; height: 24px;"></span>
                    <span class="skeleton-box skeleton-pill ms-auto" style="width: 55px; height: 24px;"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto" style="border-color: #f1f5f9;">
                    <span class="skeleton-box skeleton-text" style="width: 75px; height: 14px;"></span>
                    <div class="d-flex gap-1">
                        <span class="skeleton-box skeleton-btn" style="width: 28px; height: 28px;"></span>
                        <span class="skeleton-box skeleton-btn" style="width: 28px; height: 28px;"></span>
                        <span class="skeleton-box skeleton-btn" style="width: 28px; height: 28px;"></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- 2. GIAO DIỆN THỜI KHÓA BIỂU TUẦN (TIMETABLE MATRIX) -->
<div id="dotTimetableContainer" class="timetable-wrapper card border-0 shadow-sm rounded-4 p-3 mb-3" style="display: none;">
    <div class="timetable-nav d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnPrevWeek">
            <i class="fas fa-chevron-left me-1"></i> Tuần trước
        </button>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnCurrentWeek">
                <i class="fas fa-calendar-day me-1"></i> Tuần này
            </button>
            <h6 class="mb-0 fw-bold text-primary" id="timetableWeekTitle">Tuần: Đang tải...</h6>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnNextWeek">
            Tuần sau <i class="fas fa-chevron-right ms-1"></i>
        </button>
    </div>

    <div class="table-responsive rounded-3 border">
        <table class="table table-bordered timetable-matrix text-center align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 120px;" class="fw-bold text-secondary">Buổi / Tiết</th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 2</span><small id="ttDate2" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 3</span><small id="ttDate3" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 4</span><small id="ttDate4" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 5</span><small id="ttDate5" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 6</span><small id="ttDate6" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Thứ 7</span><small id="ttDate7" class="text-muted"></small></th>
                    <th class="timetable-th"><span class="d-block fw-bold text-dark">Chủ Nhật</span><small id="ttDateCN" class="text-muted"></small></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="timetable-session-header text-primary bg-light">
                        <i class="fas fa-sun text-warning me-1"></i>
                        <div>SÁNG</div>
                        <small class="text-muted fw-normal" style="font-size: 0.72rem;">7h00 - 8h30</small>
                    </th>
                    <td id="ttCell-sang-2" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-3" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-4" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-5" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-6" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-7" class="timetable-cell p-2"></td>
                    <td id="ttCell-sang-CN" class="timetable-cell p-2"></td>
                </tr>
                <tr>
                    <th class="timetable-session-header text-primary bg-light">
                        <i class="fas fa-cloud-moon text-primary me-1"></i>
                        <div>CHIỀU</div>
                        <small class="text-muted fw-normal" style="font-size: 0.72rem;">13h00 - 14h00</small>
                    </th>
                    <td id="ttCell-chieu-2" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-3" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-4" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-5" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-6" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-7" class="timetable-cell p-2"></td>
                    <td id="ttCell-chieu-CN" class="timetable-cell p-2"></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- 3. GIAO DIỆN BẢNG TRUYỀN THỐNG -->
<div id="dotTableContainer" class="table-wrapper shadow-sm rounded-3 bg-white p-2" style="display: none;">
    <table class="table table-bordered table-hover align-middle text-center mb-0" style="width:100%; table-layout: fixed;">
        <thead class="table-light">
            <tr>
                <th style="width: 38px;" class="text-center"><input type="checkbox" id="checkAllDot" class="form-check-input" title="Chọn tất cả"></th>
                <th style="width: 45px;">STT</th>
                <th style="width: 14%;">Tên Đợt</th>
                <th style="width: 8%;">Buổi</th>
                <th style="width: 8%;">Loại LĐ</th>
                <th style="width: 7%;">Giá Trị</th>
                <th style="width: 10%;">Ngày LĐ</th>
                <th style="width: 9%;">Khu Vực</th>
                <th style="width: 12%;">Đăng ký/Quy định</th>
                <th style="width: 10%;">Trạng Thái</th>
                <th style="width: 22%; min-width: 195px;" class="action-header">Tác vụ</th>
            </tr>
        </thead>
        <tbody id="dotLaoDongTableBody">
            @if (Model != null && Model.Any())
            {
                var stt = 1;
                foreach (var item in Model)
                {
                    <tr data-id="@item.TaoDotLaoDong_id" data-mota="@Html.Raw(HttpUtility.JavaScriptStringEncode(item.MoTa ?? ""))" data-deleted="@(item.Ngayxoa != null)">
                        <td class="text-center"><input type="checkbox" class="form-check-input check-item-dot" value="@item.TaoDotLaoDong_id"></td>
                        <td class="stt-cell">@stt</td>
                        <td class="Dotloaodong">@item.DotLaoDong</td>
                        <td>@item.Buoi</td>
                        <td>@item.LoaiLaoDong</td>
                        <td class="text-success fw-bold">@String.Format("{0:N0}", item.GiaTri)</td>
                        <td class="px-2 text-center text-nowrap">
                            <span class="fw-semibold">
                                @(item.NgayLaoDong?.ToString("dd/MM/yyyy"))
                            </span>
                        </td>
                        <td>@item.KhuVuc</td>
                        <td class="text-center">
                            @{
                                bool isLoaiLop = string.Equals(item.LoaiLaoDong?.Trim(), "Lớp", StringComparison.OrdinalIgnoreCase);
                                var dict = ViewBag.SoLuongDangKyDict as Dictionary<int, int>;
                                var lopDict = ViewBag.LopDaDangKyDict as Dictionary<int, int>;
                                var key = item.TaoDotLaoDong_id;
                                var soDangKy = (dict != null && dict.ContainsKey(key)) ? dict[key] : 0;
                                var soLopDangKy = (lopDict != null && lopDict.ContainsKey(key)) ? lopDict[key] : 0;
                                var quyDinh = isLoaiLop ? (item.SoLuongLop ?? 1) : (item.SoLuongSinhVien ?? 0);
                                var soThucTe = isLoaiLop ? soLopDangKy : soDangKy;
                                var mau = soThucTe < quyDinh ? "text-danger fw-bold" : "text-success fw-bold";

                                var now = DateTime.Now;
                                var today = DateTime.Today;
                                var nowTime = now.TimeOfDay;
                                bool isPast = false;
                                if (item.NgayLaoDong.HasValue)
                                {
                                    if (item.NgayLaoDong.Value.Date < today)
                                    {
                                        isPast = true;
                                    }
                                    else if (item.NgayLaoDong.Value.Date == today)
                                    {
                                        bool isSang = string.Equals(item.Buoi?.Trim(), "Sáng", StringComparison.OrdinalIgnoreCase) || (item.Buoi != null && item.Buoi.ToLower().Contains("sáng"));
                                        bool isChieu = string.Equals(item.Buoi?.Trim(), "Chiều", StringComparison.OrdinalIgnoreCase) || (item.Buoi != null && item.Buoi.ToLower().Contains("chiều"));
                                        if (isSang && nowTime >= new TimeSpan(7, 0, 0))
                                        {
                                            isPast = true;
                                        }
                                        else if (isChieu && nowTime >= new TimeSpan(13, 30, 0))
                                        {
                                            isPast = true;
                                        }
                                    }
                                }
                            }
                            <div class="btn-open-sv-thamgia p-1 rounded-2"
                                 data-id="@item.TaoDotLaoDong_id"
                                 data-loai="@item.LoaiLaoDong"
                                 style="cursor: pointer;"
                                 title="Bấm để xem danh sách đăng ký tham gia">
                                @if (isLoaiLop)
                                {
                                    <div class="d-flex flex-column align-items-center">
                                        <span class="@mau">
                                            <i class="fas fa-users text-primary me-1"></i>@soLopDangKy/@quyDinh Lớp
                                            <i class="fas fa-external-link-alt text-muted ms-1" style="font-size: 0.65rem;"></i>
                                        </span>
                                        <small class="text-muted" style="font-size: 0.75rem;">(Tối đa @(item.SoLuongSinhVien ?? 20) SV/lớp)</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="@mau">
                                        <i class="fas fa-user text-info me-1"></i>@soDangKy/@quyDinh SV
                                        <i class="fas fa-external-link-alt text-muted ms-1" style="font-size: 0.65rem;"></i>
                                    </span>
                                }
                            </div>
                        </td>


                        <td>
                            @if (item.TrangThaiDot == "Tạm ngưng")
                            {
                                <span class="badge bg-danger">Tạm ngưng</span>
                            }
                            else if (isPast && (item.TrangThaiDuyet != true || soThucTe < quyDinh))
                            {
                                <span class="badge bg-secondary">Kết thúc</span>
                            }
                            else if (item.TrangThaiDuyet == true)
                            {
                                <span class="badge bg-success">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chưa duyệt</span>
                            }
                        </td>
                        <td class="action-cell">
                            <div class="d-flex justify-content-center align-items-center gap-1 flex-nowrap w-100">
                                @if (item.TrangThaiDot == "Tạm ngưng")
                                {
                                    <!-- Nút Mở lại đợt -->
                                    <button class="btn btn-sm btn-warning text-dark btn-toggle-tamngung fw-semibold px-2" 
                                            title="Mở lại đợt lao động"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-status="@item.TrangThaiDot">
                                        <i class="fas fa-play me-1"></i>Mở lại
                                    </button>

                                    <!-- Nút Chi tiết -->
                                    <button class="btn btn-sm btn-info btn-detail text-white" title="Chi tiết"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-loai="@item.LoaiLaoDong">
                                        <i class="fas fa-info-circle"></i>
                                    </button>

                                    if (vaiTroId == 1 || vaiTroId == null)
                                    {
                                        <button class="btn btn-sm btn-danger btn-delete" title="Xóa"
                                                data-id="@item.TaoDotLaoDong_id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                }
                                else if (item.TrangThaiDuyet == true)
                                {
                                    <!-- ĐỢT ĐÃ DUYỆT -->
                                    <!-- Nút Cấp mã điểm danh -->
                                    <button class="btn btn-sm btn-primary btn-show-code"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-daduyet="1"
                                            title="Hiển thị mã điểm danh">
                                        <i class="fas fa-key"></i>
                                    </button>

                                    <!-- Nút Giám sát điểm danh -->
                                    <button class="btn btn-sm btn-success btn-view-attendance"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-daduyet="1"
                                            title="Giám sát điểm danh">
                                        <i class="fas fa-list-check"></i>
                                    </button>

                                    <!-- Nút Xem DS sinh viên đăng ký tham gia -->
                                    <button class="btn btn-sm btn-outline-primary btn-view-participants"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-loai="@item.LoaiLaoDong"
                                            title="Xem danh sách sinh viên tham gia">
                                        <i class="fas fa-users"></i>
                                    </button>

                                    <!-- Nút Chi tiết đợt -->
                                    <button class="btn btn-sm btn-info btn-detail text-white" title="Chi tiết"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-loai="@item.LoaiLaoDong">
                                        <i class="fas fa-info-circle"></i>
                                    </button>

                                    if (!isPast && item.TrangThaiDot != "Tạm ngưng")
                                    {
                                        <button class="btn btn-sm btn-warning text-dark btn-toggle-tamngung" 
                                                title="Tạm ngưng đợt lao động"
                                                data-id="@item.TaoDotLaoDong_id"
                                                data-status="@item.TrangThaiDot">
                                            <i class="fas fa-pause"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <!-- ĐỢT CHƯA DUYỆT (Nổi bật nhất: Nút Duyệt đặt đầu tiên) -->
                                    <button class="btn btn-sm btn-success btn-approve px-2 py-1 fw-semibold shadow-sm"
                                            data-id="@item.TaoDotLaoDong_id"
                                            title="Duyệt đợt lao động">
                                        <i class="fas fa-check me-1"></i>Duyệt
                                    </button>

                                    <!-- Nút Sửa -->
                                    <button class="btn btn-sm btn-warning btn-edit" title="Sửa"
                                            data-id="@item.TaoDotLaoDong_id">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    if (vaiTroId == 1 || vaiTroId == null)
                                    {
                                        <!-- Nút Xóa -->
                                        <button class="btn btn-sm btn-danger btn-delete" title="Xóa"
                                                data-id="@item.TaoDotLaoDong_id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }

                                    <!-- Nút Chi tiết đợt -->
                                    <button class="btn btn-sm btn-info btn-detail text-white" title="Chi tiết"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-loai="@item.LoaiLaoDong">
                                        <i class="fas fa-info-circle"></i>
                                    </button>

                                    <!-- Nút Xem DS sinh viên đăng ký tham gia -->
                                    <button class="btn btn-sm btn-outline-primary btn-view-participants"
                                            data-id="@item.TaoDotLaoDong_id"
                                            data-loai="@item.LoaiLaoDong"
                                            title="Xem danh sách sinh viên tham gia">
                                        <i class="fas fa-users"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    stt++;
                }
            }
            else
            {
                <tr class="no-data-row">
                    <td colspan="11" class="text-muted py-4">Không có dữ liệu đợt lao động</td>
                </tr>
            }
        </tbody>
    </table>
</div>

