<script src="~/Areas/Content/Js/adminCommon.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/Js/adminWordRegistor.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/Js/CreateCode.js?v=@DateTime.Now.Ticks"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // 1. Xuất dữ liệu Excel với bộ lọc hiện tại
        const btnExport = document.getElementById("btnExportDotData");
        if (btnExport) {
            btnExport.addEventListener("click", function () {
                const keyword = document.getElementById("searchBox")?.value || "";
                const buoi = document.getElementById("sessionFilter")?.value || "";
                const status = document.getElementById("statusFilter")?.value || "";

                let url = '@Url.Action("ExportExcel", "AdminWordRegister", new { area = "Admin" })';
                url += `?keyword=${encodeURIComponent(keyword)}&buoi=${encodeURIComponent(buoi)}&trangthai=${encodeURIComponent(status)}`;
                window.location.href = url;
            });
        }

        // 2. Xử lý Import Excel
        const btnSubmitImport = document.getElementById("btnSubmitImportDotExcel");
        const fileInput = document.getElementById("excelDotFileInput");
        const progress = document.getElementById("importDotProgress");
        const errorContainer = document.getElementById("importDotErrorContainer");
        const errorList = document.getElementById("importDotErrorList");

        function notifyAlert(icon, title, message, htmlExtra) {
            let contentHtml = `<p class="mb-2 fw-semibold">${message}</p>`;
            if (htmlExtra) contentHtml += htmlExtra;

            if (typeof Swal !== 'undefined') {
                return Swal.fire({
                    icon: icon,
                    title: title,
                    html: contentHtml,
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: icon === 'success' ? '#198754' : '#0d6efd'
                });
            } else {
                alert(title + "\n" + message);
                return Promise.resolve();
            }
        }

        if (btnSubmitImport && fileInput) {
            btnSubmitImport.addEventListener("click", function () {
                if (!fileInput.files || fileInput.files.length === 0) {
                    notifyAlert('warning', 'Chưa chọn file', 'Vui lòng chọn 1 file Excel (.xlsx) trước khi bấm Import!');
                    return;
                }

                const formData = new FormData();
                formData.append("file", fileInput.files[0]);

                progress.classList.remove("d-none");
                errorContainer.classList.add("d-none");
                errorList.innerHTML = "";
                btnSubmitImport.disabled = true;

                fetch('@Url.Action("ImportExcel", "AdminWordRegister", new { area = "Admin" })', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    progress.classList.add("d-none");
                    btnSubmitImport.disabled = false;

                    if (data.success) {
                        const modalEl = document.getElementById('modalImportDotExcel');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();

                        if (data.errors && data.errors.length > 0) {
                            let listHtml = `<div style="max-height: 180px; overflow-y: auto; text-align: left; background: #fff3cd; border: 1px solid #ffeeba; padding: 10px; border-radius: 6px; font-size: 0.85rem;"><ul class="mb-0 ps-3 text-dark">`;
                            data.errors.forEach(err => {
                                listHtml += `<li>${err}</li>`;
                            });
                            listHtml += `</ul></div>`;

                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Nhập thành công một phần!',
                                    html: `<p class="fw-bold mb-2 text-dark">${data.message}</p>${listHtml}`,
                                    confirmButtonText: 'Đóng & Tải lại',
                                    confirmButtonColor: '#0d6efd'
                                }).then(() => {
                                    if (typeof loadTableData === "function") loadTableData();
                                    else location.reload();
                                });
                            } else {
                                alert(data.message);
                                if (typeof loadTableData === "function") loadTableData();
                                else location.reload();
                            }
                        } else {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: data.message,
                                    confirmButtonText: 'Tuyệt vời',
                                    confirmButtonColor: '#198754'
                                }).then(() => {
                                    if (typeof loadTableData === "function") loadTableData();
                                    else location.reload();
                                });
                            } else {
                                alert(data.message);
                                if (typeof loadTableData === "function") loadTableData();
                                else location.reload();
                            }
                        }
                    } else {
                        let listHtml = "";
                        if (data.errors && data.errors.length > 0) {
                            errorContainer.classList.remove("d-none");
                            listHtml = `<div style="max-height: 180px; overflow-y: auto; text-align: left; background: #f8d7da; border: 1px solid #f5c6cb; padding: 10px; border-radius: 6px; font-size: 0.85rem;"><ul class="mb-0 ps-3 text-danger">`;
                            data.errors.forEach(err => {
                                const li = document.createElement("li");
                                li.textContent = err;
                                errorList.appendChild(li);
                                listHtml += `<li>${err}</li>`;
                            });
                            listHtml += `</ul></div>`;
                        }

                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Nhập file thất bại!',
                                html: `<p class="fw-bold mb-2 text-danger">${data.message || 'Có lỗi xảy ra'}</p>${listHtml}`,
                                confirmButtonText: 'Đóng & Thử lại',
                                confirmButtonColor: '#dc3545'
                            });
                        } else {
                            alert(data.message || "Lỗi nhập file");
                        }
                    }
                })
                .catch(err => {
                    progress.classList.add("d-none");
                    btnSubmitImport.disabled = false;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi máy chủ',
                            text: 'Có lỗi xảy ra khi gửi dữ liệu lên máy chủ: ' + err,
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#dc3545'
                        });
                    } else {
                        alert('Lỗi: ' + err);
                    }
                });
            });
        }
    });
</script>