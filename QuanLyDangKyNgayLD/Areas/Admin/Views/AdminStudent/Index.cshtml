@model IEnumerable<QuanLyDangKyNgayLD.Models.SinhVien>
@{
    ViewBag.Title = "Quản lý Sinh viên";
    Layout = "~/Areas/Admin/Views/Shared/ViewShare.cshtml";
}


@{
    var vaiTroId = Session["VaiTroId"] as int?;
}

<!-- THANH CÔNG CỤ -->
<nav class="navbar navbar-expand-lg toolbar shadow-sm mb-3">
    <div class="container-fluid p-0">
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <!-- Bên trái -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item">
                        <button class="btn btn-outline-primary btn-sm me-2" id="btnAdd">
                            <i class="fa fa-plus me-1"></i> Thêm sinh viên
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-danger btn-sm me-2 btn-delete-selected" id="btnDeleteSelectedStudent" style="display:none;" title="Xóa các sinh viên đã chọn">
                            <i class="fas fa-trash-alt me-1"></i> Xóa đã chọn (<span class="selected-count">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-outline-secondary btn-sm me-2" id="btnViewDeleted">
                            <i class="fas fa-trash-restore me-1"></i> Sinh viên đã xóa
                        </button>
                    </li>
                }
            </ul>

            <!-- Bên phải -->
            <form class="toolbar-flex align-items-center" role="search">
                <select id="roleFilter" class="form-select form-select-sm me-2 shadow-sm" style="min-width: 140px; cursor:pointer">
                    <option value="">-- Lọc theo Khoa --</option>
                    <option value="0">Tất cả</option>
                    <option value="1">Công nghệ và kỹ thuật</option>
                    <option value="2">Khoa Ngoại ngữ</option>
                    <option value="3">Khoa Kinh tế - Luật</option>
                    <option value="4">Nông nghiệp, Tài nguyên và Môi trường</option>
                    <option value="5">Văn hóa - Du lịch và Công tác xã hội</option>
                    <option value="6">Sư phạm Toán - Tin</option>
                    <option value="7">Sư phạm Khoa học tự nhiên</option>
                    <option value="8">Sư phạm Khoa học xã hội</option>
                    <option value="9">Giáo dục Tiểu học - Mầm non</option>
                    <option value="10">Giáo dục Thể chất - Sư phạm Nghệ thuật</option>
                </select>



                <div class="input-group input-group-sm shadow-sm me-2" style="min-width: 180px;">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchBox" class="form-control border-start-0" placeholder="Tìm kiếm...">
                </div>

                <div class="dropdown d-inline-block">
                    <button class="btn btn-excel-manager dropdown-toggle" type="button" id="excelDropdownStudent" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-file-excel me-1"></i> Quản lý Excel
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="excelDropdownStudent">
                        @if (vaiTroId == 1 || vaiTroId == null)
                        {
                            <li>
                                <a class="dropdown-item py-2" href="@Url.Action("DownloadTemplate", "AdminStudent", new { area = "Admin" })">
                                    <i class="fas fa-file-download text-primary me-2"></i> Xuất mẫu Import
                                </a>
                            </li>
                            <li>
                                <button class="dropdown-item py-2" type="button" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                                    <i class="fas fa-file-upload text-success me-2"></i> Nhập Excel
                                </button>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                        }
                        <li>
                            <button class="dropdown-item py-2" type="button" id="exportAllAccountstudent">
                                <i class="fas fa-file-export text-info me-2"></i> Xuất dữ liệu
                            </button>
                        </li>
                    </ul>
                </div>
            </form>
        </div>
    </div>
</nav>

<!-- BẢNG DỮ LIỆU -->
<div class="table-responsive shadow-sm rounded-3 bg-white p-2">
    <table class="table table-bordered table-hover align-middle mb-0 student-data-table">
        <colgroup>
            <col style="width: 45px;">
            <col style="width: 55px;">
            <col style="width: 13%;">
            <col style="width: 20%;">
            <col style="width: 9%;">
            <col style="width: 22%;">
            <col style="width: 16%;">
            <col style="width: 15%;">
        </colgroup>
        <thead class="table-light">
            <tr>
                <th class="text-center"><input type="checkbox" id="checkAllStudent" class="form-check-input" title="Chọn tất cả"></th>
                <th class="text-center">STT</th>
                <th class="text-center">MSSV</th>
                <th class="text-center">HỌ TÊN</th>
                <th class="text-center">GIỚI TÍNH</th>
                <th class="text-center">KHOA</th>
                <th class="text-center">LỚP</th>
                <th class="text-center action-header">TÁC VỤ</th>
            </tr>
        </thead>
        <tbody id="studentTableBody">
            <tr>
                <td colspan="8" class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"></i><br>
                    <small class="text-muted">Đang tải dữ liệu...</small>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- PHÂN TRANG -->
<div class="d-flex justify-content-center align-items-center flex-wrap gap-3 mt-3 mb-4">
    <div id="paginationStudent" class="pagination-container my-0">
        <button class="btn btn-secondary btn-sm me-1" id="prevStudent">&lt;</button>
        <span id="pageNumbersStudent"></span>
        <button class="btn btn-secondary btn-sm ms-1" id="nextStudent">&gt;</button>
    </div>

    <div class="page-size-wrapper">
        <span class="page-size-label"><i class="fas fa-list-ul me-1"></i> Hiển thị:</span>
        <select id="pageSizeStudent" class="form-select form-select-sm page-size-select" title="Số dòng mỗi trang">
            <option value="5">5 dòng / trang</option>
            <option value="10" selected>10 dòng / trang</option>
            <option value="20">20 dòng / trang</option>
            <option value="50">50 dòng / trang</option>
            <option value="100">100 dòng / trang</option>
            <option value="1000000">Tất cả</option>
        </select>
    </div>
</div>

<!-- ====================== MODAL THÊM SINH VIÊN ====================== -->
<div class="modal fade" id="createStudentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- modal-lg cho rộng vừa -->
        <div class="modal-content shadow-lg border-0">
            <form id="createStudentForm" method="post" action="/Admin/SinhVien/CreateAjax" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-user-plus me-2"></i> Thêm sinh viên mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body py-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">MSSV <span class="text-danger">*</span></label>
                            <input name="MSSV" type="text" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ tên <span class="text-danger">*</span></label>
                            <input name="HoTen" type="text" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày sinh</label>
                            <input type="text" id="createNgaySinh" name="NgaySinh"
                                   class="form-control form-control-sm"
                                   placeholder="dd/MM/yyyy" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giới tính</label>
                            <select name="GioiTinh" class="form-select form-select-sm">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Quê quán</label>
                            <input name="QueQuan" type="text" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="Email" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">SĐT</label>
                            <input name="SoDienThoaiSinhVien" type="text" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Khoa</label>
                            <select id="createKhoa" name="Khoa" class="form-select form-select-sm">
                                <option value="">-- Chọn khoa --</option>
                                <option value="1">Công nghệ và kỹ thuật</option>
                                <option value="2">Khoa Ngoại ngữ</option>
                                <option value="3">Khoa Kinh tế - Luật</option>
                                <option value="4">Nông nghiệp, Tài nguyên và Môi trường</option>
                                <option value="5">Văn hóa - Du lịch và Công tác xã hội</option>
                                <option value="6">Sư phạm Toán - Tin</option>
                                <option value="7">Sư phạm Khoa học tự nhiên</option>
                                <option value="8">Sư phạm Khoa học xã hội</option>
                                <option value="9">Giáo dục Tiểu học - Mầm non</option>
                                <option value="10">Giáo dục Thể chất - Sư phạm Nghệ thuật</option>
                            </select>

                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Lớp</label>
                            <select id="createLop" name="Lop_id" class="form-select form-select-sm">
                                <option value="">-- Chọn lớp --</option>
                            </select>
                        </div>

                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success px-5">
                        <i class="fas fa-save me-2"></i> Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>





<!-- ====================== MODAL CHỈNH SỬA ====================== -->
<div class="modal fade" id="editStudentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- modal-lg cho rộng vừa -->
        <div class="modal-content shadow-lg edit">
            <form id="editStudentForm" method="post" action="/Admin/SinhVien/EditAjax">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fa fa-edit me-2"></i> Chỉnh sửa sinh viên</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editMSSV" name="MSSV" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Họ tên</label>
                            <input type="text" id="editHoTen" name="HoTen" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày sinh</label>
                            <input type="text" id="editNgaySinh" name="NgaySinh" class="form-control form-control-sm" placeholder="dd/MM/yyyy" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giới tính</label>
                            <select id="editGioiTinh" name="GioiTinh" class="form-select form-select-sm">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Quê quán</label>
                            <input type="text" id="editQueQuan" name="QueQuan" class="form-control form-control-sm" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" id="editEmail" name="Email" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">SĐT</label>
                            <input type="text" id="editSDT" name="SoDienThoaiSinhVien" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Khoa</label>
                            <select id="editKhoa" name="Khoa" class="form-select form-select-sm">
                                <option value="">-- Chọn khoa --</option>
                                <option value="1">Công nghệ và kỹ thuật</option>
                                <option value="2">Khoa Ngoại ngữ</option>
                                <option value="3">Khoa Kinh tế - Luật</option>
                                <option value="4">Nông nghiệp, Tài nguyên và Môi trường</option>
                                <option value="5">Văn hóa - Du lịch và Công tác xã hội</option>
                                <option value="6">Sư phạm Toán - Tin</option>
                                <option value="7">Sư phạm Khoa học tự nhiên</option>
                                <option value="8">Sư phạm Khoa học xã hội</option>
                                <option value="9">Giáo dục Tiểu học - Mầm non</option>
                                <option value="10">Giáo dục Thể chất - Sư phạm Nghệ thuật</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Lớp</label>
                            <select id="editLop" name="Lop_id" class="form-select form-select-sm">
                                <option value="">-- Chọn lớp --</option>
                                @foreach (var lop in ViewBag.LopList as List<QuanLyDangKyNgayLD.Models.Lop>)
                                {
                                    <option value="@lop.Lop_id">@lop.TenLop</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- ====================== MODAL CHI TIẾT ====================== -->
<div class="modal fade" id="detailStudentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- thêm modal-lg để rộng hơn -->
        <div class="modal-content shadow-lg detail">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fa fa-info-circle me-2"></i> Thông tin sinh viên
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">MSSV</dt>
                    <dd class="col-sm-8" id="detailMSSV"></dd>

                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8" id="detailHoTen"></dd>

                    <dt class="col-sm-4">Ngày sinh</dt>
                    <dd class="col-sm-8" id="detailNgaySinh"></dd>

                    <dt class="col-sm-4">Giới tính</dt>
                    <dd class="col-sm-8" id="detailGioiTinh"></dd>

                    <dt class="col-sm-4">Quê quán</dt>
                    <dd class="col-sm-8" id="detailQueQuan"></dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8" id="detailEmail"></dd>

                    <dt class="col-sm-4">SĐT</dt>
                    <dd class="col-sm-8" id="detailSDT"></dd>

                    <dt class="col-sm-4">Khoa</dt>
                    <dd class="col-sm-8" id="detailKhoa"></dd>

                    <dt class="col-sm-4">Lớp</dt>
                    <dd class="col-sm-8" id="detailLop"></dd>
                </dl>
            </div>

        </div>
    </div>
</div>


<!-- ====================== MODAL XÓA ====================== -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">


        <div class="modal-content shadow-lg">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-trash me-2"></i> Xác nhận xóa sinh viên</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 3.5rem;"></i>
                <h6 class="fw-bold" id="deleteStudentText"></h6>
                <p class="text-muted">Hành động này không thể hoàn tác!</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteStudentBtn">Xác nhận xóa</button>
            </div>
        </div>
    </div>
</div>


<!-- ====================== MODAL DANH SÁCH ĐÃ XÓA ====================== -->
<div class="modal fade" id="deletedStudentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Modal Header -->
            <div class="modal-header bg-primary text-white py-3 px-4">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-white text-primary p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="fas fa-trash-restore fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0">Thùng Rác - Danh Sách Sinh Viên Đã Xóa</h5>
                        <small class="text-white-50">Quản lý khôi phục hoặc xóa vĩnh viễn các sinh viên đã xóa mềm</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold" id="deletedStudentTotalBadge">0 sinh viên</span>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 bg-light">
                <!-- Toolbar: Tìm kiếm & Thao tác hàng loạt -->
                <div class="card border-0 shadow-sm rounded-3 mb-3">
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <!-- Live Search -->
                            <div class="input-group input-group-sm" style="max-width: 320px;">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" id="searchDeletedStudents" class="form-control border-start-0 ps-0" placeholder="Tìm theo MSSV, Họ tên, Lớp...">
                            </div>

                            <!-- Bulk Action Buttons -->
                            <div class="d-flex align-items-center gap-2" id="deletedBulkActionContainer" style="display: none !important;">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold">
                                    <i class="fas fa-check-square me-1"></i> Đã chọn: <span id="deletedSelectedCount">0</span>
                                </span>
                                <button type="button" class="btn btn-sm btn-success shadow-sm d-flex align-items-center gap-1" id="btnBulkRestoreDeleted">
                                    <i class="fas fa-undo-alt"></i> Khôi phục đã chọn
                                </button>
                                <button type="button" class="btn btn-sm btn-danger shadow-sm d-flex align-items-center gap-1" id="btnBulkPermanentDelete">
                                    <i class="fas fa-trash-alt"></i> Xóa vĩnh viễn đã chọn
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảng sinh viên đã xóa -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="table-responsive" style="max-height: 480px; min-height: 250px;">
                        <table class="table table-hover align-middle mb-0 text-nowrap">
                            <thead class="table-primary sticky-top text-white" style="z-index: 1;">
                                <tr>
                                    <th class="text-center" style="width: 45px;">
                                        <input type="checkbox" class="form-check-input" id="checkAllDeletedStudents" title="Chọn tất cả">
                                    </th>
                                    <th class="text-center" style="width: 50px;">STT</th>
                                    <th class="text-center" style="width: 120px;">MSSV</th>
                                    <th>HỌ VÀ TÊN</th>
                                    <th>KHOA</th>
                                    <th>LỚP</th>
                                    <th class="text-center" style="width: 160px;">NGÀY XÓA</th>
                                    <th class="text-center" style="width: 190px;">TÁC VỤ</th>
                                </tr>
                            </thead>
                            <tbody id="deletedStudentsTableBody">
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-5">
                                        <div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải dữ liệu...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer bg-white border-top py-2 px-4 justify-content-between">
                <small class="text-muted"><i class="fas fa-info-circle me-1"></i> Sinh viên xóa vĩnh viễn sẽ bị loại bỏ hoàn toàn khỏi cơ sở dữ liệu.</small>
                <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ====================== MODAL XÁC NHẬN TÙY CHỈNH ====================== -->
<div class="modal fade" id="customConfirmModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title">
                    <i class="fas fa-question-circle me-2"></i> Xác nhận
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-exclamation-triangle text-warning mb-3" style="font-size: 3rem;"></i>
                <h6 class="fw-bold mb-1" id="confirmTitle"></h6>
                <p class="text-muted mb-0" id="confirmMessage"></p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="confirmCancelBtn">
                    <i class="fas fa-times me-1"></i> Hủy
                </button>
                <button type="button" class="btn btn-success" id="confirmOkBtn">
                    <i class="fas fa-check me-1"></i> Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ====================== MODAL NHẬP EXCEL SINH VIÊN ====================== -->
<div class="modal fade" id="importExcelModal" tabindex="-1" aria-labelledby="importExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 620px; width: 92%; margin: auto;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; width: 100%;">
            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fs-5 fw-bold" id="importExcelModalLabel">
                    <i class="fas fa-file-excel me-2"></i>Nhập Danh Sách Sinh Viên Từ Excel
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fas fa-info-circle fs-4 me-3 text-primary"></i>
                    <div>
                        <strong>Lưu ý:</strong> Vui lòng sử dụng file mẫu chuẩn. Hệ thống tự động kiểm tra trùng lặp <strong>MSSV</strong> và <strong>Email</strong>, tự động cấp tài khoản đăng nhập (mật khẩu mặc định = MSSV).
                        <a href="@Url.Action("DownloadTemplate", "AdminStudent", new { area = "Admin" })" class="alert-link text-decoration-underline ms-1">
                            <i class="fas fa-download me-1"></i>Tải file mẫu tại đây
                        </a>.
                    </div>
                </div>

                <form id="importForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="excelFileInput" class="form-label fw-bold">Chọn file Excel (.xlsx):</label>
                        <input class="form-control form-control-lg" type="file" id="excelFileInput" name="file" accept=".xlsx, .xls" required>
                    </div>

                    <div id="importStudentProgress" class="progress mb-3 d-none" style="height: 20px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 100%">Đang xử lý dữ liệu...</div>
                    </div>

                    <div id="importStudentErrorContainer" class="alert alert-danger d-none" style="max-height: 200px; overflow-y: auto;">
                        <h6 class="fw-bold mb-2"><i class="fas fa-exclamation-triangle me-2"></i>Chi tiết các dòng bị lỗi / trùng lặp:</h6>
                        <ul id="importStudentErrorList" class="mb-0 ps-3"></ul>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light border-0 py-3 d-flex justify-content-center gap-3">
                <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal" style="border-radius: 8px;">Hủy bỏ</button>
                <button type="button" class="btn btn-success px-4 fw-bold" id="btnSubmitImportStudentExcel" style="border-radius: 8px;">
                    <i class="fas fa-upload me-1"></i> Tiến hành Import
                </button>
            </div>
        </div>
    </div>
</div>

