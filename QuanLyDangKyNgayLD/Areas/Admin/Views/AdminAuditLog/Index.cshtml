@{
    ViewBag.Title = "Nhật Ký Thao Tác Xóa Dữ Liệu";
    Layout = "~/Areas/Admin/Views/Shared/ViewShare.cshtml";
    var thongKe = ViewBag.ThongKe as QuanLyDangKyNgayLD.AuditHelper.ThongKeAuditLogModel ?? new QuanLyDangKyNgayLD.AuditHelper.ThongKeAuditLogModel();
}

<style>
    .kpi-card {
        border-radius: 12px;
        padding: 14px 16px;
        color: #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 100%;
        min-height: 85px;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }
    .kpi-icon {
        font-size: 1.8rem;
        opacity: 0.85;
        flex-shrink: 0;
        margin-left: 8px;
    }
    .kpi-num {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
        line-height: 1.2;
    }
    .kpi-title {
        font-size: 0.74rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        opacity: 0.95;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .bg-gradient-primary-card { background: linear-gradient(135deg, #4f46e5, #3730a3); }
    .bg-gradient-warning-card { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .bg-gradient-info-card    { background: linear-gradient(135deg, #0284c7, #0369a1); }
    .bg-gradient-purple-card  { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }
    .bg-gradient-success-card { background: linear-gradient(135deg, #10b981, #047857); }

    .badge-table {
        padding: 6px 12px;
        font-size: 0.8rem;
        border-radius: 6px;
        font-weight: 600;
        letter-spacing: 0.3px;
        display: inline-block;
    }
    .badge-dot { background-color: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .badge-sv  { background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .badge-tk  { background-color: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
    .badge-xn  { background-color: #d1fae5; color: #047857; border: 1px solid #a7f3d0; }
    .badge-action-del { background: #fee2e2; color: #dc2626; font-weight: bold; border: 1px solid #fca5a5; }
    .badge-action-perm { background: #7f1d1d; color: #ffffff; font-weight: bold; }

    .json-viewer {
        background-color: #1e1e2e;
        color: #a6accd;
        border-radius: 8px;
        padding: 16px;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 0.85rem;
        max-height: 380px;
        overflow-y: auto;
        white-space: pre-wrap;
        word-break: break-all;
        border: 1px solid #313244;
    }
    .json-key { color: #82aaff; font-weight: 600; }
    .json-string { color: #c3e88d; }
    .json-number { color: #f78c6c; }
    .json-boolean { color: #ff5370; }
    .json-null { color: #7f848e; font-style: italic; }
</style>

<!-- THỐNG KÊ TỔNG QUAN -->
<div class="row g-3 mb-4">
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card bg-gradient-primary-card">
            <div>
                <div class="kpi-title">Tổng Lượt Xóa</div>
                <div class="kpi-num" id="kpiTongSo">@thongKe.TongSoXoa</div>
            </div>
            <i class="fas fa-trash-alt kpi-icon"></i>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card bg-gradient-warning-card">
            <div>
                <div class="kpi-title">Đợt Lao Động</div>
                <div class="kpi-num" id="kpiDotLD">@thongKe.SoDotLaoDong</div>
            </div>
            <i class="fas fa-calendar-times kpi-icon"></i>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card bg-gradient-info-card">
            <div>
                <div class="kpi-title">Sinh Viên</div>
                <div class="kpi-num" id="kpiSinhVien">@thongKe.SoSinhVien</div>
            </div>
            <i class="fas fa-user-slash kpi-icon"></i>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card bg-gradient-purple-card">
            <div>
                <div class="kpi-title">Tài Khoản</div>
                <div class="kpi-num" id="kpiTaiKhoan">@thongKe.SoTaiKhoan</div>
            </div>
            <i class="fas fa-id-badge kpi-icon"></i>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card bg-gradient-success-card">
            <div>
                <div class="kpi-title" title="Xác Nhận Hoàn Thành">Hoàn Thành LĐ</div>
                <div class="kpi-num" id="kpiHoanThanh">@thongKe.SoXacNhanHoanThanh</div>
            </div>
            <i class="fas fa-clipboard-check kpi-icon"></i>
        </div>
    </div>
    <div class="col-md-2 col-sm-6">
        <div class="kpi-card" style="background: linear-gradient(135deg, #ef4444, #b91c1c);">
            <div>
                <div class="kpi-title">Xóa Hôm Nay</div>
                <div class="kpi-num" id="kpiHomNay">@thongKe.SoXoaHomNay</div>
            </div>
            <i class="fas fa-clock kpi-icon"></i>
        </div>
    </div>
</div>

<!-- THANH CÔNG CỤ & BỘ LỌC -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <!-- Chọn Bảng -->
            <div class="col-lg-3 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-database text-muted"></i></span>
                    <select id="filterTenBang" class="form-select border-start-0">
                        <option value="ALL">-- Tất Cả Các Bảng --</option>
                        <option value="TaoDotNgayLaoDong">Tạo Đợt Lao Động</option>
                        <option value="SinhVien">Danh Sách Sinh Viên</option>
                        <option value="TaiKhoan">Quản Lý Tài Khoản</option>
                        <option value="PhieuXacNhanHoanThanh">Xác Nhận Hoàn Thành</option>
                    </select>
                </div>
            </div>

            <!-- Khoảng thời gian: Từ ngày -->
            <div class="col-lg-2 col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-calendar-alt text-muted"></i></span>
                    <input type="date" id="filterTuNgay" class="form-control border-start-0" title="Từ ngày">
                </div>
            </div>

            <!-- Khoảng thời gian: Đến ngày -->
            <div class="col-lg-2 col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-calendar-check text-muted"></i></span>
                    <input type="date" id="filterDenNgay" class="form-control border-start-0" title="Đến ngày">
                </div>
            </div>

            <!-- Ô tìm kiếm -->
            <div class="col-lg-3 col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="filterKeyword" class="form-control border-start-0" placeholder="Tìm theo Người xóa, Mã, IP...">
                </div>
            </div>

            <!-- Nút Thao tác -->
            <div class="col-lg-2 col-md-6 text-end">
                <button id="btnSearch" class="btn btn-primary btn-sm me-1" title="Lọc dữ liệu">
                    <i class="fas fa-filter me-1"></i> Lọc
                </button>
                <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm me-1" title="Đặt lại bộ lọc">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <button id="btnExportExcel" class="btn btn-outline-success btn-sm" title="Xuất báo cáo Excel">
                    <i class="fas fa-file-excel me-1"></i> Excel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG DANH SÁCH NHẬT KÝ -->
<div class="table-wrapper shadow-sm rounded-3 bg-white p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="fas fa-history text-primary me-2"></i> Lịch Sử Nhật Ký Thao Tác Xóa
        </h5>
        <span class="badge bg-light text-dark border px-3 py-2" id="totalRecordsBadge">
            Tổng cộng: <strong>0</strong> bản ghi
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle text-center mb-0" id="tableAuditLog">
            <thead>
                <tr>
                    <th style="width: 5%;">STT</th>
                    <th style="width: 15%;">Thời Gian</th>
                    <th style="width: 14%;">Người Thực Hiện</th>
                    <th style="width: 10%;">Hành Động</th>
                    <th style="width: 18%;">Bảng Bị Xóa</th>
                    <th style="width: 14%;">Khóa Chính</th>
                    <th style="width: 12%;">Địa Chỉ IP</th>
                    <th style="width: 12%;">Chi Tiết</th>
                </tr>
            </thead>
            <tbody id="tbodyAuditLog">
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu nhật ký...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG -->
    <div class="pagination-container mt-3" id="paginationAuditLog">
        <button class="page-btn" id="btnPrevPage" onclick="changePage(-1)"><i class="fas fa-chevron-left"></i></button>
        <span id="pageNumbers" class="d-flex gap-1"></span>
        <button class="page-btn" id="btnNextPage" onclick="changePage(1)"><i class="fas fa-chevron-right"></i></button>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT DỮ LIỆU ĐÃ XÓA -->
<div class="modal fade" id="auditDetailModal" tabindex="-1" aria-labelledby="auditDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title fw-bold" id="auditDetailModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Chi Tiết Nhật Ký Xóa Dữ Liệu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thông tin tóm tắt -->
                <div class="row g-3 mb-4 bg-light p-3 rounded-3 border">
                    <div class="col-md-6">
                        <strong><i class="fas fa-user me-1 text-primary"></i> Người thực hiện:</strong> 
                        <span id="modalNguoiThucHien" class="text-dark fw-bold">-</span>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="fas fa-clock me-1 text-primary"></i> Thời gian:</strong> 
                        <span id="modalThoiGian" class="text-dark">-</span>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="fas fa-table me-1 text-primary"></i> Bảng bị xóa:</strong> 
                        <span id="modalTenBang" class="badge-table">-</span>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="fas fa-key me-1 text-primary"></i> Khóa chính (ID/Mã):</strong> 
                        <span id="modalKhoaChinh" class="fw-bold text-danger">-</span>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="fas fa-network-wired me-1 text-primary"></i> Địa chỉ IP:</strong> 
                        <span id="modalDiaChiIP" class="text-secondary">-</span>
                    </div>
                    <div class="col-md-6">
                        <strong><i class="fas fa-bolt me-1 text-primary"></i> Hành động:</strong> 
                        <span id="modalHanhDong" class="badge bg-danger">-</span>
                    </div>
                </div>

                <!-- Dữ liệu JSON -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fas fa-code me-1 text-primary"></i> Dữ Liệu Trước Khi Xóa (JSON Snapshot):
                    </h6>
                    <button class="btn btn-outline-dark btn-sm" id="btnCopyJson" onclick="copyJsonData()">
                        <i class="fas fa-copy me-1"></i> Sao chép JSON
                    </button>
                </div>
                <div class="json-viewer" id="modalJsonViewer">
                    // Dữ liệu JSON...
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
        let currentPage = 1;
        const pageSize = 10;
        let totalPages = 1;
        let currentJsonString = "";

        $(document).ready(function () {
            loadAuditLogs(1);

            // Tìm kiếm khi gõ phím Enter
            $('#filterKeyword').on('keypress', function (e) {
                if (e.which === 13) {
                    currentPage = 1;
                    loadAuditLogs(1);
                }
            });

            // Sự kiện nút Lọc
            $('#btnSearch').on('click', function () {
                currentPage = 1;
                loadAuditLogs(1);
            });

            // Thay đổi bộ lọc Bảng
            $('#filterTenBang').on('change', function () {
                currentPage = 1;
                loadAuditLogs(1);
            });

            // Đặt lại bộ lọc
            $('#btnResetFilter').on('click', function () {
                $('#filterTenBang').val('ALL');
                $('#filterTuNgay').val('');
                $('#filterDenNgay').val('');
                $('#filterKeyword').val('');
                currentPage = 1;
                loadAuditLogs(1);
                loadStats();
            });

            // Xuất Excel
            $('#btnExportExcel').on('click', function () {
                const tenBang = $('#filterTenBang').val();
                const tuNgay = $('#filterTuNgay').val();
                const denNgay = $('#filterDenNgay').val();
                const keyword = $('#filterKeyword').val();

                const url = `@Url.Action("ExportExcel", "AdminAuditLog", new { area = "Admin" })`
                    + `?tenBang=${encodeURIComponent(tenBang)}&tuNgay=${encodeURIComponent(tuNgay)}&denNgay=${encodeURIComponent(denNgay)}&keyword=${encodeURIComponent(keyword)}`;

                window.location.href = url;
            });
        });

        function loadStats() {
            $.get('@Url.Action("GetStatsAjax", "AdminAuditLog", new { area = "Admin" })', function (res) {
                if (res.success && res.data) {
                    $('#kpiTongSo').text(res.data.TongSoXoa);
                    $('#kpiDotLD').text(res.data.SoDotLaoDong);
                    $('#kpiSinhVien').text(res.data.SoSinhVien);
                    $('#kpiTaiKhoan').text(res.data.SoTaiKhoan);
                    $('#kpiHoanThanh').text(res.data.SoXacNhanHoanThanh);
                    $('#kpiHomNay').text(res.data.SoXoaHomNay);
                }
            });
        }

        function loadAuditLogs(page) {
            currentPage = page;
            const tenBang = $('#filterTenBang').val();
            const tuNgay = $('#filterTuNgay').val();
            const denNgay = $('#filterDenNgay').val();
            const keyword = $('#filterKeyword').val();

            $('#tbodyAuditLog').html(`
                <tr>
                    <td colspan="8" class="text-center py-4 text-muted">
                        <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu nhật ký...
                    </td>
                </tr>
            `);

            $.ajax({
                url: '@Url.Action("GetLogsAjax", "AdminAuditLog", new { area = "Admin" })',
                type: 'GET',
                data: {
                    tenBang: tenBang,
                    tuNgay: tuNgay,
                    denNgay: denNgay,
                    keyword: keyword,
                    page: page,
                    pageSize: pageSize
                },
                success: function (res) {
                    if (res.success) {
                        renderTable(res.data, res.currentPage, res.totalItems);
                        renderPagination(res.currentPage, res.totalPages);
                        $('#totalRecordsBadge').html(`Tổng cộng: <strong>${res.totalItems}</strong> bản ghi`);
                    } else {
                        $('#tbodyAuditLog').html(`
                            <tr>
                                <td colspan="8" class="text-center text-danger py-4">
                                    <i class="fas fa-exclamation-triangle me-2"></i> ${res.message || 'Lỗi khi tải dữ liệu'}
                                </td>
                            </tr>
                        `);
                    }
                },
                error: function () {
                    $('#tbodyAuditLog').html(`
                        <tr>
                            <td colspan="8" class="text-center text-danger py-4">
                                <i class="fas fa-exclamation-circle me-2"></i> Không thể kết nối tới cơ sở dữ liệu Audit Log. Vui lòng kiểm tra lại cấu hình DB QuanLyAuditLog.
                            </td>
                        </tr>
                    `);
                }
            });
        }

        function renderTable(items, page, totalItems) {
            if (!items || items.length === 0) {
                $('#tbodyAuditLog').html(`
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open me-2"></i> Không có nhật ký thao tác xóa nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                `);
                return;
            }

            let html = '';
            const startIndex = (page - 1) * pageSize;

            items.forEach((item, index) => {
                const stt = startIndex + index + 1;
                let badgeClass = 'badge-dot';
                let icon = 'fa-calendar-alt';

                if (item.TenBang === 'SinhVien') {
                    badgeClass = 'badge-sv';
                    icon = 'fa-user-graduate';
                } else if (item.TenBang === 'TaiKhoan') {
                    badgeClass = 'badge-tk';
                    icon = 'fa-id-card';
                } else if (item.TenBang === 'PhieuXacNhanHoanThanh') {
                    badgeClass = 'badge-xn';
                    icon = 'fa-clipboard-check';
                }

                const actionBadge = item.HanhDong === 'DELETE_PERMANENT' 
                    ? `<span class="badge badge-action-perm"><i class="fas fa-fire me-1"></i>XÓA HẲN</span>` 
                    : `<span class="badge badge-action-del"><i class="fas fa-trash me-1"></i>XÓA</span>`;

                html += `
                    <tr>
                        <td class="fw-bold">${stt}</td>
                        <td>
                            <div class="fw-bold text-dark"><i class="far fa-clock text-primary me-1"></i>${item.ThoiGian}</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1">
                                <i class="fas fa-user-circle text-primary me-1"></i><strong>${escapeHtml(item.NguoiThucHien)}</strong>
                            </span>
                        </td>
                        <td>${actionBadge}</td>
                        <td>
                            <span class="badge-table ${badgeClass}">
                                <i class="fas ${icon} me-1"></i>${escapeHtml(item.TenBangHienThi)}
                            </span>
                        </td>
                        <td>
                            <code class="text-danger fw-bold" style="font-size: 0.9rem;">${escapeHtml(item.KhoaChinhBiXoa)}</code>
                        </td>
                        <td>
                            <small class="text-muted"><i class="fas fa-network-wired me-1"></i>${escapeHtml(item.DiaChiIP)}</small>
                        </td>
                        <td class="action-cell">
                            <button class="btn btn-info btn-sm" onclick="viewDetail(${item.Id})" title="Xem chi tiết dữ liệu đã xóa">
                                <i class="fas fa-eye"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });

            $('#tbodyAuditLog').html(html);
        }

        function renderPagination(current, total) {
            totalPages = total;
            $('#btnPrevPage').prop('disabled', current <= 1);
            $('#btnNextPage').prop('disabled', current >= total || total === 0);

            let html = '';
            if (total > 1) {
                for (let i = 1; i <= total; i++) {
                    if (i === 1 || i === total || (i >= current - 2 && i <= current + 2)) {
                        const activeClass = (i === current) ? 'active' : '';
                        html += `<button class="page-btn page-number ${activeClass}" onclick="loadAuditLogs(${i})">${i}</button>`;
                    } else if (i === current - 3 || i === current + 3) {
                        html += `<span class="px-1 text-muted">...</span>`;
                    }
                }
            }
            $('#pageNumbers').html(html);
        }

        function changePage(delta) {
            const target = currentPage + delta;
            if (target >= 1 && target <= totalPages) {
                loadAuditLogs(target);
            }
        }

        function viewDetail(id) {
            $.ajax({
                url: '@Url.Action("GetDetailAjax", "AdminAuditLog", new { area = "Admin" })',
                type: 'GET',
                data: { id: id },
                success: function (res) {
                    if (res.success && res.data) {
                        const d = res.data;
                        $('#modalNguoiThucHien').text(d.NguoiThucHien || '-');
                        $('#modalThoiGian').text(d.ThoiGian || '-');
                        $('#modalTenBang').text(d.TenBangHienThi || d.TenBang);
                        $('#modalKhoaChinh').text(d.KhoaChinhBiXoa || '-');
                        $('#modalDiaChiIP').text(d.DiaChiIP || '-');
                        $('#modalHanhDong').text(d.HanhDong || 'DELETE');

                        // Set badge class cho modal
                        $('#modalTenBang').removeClass('badge-dot badge-sv badge-tk badge-xn');
                        if (d.TenBang === 'SinhVien') $('#modalTenBang').addClass('badge-sv');
                        else if (d.TenBang === 'TaiKhoan') $('#modalTenBang').addClass('badge-tk');
                        else if (d.TenBang === 'PhieuXacNhanHoanThanh') $('#modalTenBang').addClass('badge-xn');
                        else $('#modalTenBang').addClass('badge-dot');

                        // Format JSON
                        currentJsonString = d.DuLieuCu || "{}";
                        try {
                            const parsed = JSON.parse(currentJsonString);
                            const formatted = JSON.stringify(parsed, null, 4);
                            $('#modalJsonViewer').html(syntaxHighlight(formatted));
                        } catch (e) {
                            $('#modalJsonViewer').text(currentJsonString);
                        }

                        const modal = new bootstrap.Modal(document.getElementById('auditDetailModal'));
                        modal.show();
                    } else {
                        alert(res.message || 'Không tìm thấy dữ liệu.');
                    }
                },
                error: function () {
                    alert('Lỗi khi tải chi tiết nhật ký.');
                }
            });
        }

        function syntaxHighlight(json) {
            json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function (match) {
                let cls = 'json-number';
                if (/^"/.test(match)) {
                    if (/:$/.test(match)) {
                        cls = 'json-key';
                    } else {
                        cls = 'json-string';
                    }
                } else if (/true|false/.test(match)) {
                    cls = 'json-boolean';
                } else if (/null/.test(match)) {
                    cls = 'json-null';
                }
                return '<span class="' + cls + '">' + match + '</span>';
            });
        }

        function copyJsonData() {
            if (!currentJsonString) return;
            navigator.clipboard.writeText(currentJsonString).then(() => {
                const btn = $('#btnCopyJson');
                const orig = btn.html();
                btn.html('<i class="fas fa-check text-success me-1"></i> Đã sao chép!').addClass('btn-success text-white').removeClass('btn-outline-dark');
                setTimeout(() => {
                    btn.html(orig).removeClass('btn-success text-white').addClass('btn-outline-dark');
                }, 2000);
            }).catch(() => {
                alert('Không thể sao chép dữ liệu.');
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div>').text(text).html();
        }
    </script>
