        .admin-panel-title {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-primary);
        }

        .admin-panel-sub {
            margin: 3px 0 0;
            font-size: 0.78rem;
            color: var(--text-secondary);
        }

        .admin-chart-body {
            height: 320px;
            padding: 18px 20px 20px;
        }

        .admin-quick-list {
            padding: 8px;
        }

        .admin-quick-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
