@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<head>
    <meta charset="utf-8">
    <title>Trang Quản Trị</title>

    <!-- Font + Bootstrap + Icon -->
    <link rel="icon" type="image/png" href="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/logoxoanen.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Load CSS theo controller -->
    @if (controller == "AdminStudent")
    {
        <link rel="stylesheet" href="~/Areas/Content/css/AdminStudentRegister.css?v=@DateTime.Now.Ticks" />
    }
    else if (controller == "Account" || controller == "AdminAccount")
    {
        <link rel="stylesheet" href="~/Areas/Content/css/AdminCount.css?v=@DateTime.Now.Ticks" />
    }
    else
    {
        <link rel="stylesheet" href="~/Areas/Content/admin.css?v=@DateTime.Now.Ticks" />
    }

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Areas/Content/Js/adminCommon.js"></script>

    <style>
        /* ====== BỐ CỤC CHUNG - ĐỒNG BỘ KÍCH THƯỚC CHIỀU RỘNG/CHIỀU DÀI CHUẨN THỐNG KÊ ====== */
        aside {
            width: 245px !important;
            min-height: 95vh;
            margin: 15px 10px 15px 15px !important;
            border-radius: 16px !important;
            flex-shrink: 0 !important;
        }

        main.main-content {
            flex: 1 !important;
            width: calc(100% - 275px) !important;
            min-width: 0 !important;
            margin-top: 10px !important;
            margin-right: 15px !important;
            margin-left: 5px !important;
            padding: 10px 5px 30px !important; /* Chuẩn padding kích thước như Thống Kê */
        }

        /* ====== ĐỒNG BỘ THANH HEADER TRÊN CÙNG BẰNG VỚI TOOLBAR ====== */
        .header-navbar,
        nav.navbar-main,
        .navbar.navbar-main {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 0 20px 0 !important;
            padding: 10px 20px !important;
            background: rgba(255, 255, 255, 0.94) !important;
            backdrop-filter: blur(12px) !important;
            -webkit-backdrop-filter: blur(12px) !important;
            border: 1.5px solid rgba(178, 235, 242, 0.4) !important;
            border-radius: 16px !important;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08) !important;
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
        }

        .header-navbar .container-fluid,
        nav.navbar-main .container-fluid {
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .header-navbar .logo,
        nav.navbar-main .logo {
            height: 52px;
            max-height: 52px;
            object-fit: contain;
        }

        /* Đồng bộ kích thước chiều ngang và chiều dọc của Toolbar và Bảng tất cả các trang */
        .toolbar,
        .filter-bar,
        .tk-filter-card {
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 0 20px 0 !important;
            border-radius: 16px !important;
        }

        .table-responsive,
        .table-wrapper {
            width: 100% !important;
            max-width: 100% !important;
            border-radius: 14px !important;
            min-height: 380px !important;
            margin-bottom: 24px !important;
        }

        .container-fluid {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* ====== ĐỒNG BỘ MÀU HEADER TẤT CẢ BẢNG ADMIN ====== */
        .table thead th, table thead th, table th {
            background: #0029c8d9 !important;
            background-color: #0029c8d9 !important;
            color: #ffffff !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.82rem;
            letter-spacing: 0.6px;
            vertical-align: middle;
            text-align: center;
            border: none;
            padding: 13px 10px;
        }

        .table tbody tr:hover td, table tr:hover td {
            background-color: #ebf3fd !important;
        }

        /* ====== ĐỒNG BỘ NÚT TÁC VỤ (ACTION BUTTONS - CHUẨN TRANG TÀI KHOẢN) ====== */
        .action-cell {
            white-space: nowrap !important;
            text-align: center !important;
            vertical-align: middle !important;
            padding: 8px 6px !important;
        }

        .action-cell .btn, 
        .action-cell button,
        .btn-action {
            width: 32px !important;
            height: 32px !important;
            min-width: 32px !important;
            max-width: 32px !important;
            padding: 0 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            border-radius: 8px !important;
            font-size: 0.85rem !important;
            margin: 0 2px !important;
            border: none !important;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.12) !important;
            cursor: pointer !important;
            color: #ffffff !important;
        }

        .action-cell .btn:hover,
        .action-cell button:hover,
        .btn-action:hover {
            transform: translateY(-2px) scale(1.08) !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2) !important;
            color: #ffffff !important;
        }

        .action-cell .btn:active,
        .action-cell button:active,
        .btn-action:active {
            transform: translateY(0) scale(0.92) !important;
        }

        /* Màu sắc nút tác vụ chuẩn hóa */
        .action-cell .btn-warning, .action-cell .btn-edit, .action-cell .btn-edit-student {
            background: linear-gradient(135deg, #f59e0b, #d97706) !important;
            color: #ffffff !important;
        }

        .action-cell .btn-danger, .action-cell .btn-delete, .action-cell .btn-delete-student {
            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
            color: #ffffff !important;
        }

        .action-cell .btn-info, .action-cell .btn-detail, .action-cell .btn-detail-student {
            background: linear-gradient(135deg, #0ea5e9, #0284c7) !important;
            color: #ffffff !important;
        }

        .action-cell .btn-success, .action-cell .btn-duyet, .action-cell .btn-approve {
            background: linear-gradient(135deg, #10b981, #059669) !important;
            color: #ffffff !important;
        }

        .action-cell .btn-secondary, .action-cell .btn-reset {
            background: linear-gradient(135deg, #64748b, #475569) !important;
            color: #ffffff !important;
        }

        /* ====== ĐỒNG BỘ PHÂN TRANG (PAGINATION) CHUẨN TRANG DANH SÁCH SINH VIÊN ====== */
        .pagination-container, #pagination, #paginationStudent {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            flex-wrap: wrap !important;
            margin: 1.5rem 0 !important;
        }

        .pagination-container button, 
        #pagination button, 
        #paginationStudent button,
        #pageNumbers button,
        #pageNumbersStudent button,
        .page-btn,
        .page-number,
        #prev, #next, #prevStudent, #nextStudent {
            min-width: 36px !important;
            height: 36px !important;
            padding: 0 10px !important;
            border-radius: 8px !important;
            background: #ffffff !important;
            border: 1.5px solid #c3dafe !important;
            color: #667eea !important;
            font-weight: 600 !important;
            font-size: 0.9rem !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05) !important;
            cursor: pointer !important;
            margin: 0 2px !important;
        }

        .pagination-container button:hover:not(:disabled):not(.active), 
        #pagination button:hover:not(:disabled):not(.active), 
        #paginationStudent button:hover:not(:disabled):not(.active), 
        #pageNumbers button:hover:not(:disabled):not(.active),
        #pageNumbersStudent button:hover:not(:disabled):not(.active),
        .page-btn:hover:not(.active),
        .page-number:hover:not(.active),
        #prev:hover:not(:disabled), #next:hover:not(:disabled), 
        #prevStudent:hover:not(:disabled), #nextStudent:hover:not(:disabled) {
            background: #ebf4ff !important;
            border-color: #667eea !important;
            color: #4338ca !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.25) !important;
        }

        #pageNumbers button.active,
        #pageNumbers button.btn-primary,
        #pageNumbersStudent button.active,
        #pageNumbersStudent button.btn-primary,
        .pagination-container button.active,
        .page-btn.active,
        .page-number.active,
        .page-number.btn-primary {
            background: #4361ee !important;
            background-color: #4361ee !important;
            color: #ffffff !important;
            border: none !important;
            font-weight: 700 !important;
            box-shadow: 0 4px 14px rgba(67, 97, 238, 0.4) !important;
            transform: scale(1.05) !important;
        }

        #prev:disabled, #next:disabled, #prevStudent:disabled, #nextStudent:disabled,
        .pagination-container button:disabled, button.disabled {
            background: #f1f5f9 !important;
            border-color: #e2e8f0 !important;
            color: #cbd5e1 !important;
            cursor: not-allowed !important;
            transform: none !important;
            box-shadow: none !important;
            opacity: 0.7 !important;
        }

        #pageNumbers span, #pageNumbersStudent span, .page-ellipsis {
            color: #78909c !important;
            font-weight: 600 !important;
            font-size: 1rem !important;
            padding: 0 4px !important;
        }

        /* ====== Ô CHỌN SỐ DÒNG (PAGE SIZE SELECTOR - ĐỒNG BỘ 100% VỚI NÚT PHÂN TRANG) ====== */
        .page-size-wrapper {
            display: inline-flex !important;
            align-items: center !important;
            height: 36px !important;
            background: #ffffff !important;
            border: 1.5px solid #c3dafe !important;
            border-radius: 8px !important;
            padding: 0 6px 0 10px !important;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05) !important;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
            cursor: pointer !important;
        }

        .page-size-wrapper:hover {
            background: #ebf4ff !important;
            border-color: #667eea !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.25) !important;
        }

        .page-size-label {
            font-size: 0.88rem !important;
            font-weight: 600 !important;
            color: #667eea !important;
            margin-right: 4px !important;
            white-space: nowrap !important;
            display: inline-flex !important;
            align-items: center !important;
            pointer-events: none !important;
            transition: color 0.25s ease !important;
        }

        .page-size-wrapper:hover .page-size-label {
            color: #4338ca !important;
        }

        .page-size-label i {
            color: #667eea !important;
            font-size: 0.85rem !important;
            margin-right: 4px !important;
            transition: color 0.25s ease !important;
        }

        .page-size-wrapper:hover .page-size-label i {
            color: #4338ca !important;
        }

        .page-size-select {
            height: 30px !important;
            min-width: 120px !important;
            padding: 0 22px 0 6px !important;
            border-radius: 6px !important;
            background-color: transparent !important;
            border: none !important;
            color: #667eea !important;
            font-weight: 600 !important;
            font-size: 0.88rem !important;
            cursor: pointer !important;
            outline: none !important;
            box-shadow: none !important;
            transition: all 0.2s ease !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23667eea' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 4px center !important;
            background-size: 11px 11px !important;
            appearance: none !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
        }

        .page-size-wrapper:hover .page-size-select,
        .page-size-select:focus {
            color: #4338ca !important;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%234338ca' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='m2 5 6 6 6-6'/%3e%3c/svg%3e") !important;
        }

        .page-size-select option {
            background-color: #ffffff !important;
            color: #1e293b !important;
            font-weight: 500 !important;
        }

        /* ====== ĐỒNG BỘ NÚT QUẢN LÝ EXCEL CHUẨN ĐỒNG BỘ TẤT CẢ CÁC TRANG ====== */
        .btn-excel-manager,
        #excelDropdownDot,
        #excelDropdownSusces,
        #excelDropdownAccount,
        #excelDropdownStudent {
            background: #00a65a !important;
            background-color: #00a65a !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 10px !important;
            padding: 7px 16px !important;
            font-size: 0.88rem !important;
            font-weight: 600 !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            box-shadow: 0 3px 8px rgba(0, 166, 90, 0.25) !important;
            transition: all 0.25s ease !important;
            cursor: pointer !important;
            text-decoration: none !important;
        }

        .btn-excel-manager:hover,
        #excelDropdownDot:hover,
        #excelDropdownSusces:hover,
        #excelDropdownAccount:hover,
        #excelDropdownStudent:hover {
            background: #008d4c !important;
            background-color: #008d4c !important;
            color: #ffffff !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 5px 14px rgba(0, 166, 90, 0.35) !important;
        }

        .btn-excel-manager:active,
        #excelDropdownDot:active,
        #excelDropdownSusces:active,
        #excelDropdownAccount:active,
        #excelDropdownStudent:active {
            transform: translateY(0) !important;
            box-shadow: 0 2px 5px rgba(0, 166, 90, 0.2) !important;
        }

        .btn-excel-manager i,
        #excelDropdownDot i,
        #excelDropdownSusces i,
        #excelDropdownAccount i,
        #excelDropdownStudent i {
            font-size: 0.95rem !important;
            color: #ffffff !important;
        }

        .btn-excel-manager.dropdown-toggle::after,
        #excelDropdownDot.dropdown-toggle::after,
        #excelDropdownSusces.dropdown-toggle::after,
        #excelDropdownAccount.dropdown-toggle::after,
        #excelDropdownStudent.dropdown-toggle::after {
            color: #ffffff !important;
            vertical-align: middle !important;
            margin-left: 6px !important;
        }

        /* ====== ĐẢM BẢO DROPDOWN EXCEL VÀ MENU LUÔN NỔI TRÊN BẢNG VÀ NÚT TÁC VỤ ====== */
        .toolbar,
        nav.toolbar {
            position: relative !important;
            z-index: 20 !important;
        }

        .toolbar .dropdown {
            position: relative !important;
            z-index: 25 !important;
        }

        .toolbar .dropdown-menu,
        .dropdown-menu {
            z-index: 1000 !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18) !important;
        }

        .modal-backdrop {
            z-index: 1050 !important;
        }

        .modal {
            z-index: 1060 !important;
        }

        /* ====== CHECKBOX TRONG BẢNG ====== */
        .table .form-check-input {
            width: 18px !important;
            height: 18px !important;
            cursor: pointer !important;
            margin: 0 auto !important;
            border-radius: 4px !important;
            border: 1.8px solid #94a3b8 !important;
            transition: all 0.2s ease !important;
            display: block !important;
        }

        .table thead .form-check-input {
            border-color: #ffffff !important;
        }

        .table .form-check-input:checked {
            background-color: #0029c8d9 !important;
            border-color: #0029c8d9 !important;
        }

        /* ====== STYLE TOAST HIỆN ĐẠI ====== */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 2000;
        }

        .toast {
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            font-weight: 500;
            margin-bottom: 15px;
            overflow: hidden;
            border: none;
            min-width: 320px;
            position: relative;
            transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            opacity: 0;
            transform: translateX(400px) scale(0.8);
        }

            .toast.show {
                opacity: 1;
                transform: translateX(0) scale(1);
            }

            .toast.hiding {
                opacity: 0;
                transform: translateX(400px) scale(0.8);
            }

            .toast:hover {
                transform: translateY(-3px) scale(1.02);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
            }

        /* Màu sắc cho các loại thông báo */
        .toast-success {
            background: linear-gradient(135deg, #4CAF50, #45a049);
        }

        .toast-warning {
            background: linear-gradient(135deg, #ff9800, #e68900);
        }

        .toast-error {
            background: linear-gradient(135deg, #f44336, #d32f2f);
        }

        .toast-info {
            background: linear-gradient(135deg, #2196F3, #0b7dda);
        }

        .toast-body {
            padding: 15px 20px;
            display: flex;
            align-items: center;
            color: white;
        }

        .toast-icon {
            font-size: 1.5rem;
            margin-right: 12px;
            width: 30px;
            text-align: center;
        }

        .toast-content {
            flex: 1;
            font-size: 14px;
            line-height: 1.4;
        }

        .toast-close {
            background: none;
            border: none;
            color: white;
            opacity: 0.8;
            cursor: pointer;
            padding: 5px;
            margin-left: 10px;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

            .toast-close:hover {
                background: rgba(255, 255, 255, 0.2);
                opacity: 1;
                transform: rotate(90deg);
            }

        /* Thanh tiến trình với transition */
        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 4px;
            background: rgba(255, 255, 255, 0.7);
            width: 100%;
            transform-origin: left;
            transition: transform 3s linear;
        }

            .toast-progress.running {
                transform: scaleX(0);
            }

        /* ====== ANIMATION GBA STYLE CHO NÚT DANH SÁCH XÓA ====== */
        .gba-deleted-btn {
            background: linear-gradient(135deg, #8bac0f 0%, #9bbc0f 100%) !important;
            border: 2px solid #306230 !important;
            color: #0f380f !important;
            font-weight: bold;
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
            animation: gbaGlow 2s infinite alternate;
            border-radius: 8px !important;
            padding: 6px 12px !important;
        }

            .gba-deleted-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
                transition: left 0.5s ease;
            }

            .gba-deleted-btn:hover::before {
                left: 100%;
            }

            .gba-deleted-btn:hover {
                animation: gbaPulse 0.6s ease, gbaGlow 1s infinite alternate;
                transform: translateY(-2px);
                box-shadow: 0 6px 12px rgba(15, 56, 15, 0.4);
                border-color: #0f380f !important;
            }

            .gba-deleted-btn:active {
                animation: gbaPress 0.2s ease;
                transform: translateY(1px);
            }

                /* Hiệu ứng pixelated click */
                .gba-deleted-btn:active::after {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: rgba(15, 56, 15, 0.3);
                    animation: pixelFlash 0.3s ease;
                }

        /* Animation glow GBA */
        @@keyframes gbaGlow {
            0% {
                box-shadow: 0 4px 8px rgba(139, 172, 15, 0.3);
            }

            100% {
                box-shadow: 0 4px 16px rgba(139, 172, 15, 0.6), 0 0 8px rgba(155, 188, 15, 0.4);
            }
        }

        /* Animation pulse khi hover */
        @@keyframes gbaPulse {
            0% {
                transform: scale(1) translateY(0);
            }

            50% {
                transform: scale(1.05) translateY(-3px);
            }

            100% {
                transform: scale(1) translateY(-2px);
            }
        }

        /* Animation khi nhấn */
        @@keyframes gbaPress {
            0% {
                transform: scale(1) translateY(-2px);
            }

            50% {
                transform: scale(0.95) translateY(0);
            }

            100% {
                transform: scale(1) translateY(1px);
            }
        }

        /* Hiệu ứng flash pixel */
        @@keyframes pixelFlash {
            0% {
                opacity: 0.5;
            }

            100% {
                opacity: 0;
            }
        }

        /* Hiệu ứng scanline (giống màn hình GBA) */
        .gba-deleted-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
            animation: scanline 3s linear infinite;
            opacity: 0;
        }

        .gba-deleted-btn:hover::after {
            opacity: 1;
        }

        @@keyframes scanline {
            0% {
                transform: translateY(-100%);
            }

            100% {
                transform: translateY(400%);
            }
        }

        /* Nút đăng xuất chính */
        .timkiem {
            padding: 8px 20px;
            border-radius: 20px;
            background-image: linear-gradient(315deg, #4b6cb7 0%, #182848 74%);
            color: white;
            font-weight: 600;
            box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.15);
            border: none;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .timkiem:hover {
            background-image: linear-gradient(315deg, #5f80d2 0%, #233464 74%);
            transform: scale(1.03);
            color: white;
        }

        .timkiem:active {
            transform: translateY(0);
        }

        /* Animation cho modal */
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideDown {
            from {
                transform: translateY(-50px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* ====== OVERLAY LOADING ĐĂNG XUẤT ====== */
        .logout-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: rgba(0, 0, 0, 0.8) !important;
            display: none !important;
            justify-content: center !important;
            align-items: center !important;
            z-index: 99999 !important;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .logout-overlay.active {
            display: flex !important;
            opacity: 1 !important;
            visibility: visible !important;
        }

        .logout-card {
            background: white;
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            max-width: 400px;
            width: 90%;
            transform: scale(0.7);
            transition: transform 0.3s ease;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .logout-overlay.active .logout-card {
            transform: scale(1);
        }

        .logout-icon {
            font-size: 64px;
            color: #dc3545;
            margin-bottom: 20px;
            animation: bounce 0.6s ease;
        }

        .logout-text {
            font-size: 18px;
            color: #333;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .logout-countdown {
            font-size: 14px;
            color: #666;
            margin-top: 15px;
        }

        .countdown-number {
            font-weight: bold;
            color: #dc3545;
        }

        .logout-progress-bar {
            height: 4px;
            background: #e9ecef;
            border-radius: 2px;
            margin-top: 15px;
            overflow: hidden;
        }

        .logout-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #dc3545, #c82333);
            width: 0%;
            transition: width 2s linear;
        }

        .logout-overlay.active .logout-progress-fill {
            width: 100%;
        }

        .btn-skip-logout {
            border: 1.5px solid #dc3545 !important;
            color: #dc3545 !important;
            background: transparent !important;
            border-radius: 8px !important;
            padding: 5px 18px !important;
            font-size: 0.85rem !important;
            font-weight: 600 !important;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
            cursor: pointer !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
        }

        .btn-skip-logout:hover {
            background: #dc3545 !important;
            color: #ffffff !important;
            transform: translateY(-2px) !important;
            box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3) !important;
        }

        @@keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-10px);
            }

            60% {
                transform: translateY(-5px);
            }
        }

        /* Phân quyền Cán bộ quản lý: Ẩn toàn bộ nút xóa, nút bulk delete, và nút xem danh sách đã xóa */
        body.role-manager .btn-delete,
        body.role-manager .btn-delete-student,
        body.role-manager .btn-delete-selected,
        body.role-manager #btnViewDeleted,
        body.role-manager #btnDeleteSelected,
        body.role-manager #btnDeleteSelectedDot,
        body.role-manager #btnDeleteSelectedStudent,
        body.role-manager #btnDeleteSelectedAccount,
        body.role-manager #btnDeleteSelectedDuyet {
            display: none !important;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>

@{
    var vaiTroId = Session["VaiTroId"] as int?;
    var roleName = Session["Role"]?.ToString() ?? "ADMIN";
    var displayName = (vaiTroId == 2) ? "QUẢN LÝ" : "ADMIN";
}

<body class="@(vaiTroId == 2 ? "role-manager" : "role-admin")">
    <!-- Overlay loading đăng xuất -->
    <div class="logout-overlay" id="logoutOverlay" style="display: none;">
        <div class="logout-card">
            <div class="logout-icon">
                <i class="fas fa-sign-out-alt"></i>
            </div>
            <div class="logout-text">Đang đăng xuất...</div>
            <p class="logout-countdown">Chuyển hướng sau <span class="countdown-number" id="logoutCountdown">3</span> giây</p>
            <div class="logout-progress-bar">
                <div class="logout-progress-fill" id="logoutProgressFill"></div>
            </div>
            <div class="mt-3 pt-1">
                <button type="button" class="btn-skip-logout" id="btnSkipLogout" onclick="skipLogoutCountdown()">
                    <i class="fas fa-forward"></i> Bỏ qua
                </button>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <!-- Sidebar -->
        <aside class="shadow m-4 rounded-5 pb-4" style="width: 290px; min-height: 95vh;">
            <div class="p-3">
                <a class="navbar-brand d-flex align-items-center" href="#" style="overflow: hidden; max-width: 100%;">
                    <span class="ms-1 fw-bold grayColor" style="font-size: 0.96rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: 0.2px;" title="XIN CHÀO, @displayName">👋 XIN CHÀO, @displayName</span>
                </a>
            </div>
            <hr class="hr">

            <ul class="nav flex-column">
                <li class="nav-item">
                    <a href="@Url.Action("Index","Admin",new{area="Admin"})" class="nav-link">
                        <i class="fas fa-home me-1"></i>Trang Chủ
                    </a>
                </li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item"><a href="@Url.Action("Index","Account",new{area="Admin"})" class="nav-link"><i class="fa fa-list-alt"></i>Tài Khoản</a></li>
                }
                <li class="nav-item"><a href="@Url.Action("Index","AdminWordRegister",new{area="Admin"})" class="nav-link"><i class="fa fa-calendar-plus"></i>Tạo Đợt LĐ</a></li>
                <li class="nav-item"><a href="@Url.Action("Index","AdminSuscesWord",new{area="Admin"})" class="nav-link"><i class="fa fa-clipboard-check"></i>Xác Nhận Hoàn Thành</a></li>
                <li class="nav-item"><a href="@Url.Action("Index","AdminStudent",new{area="Admin"})" class="nav-link"><i class="fa fa-users"></i>Danh Sách SV</a></li>
                <li class="nav-item"><a href="@Url.Action("Index","AdminTK",new{area="Admin"})" class="nav-link"><i class="fa fa-chart-bar"></i>Thống Kê</a></li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item"><a href="@Url.Action("Index","AdminAuditLog",new{area="Admin"})" class="nav-link"><i class="fa fa-history"></i>Nhật Ký Xóa</a></li>
                }
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="main-content flex-grow-1 position-relative border-radius-lg" style="width: calc(100% - 280px);">
            <nav class="navbar navbar-main navbar-expand-lg header-navbar shadow-sm mb-3">
                <div class="container-fluid d-flex justify-content-between align-items-center p-0">
                    <a href="@Url.Action("Index","Admin",new{area="Admin"})" class="d-flex align-items-center text-decoration-none">
                        <img src="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh@main/admin/Logodaxoanen.png" alt="Logo" class="logo">
                    </a>

                    <div class="d-flex align-items-center ms-auto">
                        <button class="timkiem" onclick="openModal()">
                            <i class="fa fa-sign-out me-1"></i> Đăng xuất
                        </button>
                    </div>
                </div>
            </nav>

            <div class="container-fluid">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- MODAL XÁC NHẬN ĐĂNG XUẤT -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
                <div class="modal-header bg-danger text-white py-3 px-4">
                    <h5 class="modal-title fw-bold fs-5" id="confirmationModalLabel">
                        <i class="fas fa-sign-out-alt me-2"></i> Xác nhận đăng xuất
                    </h5>
                    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body text-center py-4 px-4 bg-white">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 68px; height: 68px; font-size: 1.8rem;">
                            <i class="fas fa-power-off"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Bạn có chắc chắn muốn đăng xuất?</h5>
                    <p class="text-muted small mb-0">Phiên làm việc hiện tại sẽ kết thúc và bạn sẽ được chuyển về trang đăng nhập.</p>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal" style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-times me-1"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn btn-danger px-4 py-2" onclick="confirmLogout()" style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL XÁC NHẬN XÓA TẤT CẢ / XÓA NHIỀU MỤC ĐÃ CHỌN DÙNG CHUNG -->
    <div class="modal fade" id="bulkDeleteConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i> Xác nhận xóa các mục đã chọn
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4 px-4">
                    <div class="text-danger mb-3">
                        <i class="fas fa-trash-alt fa-3x animate-bounce"></i>
                    </div>
                    <h5 class="fw-bold mb-2 text-dark" id="bulkDeleteConfirmTitle">Bạn có chắc chắn muốn xóa?</h5>
                    <p class="text-muted mb-3" id="bulkDeleteConfirmMessage">
                        Hành động này sẽ xóa tất cả <strong class="text-danger" id="bulkDeleteCountText">0</strong> mục mà bạn vừa chọn.
                    </p>
                    <div class="alert alert-warning py-2 px-3 small d-inline-block text-start mb-0" style="border-radius: 8px;">
                        <i class="fas fa-info-circle me-1"></i> <strong>Cảnh báo:</strong> Dữ liệu đã chọn sẽ được đưa vào danh sách đã xóa hoặc xóa hoàn toàn. Bạn có chắc chắn muốn tiếp tục không?
                    </div>
                </div>
                <div class="modal-footer justify-content-center bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: 6px;">
                        <i class="fas fa-times me-1"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn btn-danger px-4" id="btnConfirmBulkDeleteAction" style="border-radius: 6px;">
                        <i class="fas fa-trash-alt me-1"></i> Xác nhận xóa tất cả (<span id="bulkDeleteCountConfirm">0</span>)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BONG BÓNG THÔNG BÁO DÙNG CHUNG -->
    <div id="toastContainer" class="toast-container"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ===== XỬ LÝ MODAL ĐĂNG XUẤT =====
            window.openModal = function () {
                const modalEl = document.getElementById('confirmationModal');
                if (modalEl) {
                    const bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.show();
                }
            }

            window.closeModal = function () {
                const modalEl = document.getElementById('confirmationModal');
                if (modalEl) {
                    const bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) bsModal.hide();
                }
            }

            // ===== XỬ LÝ ĐĂNG XUẤT =====
            let logoutCountdownInterval = null;

            window.confirmLogout = function () {
                closeModal();
                showLogoutOverlay();
            }

            window.skipLogoutCountdown = function () {
                if (logoutCountdownInterval) {
                    clearInterval(logoutCountdownInterval);
                    logoutCountdownInterval = null;
                }
                window.location.href = '@Url.Action("Login", "Login", new { area = "" })';
            }

            // ===== HIỆU ỨNG LOADING ĐĂNG XUẤT =====
            function showLogoutOverlay() {
                const overlay = document.getElementById('logoutOverlay');
                const countdownElement = document.getElementById('logoutCountdown');
                const progressFill = document.getElementById('logoutProgressFill');

                if (!overlay) return;

                // Hiển thị overlay
                overlay.style.display = 'flex';
                setTimeout(() => {
                    overlay.classList.add('active');
                }, 10);

                let countdown = 3;
                if (countdownElement) countdownElement.textContent = countdown;

                if (logoutCountdownInterval) {
                    clearInterval(logoutCountdownInterval);
                }

                // Cập nhật countdown mỗi giây
                logoutCountdownInterval = setInterval(() => {
                    countdown--;
                    if (countdownElement) countdownElement.textContent = countdown;

                    if (countdown <= 0) {
                        clearInterval(logoutCountdownInterval);
                        logoutCountdownInterval = null;
                        // Chuyển hướng đến trang login
                        window.location.href = '@Url.Action("Login", "Login", new { area = "" })';
                    }
                }, 1000);
            }

            // ===== HIGHLIGHT MENU =====
            const navLinks = document.querySelectorAll(".nav-link");
            const sidebar = document.querySelector("aside");
            const highlight = document.createElement("div");
            highlight.classList.add("sidebar-highlight");
            sidebar.appendChild(highlight);

            const currentPath = window.location.pathname.toLowerCase();
            let currentActive = null;

            navLinks.forEach(link => {
                const linkPath = new URL(link.href).pathname.toLowerCase();
                if (currentPath === linkPath) {
                    link.classList.add("active");
                    currentActive = link;
                }
            });

            if (!currentActive) {
                navLinks.forEach(link => {
                    const linkPath = new URL(link.href).pathname.toLowerCase();
                    if (currentPath.includes(linkPath)) {
                        link.classList.add("active");
                        currentActive = link;
                    }
                });
            }

            function moveHighlight(activeLink) {
                if (!activeLink) return;
                const rect = activeLink.getBoundingClientRect();
                highlight.style.top = (activeLink.offsetTop + 6) + "px";
                highlight.style.height = rect.height + "px";
            }

            moveHighlight(currentActive);

            // ===== HIỆU ỨNG GBA CHO NÚT DANH SÁCH XÓA =====
            const deletedListBtn = document.getElementById('btnDeletedList');
            if (deletedListBtn) {
                deletedListBtn.addEventListener('click', function() {
                    // Thêm hiệu ứng visual feedback
                    this.style.animation = 'gbaPress 0.3s ease';
                    setTimeout(() => {
                        this.style.animation = 'gbaGlow 2s infinite alternate';
                    }, 300);
                });
            }

            // ===== PHÂN TRANG (nếu có bảng dữ liệu) =====
            const body = document.querySelector("#accountTableBody");
            if (body) {
                const totalItems = body.querySelectorAll("tr").length;
                const itemsPerPage = 5;
                let currentPage = 1;
                const totalPages = Math.ceil(totalItems / itemsPerPage);

                function renderTable() {
                    const rows = body.querySelectorAll("tr");
                    rows.forEach((row, index) => {
                        row.style.display = (index >= (currentPage - 1) * itemsPerPage && index < currentPage * itemsPerPage) ? "" : "none";
                    });
                }

                function renderPagination() {
                    const pageNumbers = document.getElementById("pageNumbers");
                    if (!pageNumbers) return;
                    pageNumbers.innerHTML = "";

                    for (let i = 1; i <= totalPages; i++) {
                        const btn = document.createElement("button");
                        btn.textContent = i;
                        btn.className = "btn btn-sm " + (i === currentPage ? "btn-primary active" : "btn-outline-secondary");
                        btn.addEventListener("click", () => {
                            currentPage = i;
                            updateDisplay();
                        });
                        pageNumbers.appendChild(btn);
                    }

                    const pageInfo = document.getElementById("pageInfo");
                    if (pageInfo)
                        pageInfo.textContent = `Trang ${currentPage} / ${totalPages}`;
                }

                function updateDisplay() {
                    renderTable();
                    renderPagination();
                }

                const prev = document.getElementById("prev");
                const next = document.getElementById("next");

                if (prev) prev.addEventListener("click", () => {
                    if (currentPage > 1) {
                        currentPage--;
                        updateDisplay();
                    }
                });

                if (next) next.addEventListener("click", () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        updateDisplay();
                    }
                });

                updateDisplay();
            }

            // ===== HIỂN THỊ TOAST TỰ ĐỘNG NẾU CÓ TEMP DATA =====
            const msg = '@TempData["Message"]';
            const type = '@TempData["MessageType"]';
            if (msg && msg.trim() !== "") {
                showToast(msg, type || "success");
            }
        });

        // ===== HÀM HIỂN THỊ BONG BÓNG THÔNG BÁO HIỆN ĐẠI =====
        function showToast(message, type = 'success') {
            const toastContainer = document.getElementById('toastContainer');

            // Tạo toast element
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            // Xác định icon theo loại thông báo
            let icon = 'fa-check-circle';
            switch(type) {
                case 'warning':
                    icon = 'fa-exclamation-triangle';
                    break;
                case 'error':
                    icon = 'fa-times-circle';
                    break;
                case 'info':
                    icon = 'fa-info-circle';
                    break;
                default:
                    icon = 'fa-check-circle';
            }

            // Tạo nội dung toast
            toast.innerHTML = `
                <div class="toast-body">
                    <div class="toast-icon">
                        <i class="fas ${icon}"></i>
                    </div>
                    <div class="toast-content">
                        ${message}
                    </div>
                    <button type="button" class="toast-close" onclick="removeToast(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="toast-progress"></div>
            `;

            // Thêm toast vào container
            toastContainer.appendChild(toast);

            // Hiệu ứng xuất hiện
            setTimeout(() => {
                toast.classList.add('show');

                // Bắt đầu thanh tiến trình
                const progress = toast.querySelector('.toast-progress');
                setTimeout(() => {
                    progress.classList.add('running');
                }, 50);
            }, 10);

            // Tự động xóa toast sau 5 giây
            setTimeout(() => {
                removeToastElement(toast);
            }, 5000);
        }

        // Hàm xóa toast khi click nút đóng
        function removeToast(button) {
            const toast = button.closest('.toast');
            removeToastElement(toast);
        }

        // Hàm xóa toast với hiệu ứng
        function removeToastElement(toast) {
            if (!toast || toast.classList.contains('hiding')) return;

            toast.classList.remove('show');
            toast.classList.add('hiding');

            setTimeout(() => {
                if (toast.parentElement) {
                    toast.remove();
                }
            }, 500);
        }

        // Biến toàn cục xác định vai trò người dùng hiện tại
        window.currentUserRoleId = @(vaiTroId.HasValue ? vaiTroId.Value : 1);
        window.isAdmin = @((vaiTroId == 1 || vaiTroId == null) ? "true" : "false");
        window.isManager = @(vaiTroId == 2 ? "true" : "false");
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>