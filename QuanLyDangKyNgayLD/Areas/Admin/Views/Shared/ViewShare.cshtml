        /* --- Modal Cao Cấp & Trực Quan --- */
        .modal-content {
            border: none !important;
            border-radius: 16px !important;
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.22), 0 4px 12px rgba(0, 0, 0, 0.08) !important;
            overflow: hidden;
            background: #ffffff;
        }

        .modal-header {
            padding: 16px 24px !important;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-primary,
        .modal-header.bg-gradient {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 60%, #3b82f6 100%) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-success {
            background: linear-gradient(135deg, #065f46 0%, #059669 60%, #10b981 100%) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-danger,
        .modal-header.bg-gradient-danger {
            background: linear-gradient(135deg, #991b1b 0%, #dc2626 60%, #ef4444 100%) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-warning {
            background: linear-gradient(135deg, #b45309 0%, #d97706 60%, #f59e0b 100%) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-info {
            background: linear-gradient(135deg, #0369a1 0%, #0284c7 60%, #38bdf8 100%) !important;
            color: #ffffff !important;
        }

        .modal-header.bg-secondary {
            background: linear-gradient(135deg, #334155 0%, #475569 60%, #64748b 100%) !important;
            color: #ffffff !important;
        }

        .modal-header .modal-title,
        .modal-header h5,
        .modal-header h6 {
            font-size: 1.1rem !important;
            font-weight: 700 !important;
            color: #ffffff !important;
            letter-spacing: 0.2px;
            display: flex;
            align-items: center;
            margin: 0;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
        }

        .modal-header .modal-title i,
        .modal-header h5 i,
        .modal-header h6 i {
            color: #ffffff !important;
        }

        .modal-header .btn-close,
        .modal-header .btn-close-white {
            filter: brightness(0) invert(1) !important;
            opacity: 0.85 !important;
            transition: all 0.2s ease;
            padding: 8px !important;
            margin: -4px -4px -4px auto !important;
            border-radius: 8px;
        }

        .modal-header .btn-close:hover,
        .modal-header .btn-close-white:hover {
            opacity: 1 !important;
            transform: scale(1.08);
            background-color: rgba(255, 255, 255, 0.2) !important;
        }

        .modal-body {
            padding: 22px 24px !important;
            background: #f8fafc;
            color: var(--text-primary);
        }

        .modal .form-label {
            margin-bottom: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #334155;
            display: flex;
            align-items: center;
        }

        .modal .form-label i {
            margin-right: 6px;
            font-size: 0.9rem;
        }

        .modal .form-control,
        .modal .form-select {
            border: 1.5px solid #cbd5e1 !important;
            border-radius: 8px !important;
            background-color: #ffffff !important;
            padding: 9px 13px !important;
            font-size: 0.9rem !important;
            color: #1e293b !important;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
        }

        .modal .form-control:focus,
        .modal .form-select:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
            outline: none;
            background-color: #ffffff !important;
        }

        .modal-footer {
            padding: 14px 24px !important;
            border-top: 1px solid #e2e8f0 !important;
            background: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        .modal-footer .btn-secondary,
        .modal-footer [data-bs-dismiss="modal"] {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #cbd5e1;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 18px;
            transition: all 0.2s;
        }

        .modal-footer .btn-secondary:hover,
        .modal-footer [data-bs-dismiss="modal"]:hover {
            background: #e2e8f0;
            color: #0f172a;
            border-color: #94a3b8;
        }

        .modal-footer .btn-primary {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%) !important;
            border: none !important;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25) !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 22px;
            color: #ffffff !important;
            transition: all 0.2s;
        }

        .modal-footer .btn-primary:hover {
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35) !important;
            transform: translateY(-1px);
        }

        .modal-footer .btn-success {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
            border: none !important;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25) !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 22px;
            color: #ffffff !important;
            transition: all 0.2s;
        }

        .modal-footer .btn-success:hover {
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.35) !important;
            transform: translateY(-1px);
        }

        .modal-footer .btn-danger {
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%) !important;
            border: none !important;
            box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25) !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 22px;
            color: #ffffff !important;
            transition: all 0.2s;
        }

        .modal-footer .btn-danger:hover {
            box-shadow: 0 6px 16px rgba(220, 38, 38, 0.35) !important;
            transform: translateY(-1px);
        }

        .modal-footer .btn-warning {
            background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%) !important;
            color: #ffffff !important;
            border: none !important;
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25) !important;
            font-weight: 600;
            border-radius: 8px;
            padding: 9px 22px;
            transition: all 0.2s;
        }

        .modal-footer .btn-warning:hover {
            box-shadow: 0 6px 16px rgba(217, 119, 6, 0.35) !important;
            transform: translateY(-1px);
        }

        /* --- Thống kê AdminTK --- */
        .tk-dashboard-wrapper {
            padding: 0 0 24px !important;
        }

        .tk-filter-card,
        .tk-progress-card,
        .tk-table-card {
            background: var(--bg-surface) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: var(--radius-md) !important;
            box-shadow: var(--shadow-sm) !important;
        }

        .tk-filter-card {
            padding: 16px 18px !important;
            margin-bottom: 16px !important;
        }

        #stats-bar {
            margin-right: 0 !important;
            margin-left: 0 !important;
        }

        .tk-filter-label {
            margin-bottom: 6px !important;
            color: var(--text-secondary) !important;
            font-size: 0.76rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.01em !important;
            text-transform: none !important;
        }

        .tk-form-select,
        .tk-form-input {
            height: 40px !important;
            padding: 0 12px !important;
            border: 1px solid var(--border-color) !important;
            border-radius: var(--radius-sm) !important;
            background-color: #ffffff !important;
            color: var(--text-primary) !important;
            font-size: 0.84rem !important;
        }

        .tk-form-select:focus,
        .tk-form-input:focus {
            border-color: var(--accent-blue) !important;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
        }

        .tk-kpi-card {
            padding: 18px 20px !important;
            background: var(--bg-surface) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: var(--radius-md) !important;
            box-shadow: var(--shadow-sm) !important;
            color: var(--text-primary) !important;
        }

        .tk-kpi-card:hover {
            transform: none !important;
            box-shadow: var(--shadow-md) !important;
        }

        .tk-kpi-title {
            color: var(--text-secondary) !important;
            font-size: 0.75rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.05em !important;
            text-transform: uppercase;
        }

        .tk-kpi-icon-wrapper {
            width: 38px !important;
            height: 38px !important;
            border: 1px solid var(--tk-border, var(--border-color)) !important;
            border-radius: 10px !important;
            background: var(--tk-tint, var(--bg-body)) !important;
            color: var(--tk-accent, var(--accent-blue)) !important;
            font-size: 0.95rem !important;
            backdrop-filter: none !important;
        }

        .tk-kpi-total { --tk-accent: #2563eb; --tk-tint: #eff6ff; --tk-border: #bfdbfe; }
        .tk-kpi-completed { --tk-accent: #059669; --tk-tint: #ecfdf5; --tk-border: #a7f3d0; }
        .tk-kpi-incomplete { --tk-accent: #d97706; --tk-tint: #fffbeb; --tk-border: #fde68a; }

        .tk-kpi-value {
            margin-bottom: 8px !important;
            color: var(--text-primary) !important;
            font-size: 1.9rem !important;
            font-weight: 800 !important;
            letter-spacing: -0.04em !important;
        }

        .tk-kpi-footer {
            color: var(--text-secondary) !important;
            font-size: 0.76rem !important;
        }

        .tk-kpi-badge {
            padding: 3px 8px !important;
            background: var(--bg-body) !important;
            border: 1px solid var(--border-color);
            border-radius: 6px !important;
            color: var(--text-secondary) !important;
            font-size: 0.7rem !important;
            font-weight: 700 !important;
            backdrop-filter: none !important;
        }

        .tk-progress-card {
            padding: 18px 20px !important;
            margin-bottom: 16px !important;
        }

        .tk-progress-title {
            color: var(--text-primary) !important;
            font-size: 0.95rem !important;
        }

        .tk-progress-percent {
            color: var(--text-primary) !important;
            font-size: 1.1rem !important;
            font-weight: 800 !important;
        }

        .tk-progress-track {
            height: 10px !important;
            background: #e2e8f0 !important;
            border-radius: 999px !important;
            box-shadow: none !important;
        }

        .tk-progress-fill {
            background: var(--primary-color) !important;
            background-image: none !important;
            border-radius: 999px !important;
            animation: none !important;
        }

        .tk-progress-meta {
            margin-top: 10px !important;
            color: var(--text-secondary) !important;
            font-size: 0.78rem !important;
        }

        .tk-table-card {
            margin-bottom: 0 !important;
        }

        .tk-table-toolbar {
            padding: 15px 20px !important;
            background: #ffffff !important;
            border-bottom: 1px solid var(--border-subtle) !important;
        }

        .tk-table-toolbar-title {
            color: var(--text-primary) !important;
            font-size: 0.95rem !important;
        }

        .tk-table thead th {
            padding: 12px 14px !important;
            background: #f8fafc !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: #475569 !important;
            font-size: 0.71rem !important;
            letter-spacing: 0.05em !important;
        }

        .tk-table tbody td {
            padding: 13px 14px !important;
            border-bottom: 1px solid var(--border-subtle) !important;
            color: var(--text-primary) !important;
            font-size: 0.84rem !important;
        }

        .tk-page-btn {
            border-radius: var(--radius-sm) !important;
        }

        .btn-tk-export,
        .btn-tk-email {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 14px;
            border-radius: var(--radius-sm);
            font-size: 0.82rem;
            font-weight: 700;
            box-shadow: none;
            transform: none;
        }

        .btn-tk-export {
            border: 1px solid var(--border-color) !important;
            background: #ffffff !important;
            color: var(--text-primary) !important;
            box-shadow: none !important;
        }

        .btn-tk-export:hover {
            border-color: #cbd5e1 !important;
            background: var(--bg-body) !important;
            color: var(--text-primary) !important;
            transform: none !important;
        }

        .btn-tk-email {
            border: 1px solid var(--primary-color) !important;
            background: var(--primary-color) !important;
            color: #ffffff !important;
            box-shadow: none !important;
        }

        .btn-tk-email:hover {
            border-color: var(--primary-hover) !important;
            background: var(--primary-hover) !important;
            color: #ffffff !important;
            transform: none !important;
        }

        /* --- Overlay & responsive --- */
        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1070;
            background: rgba(15, 23, 42, 0.42);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        @@media (max-width: 1199.98px) {
            .admin-kpi-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .admin-dashboard-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }

        @@media (max-width: 991.98px) {
            .sidebar-overlay {
                display: block;
            }

            body.sidebar-mobile-open .sidebar-overlay {
                opacity: 1;
                pointer-events: auto;
            }

            aside,
            body.sidebar-collapsed aside,
            html.sidebar-collapsed-preload body aside {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: min(280px, calc(100vw - 48px)) !important;
                height: 100dvh !important;
                max-height: 100dvh !important;
                margin: 0 !important;
                border: 0 !important;
                border-right: 1px solid var(--border-color) !important;
                border-radius: 0 16px 16px 0 !important;
                box-shadow: var(--shadow-lg) !important;
                transform: translateX(-105%) !important;
                transition: transform 0.24s ease !important;
                z-index: 1080 !important;
                overflow-y: auto !important;
            }

            body.sidebar-mobile-open aside,
            body.sidebar-mobile-open.sidebar-collapsed aside {
                transform: translateX(0) !important;
            }

            body.sidebar-collapsed .sidebar-brand-box,
            html.sidebar-collapsed-preload body .sidebar-brand-box {
                padding: 16px 14px 14px !important;
                justify-content: flex-start !important;
            }

            body.sidebar-collapsed .user-avatar-badge,
            html.sidebar-collapsed-preload body .user-avatar-badge {
                margin: 0 !important;
            }

            body.sidebar-collapsed .user-info-text,
            html.sidebar-collapsed-preload body .user-info-text {
                display: block !important;
            }

            body.sidebar-collapsed .sidebar-toggle-btn,
            html.sidebar-collapsed-preload body .sidebar-toggle-btn {
                display: flex !important;
            }

            body.sidebar-collapsed .sidebar-nav,
            html.sidebar-collapsed-preload body .sidebar-nav {
                padding: 0 10px !important;
            }

            body.sidebar-collapsed aside .nav-link,
            html.sidebar-collapsed-preload body aside .nav-link {
                justify-content: flex-start !important;
                padding: 10px 14px !important;
                gap: 12px !important;
            }

            body.sidebar-collapsed aside .nav-link i,
            html.sidebar-collapsed-preload body aside .nav-link i {
                margin: 0 !important;
                font-size: 0.98rem !important;
            }

            body.sidebar-collapsed aside .nav-link span,
            html.sidebar-collapsed-preload body aside .nav-link span {
                display: inline !important;
            }

            body.sidebar-collapsed .sidebar-footer,
            html.sidebar-collapsed-preload body .sidebar-footer {
                padding: 10px 10px 0 !important;
            }

            body.sidebar-collapsed .sidebar-collapse-text,
            html.sidebar-collapsed-preload body .sidebar-collapse-text {
                display: inline !important;
            }

            main.main-content,
            body.sidebar-collapsed main.main-content,
            html.sidebar-collapsed-preload body main.main-content {
                width: 100% !important;
                margin: 0 !important;
                padding: 14px 14px 28px !important;
            }

            main.main-content > .container-fluid {
                padding: 0 !important;
            }

            .btn-sidebar-trigger {
                display: inline-flex !important;
            }

            .header-navbar,
            nav.navbar-main,
            .navbar.navbar-main {
                margin-bottom: 14px !important;
                padding: 8px 12px !important;
                border-radius: var(--radius-md) !important;
            }

            .header-navbar .container-fluid {
                flex-wrap: nowrap !important;
                gap: 8px !important;
            }

            .header-navbar .container-fluid > div {
                width: auto !important;
                max-width: none !important;
            }

            .header-navbar .container-fluid > div:first-child {
                flex: 1 1 auto !important;
                flex-wrap: nowrap !important;
                justify-content: flex-start !important;
                min-width: 0 !important;
            }

            .header-navbar .container-fluid > div:last-child {
                flex: 0 0 auto !important;
                justify-content: flex-end !important;
            }

            .header-navbar .logo,
            nav.navbar-main .logo {
                width: auto !important;
                max-width: 150px !important;
                height: 34px !important;
                max-height: 34px !important;
            }

            .header-navbar .badge {
                display: none !important;
            }

            .timkiem,
            .btn-logout-header {
                padding: 7px 11px !important;
                font-size: 0.8rem !important;
            }

            .admin-page-head {
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
                padding-bottom: 14px;
                margin-bottom: 14px;
            }

            .admin-page-head h1 {
                font-size: 1.3rem;
            }

            .admin-page-actions {
                width: 100%;
                justify-content: flex-start;
            }

            .admin-chart-body {
                height: 280px;
                padding: 14px;
            }

            .toolbar,
            .filter-bar {
                padding: 10px !important;
            }

            .toolbar .navbar-collapse,
            .toolbar .collapse {
                display: block !important;
            }

            .toolbar .navbar-nav {
                flex-wrap: wrap !important;
                margin-bottom: 8px !important;
            }

            .toolbar-flex {
                width: 100%;
                justify-content: stretch !important;
            }

            .toolbar-flex > * {
                flex: 1 1 auto;
            }

            .toolbar .input-group,
            .filter-bar .input-group,
            .toolbar-flex .input-group {
                max-width: none !important;
                width: 100% !important;
                min-width: 0 !important;
            }

            .table-responsive,
            .table-wrapper {
                min-height: 0 !important;
            }

            .pagination-container {
                flex-wrap: wrap;
                justify-content: center;
            }
        }

        @@media (max-width: 575.98px) {
            .admin-kpi-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            main.main-content,
            body.sidebar-collapsed main.main-content,
            html.sidebar-collapsed-preload body main.main-content {
                padding: 10px 10px 24px !important;
            }

            .admin-page-actions {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .admin-page-actions .btn {
                width: 100%;
            }

            .admin-page-actions .admin-date-chip {
                grid-column: 1 / -1;
                justify-content: center;
            }

            .admin-kpi,
            .admin-panel-head,
            .admin-chart-body {
                padding-left: 14px;
                padding-right: 14px;
            }

            .modal-dialog {
                margin: 10px;
            }
        }
    </style>
</head>

@{
    var vaiTroId = Session["VaiTroId"] as int?;
    var roleName = Session["Role"]?.ToString() ?? "ADMIN";
    var displayName = (vaiTroId == 2) ? "QUẢN LÝ" : "ADMIN";
}

<body class="@(vaiTroId == 2 ? "role-manager" : "role-admin")">
    <!-- Overlay loading đăng xuất -->
    <div class="logout-overlay" id="logoutOverlay" style="display: none;">
        <div class="logout-card">
            <div class="logout-icon">
                <i class="fas fa-sign-out-alt"></i>
            </div>
            <div class="logout-text">Đang đăng xuất...</div>
            <p class="logout-countdown">Chuyển hướng sau <span class="countdown-number" id="logoutCountdown">3</span> giây</p>
            <div class="logout-progress-bar">
                <div class="logout-progress-fill" id="logoutProgressFill"></div>
            </div>
            <div class="mt-3 pt-1">
                <button type="button" class="btn-skip-logout" id="btnSkipLogout" onclick="skipLogoutCountdown()">
                    <i class="fas fa-forward"></i> Bỏ qua
                </button>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <!-- Sidebar -->
        <aside id="adminSidebar">
            <div class="sidebar-brand-box">
                <div class="user-avatar-badge" title="Tài khoản @displayName - Bấm để mở rộng menu">
                    <i class="fas @(vaiTroId == 2 ? "fa-user-tie" : "fa-user-shield")"></i>
                </div>
                <div class="user-info-text">
                    <div class="user-greeting">Xin chào,</div>
                    <div class="user-role-name" title="@displayName">@displayName</div>
                </div>
                <button type="button" class="sidebar-toggle-btn" id="btnToggleSidebarHeader" title="Thu gọn menu">
                    <i class="fas fa-chevron-left" id="headerToggleIcon"></i>
                </button>
            </div>
            <hr class="sidebar-divider">

            <ul class="nav flex-column sidebar-nav">
                <li class="nav-item">
                    <a href="@Url.Action("Index","Admin",new{area="Admin"})" class="nav-link @(controller == "Admin" ? "active" : "")" data-tooltip="Trang Chủ">
                        <i class="fas fa-home"></i><span>Trang Chủ</span>
                    </a>
                </li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("Index","Account",new{area="Admin"})" class="nav-link @(controller == "Account" || controller == "AdminAccount" ? "active" : "")" data-tooltip="Tài Khoản">
                            <i class="fa fa-id-card"></i><span>Tài Khoản</span>
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a href="@Url.Action("Index","AdminWordRegister",new{area="Admin"})" class="nav-link @(controller == "AdminWordRegister" ? "active" : "")" data-tooltip="Tạo Đợt LĐ">
                        <i class="fa fa-calendar-check"></i><span>Tạo Đợt LĐ</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index","AdminSuscesWord",new{area="Admin"})" class="nav-link @(controller == "AdminSuscesWord" ? "active" : "")" data-tooltip="Xác Nhận Hoàn Thành">
                        <i class="fa fa-clipboard-check"></i><span>Xác Nhận Hoàn Thành</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index","AdminStudent",new{area="Admin"})" class="nav-link @(controller == "AdminStudent" ? "active" : "")" data-tooltip="Danh Sách SV">
                        <i class="fa fa-users"></i><span>Danh Sách SV</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="@Url.Action("Index","AdminTK",new{area="Admin"})" class="nav-link @(controller == "AdminTK" ? "active" : "")" data-tooltip="Thống Kê">
                        <i class="fa fa-chart-pie"></i><span>Thống Kê</span>
                    </a>
                </li>
                @if (vaiTroId == 1 || vaiTroId == null)
                {
                    <li class="nav-item">
                        <a href="@Url.Action("Index","AdminAuditLog",new{area="Admin"})" class="nav-link @(controller == "AdminAuditLog" ? "active" : "")" data-tooltip="Nhật Ký Xóa">
                            <i class="fa fa-history"></i><span>Nhật Ký Xóa</span>
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-footer">
                <button type="button" class="sidebar-collapse-btn-bottom" id="btnToggleSidebarBottom" title="Thu gọn / Mở rộng menu">
                    <i class="fas fa-angles-left" id="bottomToggleIcon"></i>
                    <span class="sidebar-collapse-text">Thu gọn menu</span>
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content flex-grow-1 position-relative">
            <nav class="navbar navbar-main navbar-expand-lg header-navbar">
                <div class="container-fluid d-flex justify-content-between align-items-center p-0">
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-sidebar-trigger me-1" id="btnToggleSidebarNav" title="Thu gọn / Mở rộng menu">
                            <i class="fas fa-bars"></i>
                        </button>
                        <a href="@Url.Action("Index","Admin",new{area="Admin"})" class="d-flex align-items-center text-decoration-none">
                            <img src="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh@main/admin/Logodaxoanen.png" alt="Logo" class="logo">
                        </a>
                        <span class="badge d-none d-md-inline-block ms-2" style="background-color: var(--primary-light); color: var(--primary-color); border: 1px solid var(--primary-border); font-size: 0.8rem; font-weight: 600;">
                            Hệ Thống Quản Lý Lao Động
                        </span>
                    </div>

                    <div class="d-flex align-items-center ms-auto">
                        <button type="button" class="timkiem" onclick="openModal()" title="Đăng xuất khỏi hệ thống">
                            <i class="fas fa-sign-out-alt"></i> Đăng xuất
                        </button>
                    </div>
                </div>
            </nav>

            <div class="container-fluid" id="adminMainContainer">
                @RenderBody()
            </div>
        </main>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <!-- MODAL XÁC NHẬN ĐĂNG XUẤT -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">
                <div class="modal-header bg-danger text-white py-3 px-4">
                    <h5 class="modal-title fw-bold fs-5" id="confirmationModalLabel">
                        <i class="fas fa-sign-out-alt me-2"></i> Xác nhận đăng xuất
                    </h5>
                    <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body text-center py-4 px-4 bg-white">
                    <div class="mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger" style="width: 68px; height: 68px; font-size: 1.8rem;">
                            <i class="fas fa-power-off"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Bạn có chắc chắn muốn đăng xuất?</h5>
                    <p class="text-muted small mb-0">Phiên làm việc hiện tại sẽ kết thúc và bạn sẽ được chuyển về trang đăng nhập.</p>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal" style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-times me-1"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn btn-danger px-4 py-2" onclick="confirmLogout()" style="border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-sign-out-alt me-1"></i> Đăng xuất
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL XÁC NHẬN XÓA TẤT CẢ / XÓA NHIỀU MỤC ĐÃ CHỌN DÙNG CHUNG -->
    <div class="modal fade" id="bulkDeleteConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-exclamation-triangle me-2"></i> Xác nhận xóa các mục đã chọn
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center py-4 px-4">
                    <div class="text-danger mb-3">
                        <i class="fas fa-trash-alt fa-3x animate-bounce"></i>
                    </div>
                    <h5 class="fw-bold mb-2 text-dark" id="bulkDeleteConfirmTitle">Bạn có chắc chắn muốn xóa?</h5>
                    <p class="text-muted mb-3" id="bulkDeleteConfirmMessage">
                        Hành động này sẽ xóa tất cả <strong class="text-danger" id="bulkDeleteCountText">0</strong> mục mà bạn vừa chọn.
                    </p>
                    <div class="alert alert-warning py-2 px-3 small d-inline-block text-start mb-0" style="border-radius: 8px;">
                        <i class="fas fa-info-circle me-1"></i> <strong>Cảnh báo:</strong> Dữ liệu đã chọn sẽ được đưa vào danh sách đã xóa hoặc xóa hoàn toàn. Bạn có chắc chắn muốn tiếp tục không?
                    </div>
                </div>
                <div class="modal-footer justify-content-center bg-light border-0 py-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius: 6px;">
                        <i class="fas fa-times me-1"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn btn-danger px-4" id="btnConfirmBulkDeleteAction" style="border-radius: 6px;">
                        <i class="fas fa-trash-alt me-1"></i> Xác nhận xóa tất cả (<span id="bulkDeleteCountConfirm">0</span>)
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- BONG BÓNG THÔNG BÁO DÙNG CHUNG -->
    <div id="toastContainer" class="toast-container"></div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ===== XỬ LÝ MODAL ĐĂNG XUẤT =====
            window.openModal = function () {
                const modalEl = document.getElementById('confirmationModal');
                if (modalEl) {
                    const bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.show();
                }
            }

            window.closeModal = function () {
                const modalEl = document.getElementById('confirmationModal');
                if (modalEl) {
                    const bsModal = bootstrap.Modal.getInstance(modalEl);
                    if (bsModal) bsModal.hide();
                }
            }

            // ===== XỬ LÝ ĐĂNG XUẤT =====
            let logoutCountdownInterval = null;

            window.confirmLogout = function () {
                closeModal();
                showLogoutOverlay();
            }

            window.skipLogoutCountdown = function () {
                if (logoutCountdownInterval) {
                    clearInterval(logoutCountdownInterval);
                    logoutCountdownInterval = null;
                }
                window.location.href = '@Url.Action("Login", "Login", new { area = "" })';
            }

            // ===== HIỆU ỨNG LOADING ĐĂNG XUẤT =====
            function showLogoutOverlay() {
                const overlay = document.getElementById('logoutOverlay');
                const countdownElement = document.getElementById('logoutCountdown');
                const progressFill = document.getElementById('logoutProgressFill');

                if (!overlay) return;

                // Hiển thị overlay
                overlay.style.display = 'flex';
                setTimeout(() => {
                    overlay.classList.add('active');
                }, 10);

                let countdown = 3;
                if (countdownElement) countdownElement.textContent = countdown;

                if (logoutCountdownInterval) {
                    clearInterval(logoutCountdownInterval);
                }

                // Cập nhật countdown mỗi giây
                logoutCountdownInterval = setInterval(() => {
                    countdown--;
                    if (countdownElement) countdownElement.textContent = countdown;

                    if (countdown <= 0) {
                        clearInterval(logoutCountdownInterval);
                        logoutCountdownInterval = null;
                        // Chuyển hướng đến trang login
                        window.location.href = '@Url.Action("Login", "Login", new { area = "" })';
                    }
                }, 1000);
            }

            // ===== HIGHLIGHT MENU =====
            const navLinks = document.querySelectorAll(".nav-link");
            const sidebar = document.querySelector("aside");
            const highlight = document.createElement("div");
            highlight.classList.add("sidebar-highlight");
            sidebar.appendChild(highlight);

            const currentPath = window.location.pathname.toLowerCase();
            let currentActive = null;

            navLinks.forEach(link => {
                const linkPath = new URL(link.href).pathname.toLowerCase();
                if (currentPath === linkPath) {
                    link.classList.add("active");
                    currentActive = link;
                }
            });

            if (!currentActive) {
                navLinks.forEach(link => {
                    const linkPath = new URL(link.href).pathname.toLowerCase();
                    if (currentPath.includes(linkPath)) {
                        link.classList.add("active");
                        currentActive = link;
                    }
                });
            }

            function moveHighlight(activeLink) {
                if (!activeLink) return;
                const rect = activeLink.getBoundingClientRect();
                highlight.style.top = (activeLink.offsetTop + 6) + "px";
                highlight.style.height = rect.height + "px";
            }

            moveHighlight(currentActive);

            // ===== HIỆU ỨNG GBA CHO NÚT DANH SÁCH XÓA =====
            const deletedListBtn = document.getElementById('btnDeletedList');
            if (deletedListBtn) {
                deletedListBtn.addEventListener('click', function() {
                    // Thêm hiệu ứng visual feedback
                    this.style.animation = 'gbaPress 0.3s ease';
                    setTimeout(() => {
                        this.style.animation = 'gbaGlow 2s infinite alternate';
                    }, 300);
                });
            }

            // ===== PHÂN TRANG (nếu có bảng dữ liệu) =====
            const body = document.querySelector("#accountTableBody");
            if (body) {
                const totalItems = body.querySelectorAll("tr").length;
                const itemsPerPage = 5;
                let currentPage = 1;
                const totalPages = Math.ceil(totalItems / itemsPerPage);

                function renderTable() {
                    const rows = body.querySelectorAll("tr");
                    rows.forEach((row, index) => {
                        row.style.display = (index >= (currentPage - 1) * itemsPerPage && index < currentPage * itemsPerPage) ? "" : "none";
                    });
                }

                function renderPagination() {
                    const pageNumbers = document.getElementById("pageNumbers");
                    if (!pageNumbers) return;
                    pageNumbers.innerHTML = "";

                    if (totalPages <= 1) return;

                    let start = Math.max(1, currentPage - 2);
                    let end = Math.min(totalPages, currentPage + 2);

                    if (currentPage <= 3) {
                        start = 1;
                        end = Math.min(totalPages, 5);
                    } else if (currentPage >= totalPages - 2) {
                        start = Math.max(1, totalPages - 4);
                        end = totalPages;
                    }

                    function addBtn(p) {
                        const btn = document.createElement("button");
                        btn.textContent = p;
                        btn.className = "btn btn-sm mx-1 " + (p === currentPage ? "btn-primary active" : "btn-outline-primary");
                        btn.addEventListener("click", () => {
                            currentPage = p;
                            updateDisplay();
                        });
                        pageNumbers.appendChild(btn);
                    }

                    function addEllipsis() {
                        const span = document.createElement("span");
                        span.className = "px-2 text-muted fw-bold page-ellipsis";
                        span.textContent = "...";
                        pageNumbers.appendChild(span);
                    }

                    if (start > 1) {
                        addBtn(1);
                        if (start > 2) addEllipsis();
                    }

                    for (let i = start; i <= end; i++) {
                        addBtn(i);
                    }

                    if (end < totalPages) {
                        if (end < totalPages - 1) addEllipsis();
                        addBtn(totalPages);
                    }

                    const pageInfo = document.getElementById("pageInfo");
                    if (pageInfo)
                        pageInfo.textContent = `Trang ${currentPage} / ${totalPages}`;
                }

                function updateDisplay() {
                    renderTable();
                    renderPagination();
                }

                const prev = document.getElementById("prev");
                const next = document.getElementById("next");

                if (prev) prev.addEventListener("click", () => {
                    if (currentPage > 1) {
                        currentPage--;
                        updateDisplay();
                    }
                });

                if (next) next.addEventListener("click", () => {
                    if (currentPage < totalPages) {
                        currentPage++;
                        updateDisplay();
                    }
                });

                updateDisplay();
            }

            // ===== HIỂN THỊ TOAST TỰ ĐỘNG NẾU CÓ TEMP DATA =====
            const msg = '@TempData["Message"]';
            const type = '@TempData["MessageType"]';
            if (msg && msg.trim() !== "") {
                showToast(msg, type || "success");
            }
        });

        // ===== HÀM HIỂN THỊ BONG BÓNG THÔNG BÁO HIỆN ĐẠI =====
        function showToast(message, type = 'success') {
            const toastContainer = document.getElementById('toastContainer');

            // Tạo toast element
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;

            // Xác định icon theo loại thông báo
            let icon = 'fa-check-circle';
            switch(type) {
                case 'warning':
                    icon = 'fa-exclamation-triangle';
                    break;
                case 'error':
                    icon = 'fa-times-circle';
                    break;
                case 'info':
                    icon = 'fa-info-circle';
                    break;
                default:
                    icon = 'fa-check-circle';
            }

            // Tạo nội dung toast
            toast.innerHTML = `
                <div class="toast-body">
                    <div class="toast-icon">
                        <i class="fas ${icon}"></i>
                    </div>
                    <div class="toast-content">
                        ${message}
                    </div>
                    <button type="button" class="toast-close" onclick="removeToast(this)">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="toast-progress"></div>
            `;

            // Thêm toast vào container
            toastContainer.appendChild(toast);

            // Hiệu ứng xuất hiện
            setTimeout(() => {
                toast.classList.add('show');

                // Bắt đầu thanh tiến trình
                const progress = toast.querySelector('.toast-progress');
                setTimeout(() => {
                    progress.classList.add('running');
                }, 50);
            }, 10);

            // Tự động xóa toast sau 5 giây
            setTimeout(() => {
                removeToastElement(toast);
            }, 5000);
        }

        // Hàm xóa toast khi click nút đóng
        function removeToast(button) {
            const toast = button.closest('.toast');
            removeToastElement(toast);
        }

        // Hàm xóa toast với hiệu ứng
        function removeToastElement(toast) {
            if (!toast || toast.classList.contains('hiding')) return;

            toast.classList.remove('show');
            toast.classList.add('hiding');

            setTimeout(() => {
                if (toast.parentElement) {
                    toast.remove();
                }
            }, 500);
        }

        // ===== XỬ LÝ THU GỌN / MỞ RỘNG SIDEBAR (COLLAPSIBLE SIDEBAR) =====
        function updateSidebarToggleUI(isCollapsed) {
            const headerIcon = document.getElementById('headerToggleIcon');
            const bottomIcon = document.getElementById('bottomToggleIcon');
            const headerBtn = document.getElementById('btnToggleSidebarHeader');
            const bottomBtn = document.getElementById('btnToggleSidebarBottom');

            if (headerIcon) {
                headerIcon.className = isCollapsed ? 'fas fa-chevron-right' : 'fas fa-chevron-left';
            }
            if (bottomIcon) {
                bottomIcon.className = isCollapsed ? 'fas fa-angles-right' : 'fas fa-angles-left';
            }
            if (headerBtn) {
                headerBtn.title = isCollapsed ? 'Mở rộng menu' : 'Thu gọn menu';
            }
            if (bottomBtn) {
                bottomBtn.title = isCollapsed ? 'Mở rộng menu' : 'Thu gọn menu';
            }
        }

        function isMobileSidebar() {
            return window.matchMedia('(max-width: 991.98px)').matches;
        }

        function closeMobileSidebar() {
            document.body.classList.remove('sidebar-mobile-open');
        }

        function toggleAdminSidebar() {
            if (isMobileSidebar()) {
                document.body.classList.toggle('sidebar-mobile-open');
                return;
            }

            const isCurrentlyCollapsed = document.body.classList.contains('sidebar-collapsed');
            const shouldCollapse = !isCurrentlyCollapsed;

            if (shouldCollapse) {
                document.body.classList.add('sidebar-collapsed');
                document.documentElement.classList.add('sidebar-collapsed-preload');
                localStorage.setItem('adminSidebarCollapsed', 'true');
            } else {
                document.body.classList.remove('sidebar-collapsed');
                document.documentElement.classList.remove('sidebar-collapsed-preload');
                localStorage.setItem('adminSidebarCollapsed', 'false');
            }
            updateSidebarToggleUI(shouldCollapse);
        }

        // Khởi tạo trạng thái ban đầu từ localStorage
        (function initSidebarState() {
            try {
                if (isMobileSidebar()) {
                    document.body.classList.remove('sidebar-collapsed');
                    updateSidebarToggleUI(false);
                    return;
                }

                const savedState = localStorage.getItem('adminSidebarCollapsed');
                if (savedState === 'true') {
                    document.body.classList.add('sidebar-collapsed');
                    updateSidebarToggleUI(true);
                } else {
                    document.body.classList.remove('sidebar-collapsed');
                    updateSidebarToggleUI(false);
                }
            } catch(e) {
                console.warn('LocalStorage error:', e);
            }
        })();

        // Gán sự kiện click cho các nút toggle
        document.addEventListener('DOMContentLoaded', function() {
            const btnHeader = document.getElementById('btnToggleSidebarHeader');
            const btnBottom = document.getElementById('btnToggleSidebarBottom');
            const btnNav = document.getElementById('btnToggleSidebarNav');
            const avatar = document.querySelector('.user-avatar-badge');

            if (btnHeader) btnHeader.addEventListener('click', toggleAdminSidebar);
            if (btnBottom) btnBottom.addEventListener('click', toggleAdminSidebar);
            if (btnNav) btnNav.addEventListener('click', toggleAdminSidebar);

            const overlay = document.getElementById('sidebarOverlay');
            if (overlay) {
                overlay.addEventListener('click', closeMobileSidebar);
            }

            document.querySelectorAll('#adminSidebar a.nav-link').forEach(function(link) {
                link.addEventListener('click', function() {
                    if (isMobileSidebar()) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    closeMobileSidebar();
                }
            });

            window.addEventListener('resize', function() {
                if (!isMobileSidebar()) {
                    closeMobileSidebar();
                }
            });

            // Bấm vào avatar khi sidebar đang thu gọn sẽ tự mở rộng ra
            if (avatar) {
                avatar.addEventListener('click', function() {
                    if (isMobileSidebar()) {
                        closeMobileSidebar();
                        return;
                    }
                    if (document.body.classList.contains('sidebar-collapsed')) {
                        toggleAdminSidebar();
                    }
                });
            }

            // Đồng bộ lại icon UI lần nữa sau khi DOM tải xong
            const isCollapsed = document.body.classList.contains('sidebar-collapsed');
            updateSidebarToggleUI(isCollapsed);
        });

        // Biến toàn cục xác định vai trò người dùng hiện tại
        window.currentUserRoleId = @(vaiTroId.HasValue ? vaiTroId.Value : 1);
        window.isAdmin = @((vaiTroId == 1 || vaiTroId == null) ? "true" : "false");
        window.isManager = @(vaiTroId == 2 ? "true" : "false");
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>