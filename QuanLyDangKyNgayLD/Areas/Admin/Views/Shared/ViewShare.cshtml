        .admin-page-head p {
            max-width: 760px;
            margin: 0;
            font-size: 0.875rem;
            line-height: 1.6;
            color: var(--text-secondary);
        }

        .admin-page-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
