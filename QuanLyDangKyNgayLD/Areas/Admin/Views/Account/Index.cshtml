<script src="~/Areas/Content/jsAccount/EditAcount.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/jsAccount/Account.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/Js/adminCommon.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/jsAccount/ExportExcel.js?v=@DateTime.Now.Ticks"></script>
<script src="~/Areas/Content/jsAccount/AdminPagesize.js?v=@DateTime.Now.Ticks"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnSubmitImport = document.getElementById("btnSubmitImportAccountExcel");
        const fileInput = document.getElementById("excelAccountFileInput");
        const progress = document.getElementById("importAccountProgress");
        const errorContainer = document.getElementById("importAccountErrorContainer");
        const errorList = document.getElementById("importAccountErrorList");

        function notifyAlert(icon, title, message, htmlExtra) {
            let contentHtml = `<p class="mb-2 fw-semibold">${message}</p>`;
            if (htmlExtra) contentHtml += htmlExtra;

            if (typeof Swal !== 'undefined') {
                return Swal.fire({
                    icon: icon,
                    title: title,
                    html: contentHtml,
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: icon === 'success' ? '#198754' : '#0d6efd'
                });
            } else {
                alert(title + "\n" + message);
                return Promise.resolve();
            }
        }

        if (btnSubmitImport && fileInput) {
            btnSubmitImport.addEventListener("click", function () {
                if (!fileInput.files || fileInput.files.length === 0) {
                    notifyAlert('warning', 'Chưa chọn file', 'Vui lòng chọn 1 file Excel (.xlsx) trước khi bấm Import!');
                    return;
                }

                const formData = new FormData();
                formData.append("file", fileInput.files[0]);

                progress.classList.remove("d-none");
                errorContainer.classList.add("d-none");
                errorList.innerHTML = "";
                btnSubmitImport.disabled = true;

                fetch('@Url.Action("ImportExcel", "Account", new { area = "Admin" })', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    progress.classList.add("d-none");
                    btnSubmitImport.disabled = false;

                    if (data.success) {
                        // Đóng modal import trước
                        const modalEl = document.getElementById('modalImportAccountExcel');
                        const modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();

                        if (data.errors && data.errors.length > 0) {
                            let listHtml = `<div style="max-height: 180px; overflow-y: auto; text-align: left; background: #fff3cd; border: 1px solid #ffeeba; padding: 10px; border-radius: 6px; font-size: 0.85rem;"><ul class="mb-0 ps-3 text-dark">`;
                            data.errors.forEach(err => {
                                listHtml += `<li>${err}</li>`;
                            });
                            listHtml += `</ul></div>`;

                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Nhập thành công một phần!',
                                    html: `<p class="fw-bold mb-2 text-dark">${data.message}</p>${listHtml}`,
                                    confirmButtonText: 'Đóng & Tải lại',
                                    confirmButtonColor: '#0d6efd'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                alert(data.message);
                                location.reload();
                            }
                        } else {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: data.message,
                                    confirmButtonText: 'Tuyệt vời',
                                    confirmButtonColor: '#198754'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                alert(data.message);
                                location.reload();
                            }
                        }
                    } else {
                        // Không đóng modal khi lỗi để người dùng xem chi tiết lỗi
                        let listHtml = "";
                        if (data.errors && data.errors.length > 0) {
                            errorContainer.classList.remove("d-none");
                            listHtml = `<div style="max-height: 180px; overflow-y: auto; text-align: left; background: #f8d7da; border: 1px solid #f5c6cb; padding: 10px; border-radius: 6px; font-size: 0.85rem;"><ul class="mb-0 ps-3 text-danger">`;
                            data.errors.forEach(err => {
                                const li = document.createElement("li");
                                li.textContent = err;
                                errorList.appendChild(li);
                                listHtml += `<li>${err}</li>`;
                            });
                            listHtml += `</ul></div>`;
                        }

                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                icon: 'error',
                                title: 'Nhập file thất bại!',
                                html: `<p class="fw-bold mb-2 text-danger">${data.message || 'Có lỗi xảy ra'}</p>${listHtml}`,
                                confirmButtonText: 'Đóng & Thử lại',
                                confirmButtonColor: '#dc3545'
                            });
                        } else {
                            alert(data.message || "Lỗi nhập file");
                        }
                    }
                })
                .catch(err => {
                    progress.classList.add("d-none");
                    btnSubmitImport.disabled = false;
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi máy chủ',
                            text: 'Có lỗi xảy ra khi gửi dữ liệu lên máy chủ: ' + err,
                            confirmButtonText: 'Đóng',
                            confirmButtonColor: '#dc3545'
                        });
                    } else {
                        alert('Lỗi: ' + err);
                    }
                });
            });
        }
    });
</script>