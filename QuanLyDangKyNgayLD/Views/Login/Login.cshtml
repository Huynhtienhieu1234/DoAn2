@model QuanLyDangKyNgayLD.Models.TaiKhoan

@{
    ViewBag.Title = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Cổng Thông Tin Lao Động Sinh Viên - Đại học Đồng Tháp</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/favicon.png?v=3")" />
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/favicon.ico?v=3")" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Areas/Content/css/Login.css?v=" + DateTime.Now.Ticks)" />
    <style>
        body, button, input, optgroup, select, textarea {
            font-family: 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }
        :root {
            --bs-body-font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            --bs-font-sans-serif: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .fa, .fas, .far, .fal, .fab, .fad, .fak, [class*="fa-"], [class^="fa-"] {
            font-family: "Font Awesome 6 Free" !important;
        }
        .fab, .fa-brands {
            font-family: "Font Awesome 6 Brands" !important;
        }
    </style>
</head>

<body>
    <div class="portal-wrapper">
        <!-- 1. THANH TIÊU ĐỀ TRƯỜNG (TOPBAR CHÍNH THỐNG) -->
        <header class="portal-topbar">
            <div class="portal-topbar-inner">
                <div class="portal-brand">
                    <img src="https://cdn.jsdelivr.net/gh/Huynhtienhieu1234/UploadAnh/LogoDHDT.png"
                         alt="Logo Trường Đại học Đồng Tháp"
                         class="portal-logo" />
                    <div class="portal-title-group">
                        <span class="portal-subtext">BỘ GIÁO DỤC VÀ ĐÀO TẠO</span>
                        <span class="portal-main-name">TRƯỜNG ĐẠI HỌC ĐỒNG THÁP</span>
                        <span class="portal-system-name">CỔNG THÔNG TIN QUẢN LÝ LAO ĐỘNG SINH VIÊN</span>
                    </div>
                </div>

                <div class="portal-topbar-links">
                    <a href="https://dthu.edu.vn" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-globe me-1"></i> Trang chủ Nhà trường
                    </a>
                    <span class="hotline-badge">
                        <i class="fas fa-phone-volume"></i> Hotline: 058322456
                    </span>
                </div>
            </div>
        </header>

        <!-- 2. KHU VỰC NỘI DUNG CHÍNH (PORTAL BOX) -->
        <main class="portal-content">
            <div class="portal-box">
                <!-- CỘT TRÁI: THÔNG BÁO VÀ QUY ĐỊNH NGHĨA VỤ LAO ĐỘNG -->
                <aside class="portal-info-pane">
                    <div>
                        <div class="portal-info-header">
                            <h2 class="portal-info-title">
                                <i class="fas fa-bullhorn"></i> Quy Định & Hướng Dẫn
                            </h2>
                            <p class="portal-info-desc">
                                Thông tin quản lý và theo dõi công tác lao động công ích của sinh viên Trường Đại học Đồng Tháp.
                            </p>
                        </div>

                        <ul class="portal-notice-list">
                            <li class="portal-notice-item">
                                <i class="fas fa-check-circle"></i>
                                <div class="portal-notice-text">
                                    <strong>Chỉ tiêu hoàn thành:</strong> Sinh viên chính quy cần hoàn thành đủ <strong>18 ngày lao động</strong> trong toàn khóa học để đủ điều kiện xét tốt nghiệp.
                                </div>
                            </li>
                            <li class="portal-notice-item">
                                <i class="fas fa-calendar-alt"></i>
                                <div class="portal-notice-text">
                                    <strong>Đăng ký lịch lao động:</strong> Sinh viên chủ động lựa chọn các ca lao động (vệ sinh khuôn viên, thư viện, hỗ trợ sự kiện) phù hợp với lịch học.
                                </div>
                            </li>
                            <li class="portal-notice-item">
                                <i class="fas fa-qrcode"></i>
                                <div class="portal-notice-text">
                                    <strong>Điểm danh & Giám sát:</strong> Việc điểm danh được thực hiện trực tiếp tại buổi lao động theo hướng dẫn của Cán bộ / Trưởng nhóm quản lý.
                                </div>
                            </li>
                        </ul>
                    </div>

                    <div class="portal-support-box">
                        <div class="portal-support-title">
                            <i class="fas fa-headset"></i> Bộ phận hỗ trợ sinh viên:
                        </div>
                        <p class="portal-support-info">
                            <strong>Phòng Công tác Sinh viên</strong> (Tòa nhà A1 - Bàn tiếp sinh viên)<br />
                            Email: <strong>ctsv@dthu.edu.vn</strong> | Điện thoại: <strong>(0277) 3881 518</strong>
                        </p>
                    </div>
                </aside>

                <!-- CỘT PHẢI: FORM ĐĂNG NHẬP -->
                <section class="portal-login-pane">
                    <div class="portal-login-header">
                        <div class="portal-login-badge">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <h1 class="portal-login-title">Đăng nhập hệ thống</h1>
                        <p class="portal-login-subtitle">
                            Dành cho Sinh viên, Cán bộ quản lý và Phụ trách lao động
                        </p>
                    </div>

                    @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @class = "portal-form" }))
                    {
                        @Html.AntiForgeryToken()

                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="portal-error-box">
                                @Html.ValidationSummary(true, "")
                            </div>
                        }

                        <div class="portal-form-group">
                            <label for="Username" class="portal-form-label">
                                Tên đăng nhập / Mã số sinh viên (MSSV)
                            </label>
                            <div class="portal-input-container">
                                <i class="fas fa-id-card portal-input-icon"></i>
                                @Html.TextBoxFor(m => m.Username, new
                                {
                                    @class = "portal-input",
                                    placeholder = "Nhập MSSV hoặc tên đăng nhập",
                                    id = "Username",
                                    autocomplete = "username",
                                    required = "required"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "portal-field-error" })
                        </div>

                        <div class="portal-form-group">
                            <label for="password" class="portal-form-label">
                                Mật khẩu
                            </label>
                            <div class="portal-input-container">
                                <i class="fas fa-key portal-input-icon"></i>
                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @class = "portal-input has-toggle",
                                    placeholder = "Nhập mật khẩu",
                                    id = "password",
                                    autocomplete = "current-password",
                                    required = "required"
                                })
                                <button type="button" class="portal-toggle-pwd" onclick="togglePassword()" aria-label="Hiện hoặc ẩn mật khẩu" title="Hiện / Ẩn mật khẩu">
                                    <i id="eyeIcon" class="fas fa-eye"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "portal-field-error" })
                        </div>

                        <button type="submit" class="portal-btn-submit">
                            <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                        </button>

                        <div class="portal-extra-links">
                            <a href="@Url.Action("ForgotPassword", "ForgotPassword")">
                                <i class="fas fa-unlock-alt me-1"></i> Quên mật khẩu?
                            </a>
                        </div>
                    }
                </section>
            </div>
        </main>

        <!-- 3. CHÂN TRANG (FOOTER NHÀ TRƯỜNG) -->
        <footer class="portal-footer">
            <div>
                <strong>TRƯỜNG ĐẠI HỌC ĐỒNG THÁP - DONG THAP UNIVERSITY</strong>
            </div>
            <div>
                Địa chỉ: Số 783, Phạm Hữu Lầu, Phường 6, P.Cao Lãnh, Tỉnh Đồng Tháp
            </div>
            <div>
                &copy; @DateTime.Now.Year Hệ Thống Quản Lý Lao Động Sinh Viên. Bản quyền thuộc về KS.Huỳnh Tiến Hiểu .
            </div>
        </footer>
    </div>

    <script>
        function togglePassword() {
            var pwd = document.getElementById("password");
            var eye = document.getElementById("eyeIcon");

            if (pwd.type === "password") {
                pwd.type = "text";
                eye.classList.remove("fa-eye");
                eye.classList.add("fa-eye-slash");
            } else {
                pwd.type = "password";
                eye.classList.remove("fa-eye-slash");
                eye.classList.add("fa-eye");
            }
        }
    </script>
</body>
</html>
